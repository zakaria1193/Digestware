# Copy this file to .env and fill in your values — never commit .env

# OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Resend (newsletter)
RESEND_API_KEY=re_...

# Optional: override default models
SUMMARISER_MODEL=google/gemini-2.5-flash-lite
BENTO_MODEL=anthropic/claude-sonnet-4-5

# Embeddings for the Pulse index (agents/index/). This is the one documented
# exception to the OpenRouter-only rule — OpenRouter has no embeddings endpoint.
# Any OpenAI-compatible /embeddings provider works; leave unset and build with
# `--no-embeddings` for a lexical-only index.
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
