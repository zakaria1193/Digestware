# Copy this file to .env and fill in your values — never commit .env

# OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Gemini API (used for Google Search grounding in web_search tool)
GEMINI_API_KEY=AIza...

# Resend (newsletter)
RESEND_API_KEY=re_...

# Optional: override default models
SUMMARISER_MODEL=google/gemini-2.0-flash-001
BENTO_MODEL=anthropic/claude-sonnet-4-5
