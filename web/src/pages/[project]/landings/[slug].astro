---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import CommitRow from '../../../components/CommitRow.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, getProject } from '../../../config/projects';
import { SHOW_IMPACT_SCORE } from '../../../config/features';

export async function getStaticPaths() {
  const paths = [];
  for (const p of PROJECTS) {
    // Stubs are admin-only; don't generate public detail pages for them.
    const entries = await getCollection(
      'landings',
      ({ data }) => data.project === p.slug && !data.is_stub,
    );
    for (const entry of entries) {
      paths.push({
        params: { project: p.slug, slug: entry.id },
        props: { entry, projectSlug: p.slug },
      });
    }
  }
  return paths;
}

const { entry, projectSlug } = Astro.props as { entry: any; projectSlug: string };
const project = getProject(projectSlug)!;
const d = entry.data;
const { Content } = await entry.render();

const all = (await getCollection(
  'landings',
  ({ data }) => data.project === projectSlug && !data.is_stub,
))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex(e => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

// Cross-link this landing back to the discussion that birthed the patch.
// Match by patch_id first (git's stable cross-platform key), then fall back
// to the explicit discussion_id_link trailer. Stay within-project so we
// never merge content across projects.
const sameProjectDiscussions = await getCollection(
  'discussions',
  ({ data }) => data.project === projectSlug && !data.is_stub,
);
const landingPatchId = d.patch_id ?? null;
const discussionIdLink = d.discussion_id_link ?? null;
let linkedDiscussion: any = null;
if (landingPatchId) {
  linkedDiscussion = sameProjectDiscussions.find(
    e => e.data.patch_id && e.data.patch_id === landingPatchId,
  ) ?? null;
}
if (!linkedDiscussion && discussionIdLink) {
  linkedDiscussion = sameProjectDiscussions.find(
    e => e.data.discussion_id === discussionIdLink,
  ) ?? null;
}

const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const dateStrShort = d.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();

function scoreColor(n: number | null | undefined): string {
  if (n == null) return '#888';
  if (n <= 2)  return '#5a5a5a';
  if (n <= 4)  return '#2e6a8e';
  if (n <= 6)  return '#1a4d8a';
  if (n <= 8)  return '#7a1a2e';
  return '#b80018';
}

// ── Filter bar data (same logic as index.astro, landings-only) ──
const scoresByTag = new Map<string, number[]>();
const datesByTag = new Map<string, number[]>();
for (const e of all) {
  const score = e.data.impact_score ?? 0;
  const ts = e.data.date.getTime();
  for (const tag of e.data.tags ?? []) {
    if (!scoresByTag.has(tag)) scoresByTag.set(tag, []);
    scoresByTag.get(tag)!.push(score);
    if (!datesByTag.has(tag)) datesByTag.set(tag, []);
    datesByTag.get(tag)!.push(ts);
  }
}
const rankedTags = [...scoresByTag.entries()]
  .map(([name, scores]) => ({ name, count: scores.length, scores, dates: datesByTag.get(name) ?? [] }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

type TagCategoryFile = { assignments: Record<string, string> };
const tagCategoryModules = import.meta.glob<TagCategoryFile>(
  '../../../data/tag-categories/*.json',
  { eager: true },
);
const tagCategoryFile = tagCategoryModules[`../../../data/tag-categories/${projectSlug}.json`];
const tagAssignments: Record<string, string> = tagCategoryFile?.assignments ?? {};

const CATEGORY_ORDER = ['architectures', 'components', 'topics', 'news', 'other'] as const;
type Category = typeof CATEGORY_ORDER[number];
const CATEGORY_LABELS: Record<Category, string> = {
  architectures: 'Architectures',
  components: 'Components',
  topics: 'Topics',
  news: 'News & Policy',
  other: 'Other',
};
function categoryFor(tag: string): Category {
  const raw = tagAssignments[tag];
  return (CATEGORY_ORDER as readonly string[]).includes(raw) ? (raw as Category) : 'other';
}

function inlineCode(text: string | null | undefined): string {
  if (!text) return '';
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
  return escaped
    .replace(/``([^`\n]+)``/g, '<code>$1</code>')
    .replace(/`([^`\n]+)`/g, '<code>$1</code>');
}

type RankedTag = { name: string; count: number; scores: number[]; dates: number[] };
const groupedTags: Array<{ category: Category; tags: RankedTag[] }> = [];
for (const cat of CATEGORY_ORDER) {
  const bucket = rankedTags.filter(t => categoryFor(t.name) === cat);
  if (bucket.length > 0) groupedTags.push({ category: cat, tags: bucket });
}
---

<PublicLayout project={project} title={d.headline} description={d.tldr}>

  <script is:inline>
    // Pre-paint scroll-restore setup. When the previous page stashed a
    // scroll position in sessionStorage (sidebar commit-switch flow), tell
    // the browser to skip its own restoration and hide the page until our
    // main script can place us at the saved Y. Avoids the top→Y flash.
    if (sessionStorage.getItem('commit-scroll-y') !== null) {
      try { history.scrollRestoration = 'manual'; } catch (e) {}
      document.documentElement.classList.add('scroll-restoring');
      // Safety: never leave the page permanently hidden if something fails.
      setTimeout(() => document.documentElement.classList.remove('scroll-restoring'), 800);
    }
  </script>

  <!-- Filter bar: scoped to sidebar commits only on this page -->
  <section class="filter-bar" aria-label="Commit filters">
    <div class="filter-bar-head">
      <span class="wsj-section-label">Filters</span>
      <span class="wsj-section-rule"></span>
    </div>
    <div class="filter-bar-body" data-impact-hidden={SHOW_IMPACT_SCORE ? undefined : 'true'}>
      <div class="filter-cell filter-cell-impact" style={SHOW_IMPACT_SCORE ? undefined : 'display:none'} aria-hidden={SHOW_IMPACT_SCORE ? undefined : 'true'}>
        <span class="filter-cell-label">Impact</span>
        <div class="filter-cell-control">
          <input type="range" id="impact-filter" min="10" max="100" step="1" value="10" aria-label="Minimum impact level" />
          <div class="filter-ticks">
            <span data-stop="1">Lowest</span>
            <span data-stop="2">Low</span>
            <span data-stop="3">Mid</span>
            <span data-stop="4">High</span>
            <span data-stop="5">Highest</span>
          </div>
        </div>
      </div>

      <div class="filter-cell filter-cell-date">
        <span class="filter-cell-label">Date</span>
        <div class="filter-cell-control">
          <div class="date-pills">
            <button type="button" class="date-pill" data-days="" data-active="true">All time</button>
            <button type="button" class="date-pill" data-days="1">Last day</button>
            <button type="button" class="date-pill" data-days="3">Last 3 days</button>
            <button type="button" class="date-pill" data-days="7">Last week</button>
            <button type="button" class="date-pill" data-days="30">Last month</button>
          </div>
        </div>
      </div>

      <div class="filter-cell filter-cell-labels">
        <div class="filter-cell-label-row">
          <span class="filter-cell-label-eyebrow">
            <span class="filter-cell-label">Labels</span>
            <span class="filter-cell-chevron" aria-hidden="true">&#9662;</span>
            <span class="filter-cell-meta">
              <span id="filter-visible">{all.length}</span> of {all.length}
            </span>
          </span>
          {rankedTags.length > 0 && (
            <div class="filter-toggles">
              <button type="button" class="filter-toggle" data-action="mark-all">Mark&nbsp;All</button>
              <span class="filter-toggle-sep">/</span>
              <button type="button" class="filter-toggle" data-action="unmark-all">Unmark&nbsp;All</button>
            </div>
          )}
        </div>
        {rankedTags.length === 0 && (
          <span class="filter-empty">No labels in the current window.</span>
        )}
        {rankedTags.length > 0 && (
          <div class="filter-groups" id="filter-groups">
            <div class="filter-groups-inner">
              {groupedTags.map(g => (
                <section class="filter-group" data-group={g.category}>
                  <span class="filter-group-label">{CATEGORY_LABELS[g.category]}</span>
                  <div class="filter-group-chips">
                    {g.tags.map(t => (
                      <button
                        type="button"
                        class="chip"
                        data-tag={t.name}
                        data-selected="true"
                        aria-pressed="true"
                        data-scores={t.scores.join(',')}
                        data-dates={t.dates.join(',')}
                      >
                        <span class="chip-name">{t.name}</span>
                        <span class="chip-count">{t.count}</span>
                      </button>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="landing-layout">
    <aside class="commits-sidebar">
      <div class="sidebar-sticky-head">
        <div class="sidebar-brand">Latest Commits</div>
        <div class="sidebar-sub">{all.length} commit{all.length !== 1 ? 's' : ''}</div>
        <div class="sidebar-rule-thick"></div>
        <div class="sidebar-rule-thin"></div>
      </div>
      <div class="sidebar-list">
        {all.map(e => (
          <div
            class:list={["sidebar-item", e.id === entry.id && "sidebar-item-current"]}
            data-current={e.id === entry.id ? "true" : undefined}
          >
            <CommitRow entry={e} projectSlug={projectSlug} />
          </div>
        ))}
      </div>
    </aside>

  <article class="article">
    <nav class="crumb">
      <a href={`/${project.slug}/`}>Front Page</a>
      <span class="sep">&rsaquo;</span>
      <a href={`/${project.slug}/#stream`}>Latest Commits</a>
      <span class="sep">&rsaquo;</span>
      <span class="sub">{d.subsystem}</span>
    </nav>

    <div class="article-date">{dateStrShort}</div>

    <header class="article-head">
      <div class="kicker-row">
        <span class="wsj-kicker">{d.subsystem}</span>
        {SHOW_IMPACT_SCORE && d.impact_score != null && (
          <>
            <span class="kicker-sep">&mdash;</span>
            <span class="impact-pill" style={`color: ${scoreColor(d.impact_score)}; border-bottom-color: ${scoreColor(d.impact_score)}`}>Impact {d.impact_score}&thinsp;/&thinsp;10</span>
          </>
        )}
        {d.performance_win && <span class="badge perf">Performance Win</span>}
        {d.breaking_change && <span class="badge breaking">Breaking Change</span>}
      </div>

      <h1 class="head">{d.headline}</h1>
      <p class="deck">{d.tldr}</p>

      <div class="byline-row">
        {d.author && <span class="byline">By <em>{d.author}</em></span>}
        <span class="byline-date">{dateStr}</span>
        {d.outcome && <span class="byline-outcome">{d.outcome.replace(/_/g, ' ')}</span>}
      </div>
    </header>

    {linkedDiscussion && (
      <aside class="thread-link">
        <div class="thread-link-head">From the Thread</div>
        <a class="thread-link-body" href={`/${project.slug}/discussions/${linkedDiscussion.id}`}>
          <span class="thread-link-headline">{linkedDiscussion.data.headline}</span>
          <span class="thread-link-arrow">&rarr;</span>
        </a>
        {linkedDiscussion.data.proposer && (
          <div class="thread-link-meta">
            Proposed by <em>{linkedDiscussion.data.proposer}</em>
            {linkedDiscussion.data.exchanges && linkedDiscussion.data.exchanges.length > 0 && (
              <>
                <span class="bullet">&middot;</span>
                <span>
                  {linkedDiscussion.data.exchanges.length}{' '}
                  {linkedDiscussion.data.exchanges.length === 1 ? 'voice' : 'voices'} on file
                </span>
              </>
            )}
          </div>
        )}
      </aside>
    )}

    <div class="body wsj-dropcap">
      <Content />
    </div>

    {d.primer_expert && (
      <section class="extra">
        <h2>In Details</h2>
        <p set:html={inlineCode(d.primer_expert)} />
      </section>
    )}

    {d.primer_general && (
      <section class="extra">
        <h2>For Context</h2>
        <p set:html={inlineCode(d.primer_general)} />
      </section>
    )}

    {(d.series_parts ?? []).length > 0 && (
      <section class="extra">
        <h2>Part of a Series</h2>
        <ul>
          {d.series_parts!.map(p => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {(d.tags ?? []).length > 0 && (
      <div class="tags">
        <span class="tags-label">Filed Under:</span>
        {d.tags!.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="source">
      <a href={d.url} target="_blank" rel="noopener">View Commit &rarr;</a>
    </div>

    {(d.primer_glossary ?? []).length > 0 && (
      <section class="glossary">
        <div class="glossary-head">
          <span class="glossary-label">Glossary</span>
          <span class="glossary-rule"></span>
        </div>
        <dl class="glossary-list">
          {d.primer_glossary!.map((item: any) => (
            <>
              <dt class="glossary-term">{item.term}</dt>
              <dd class="glossary-def" set:html={inlineCode(item.definition)} />
            </>
          ))}
        </dl>
      </section>
    )}

    <nav class="prevnext">
      {next && (
        <a href={`/${project.slug}/landings/${next.id}`} class="nav-prev">
          <span class="nav-label">&larr; Earlier</span>
          <span class="nav-title">{next.data.headline}</span>
        </a>
      )}
      {prev && (
        <a href={`/${project.slug}/landings/${prev.id}`} class="nav-next">
          <span class="nav-label">Next &rarr;</span>
          <span class="nav-title">{prev.data.headline}</span>
        </a>
      )}
    </nav>
  </article>
  </div>

<script>
  const slider = document.getElementById('impact-filter') as HTMLInputElement;
  const labelsCell = document.querySelector<HTMLElement>('.filter-cell-labels')!;
  const visibleCounter = document.getElementById('filter-visible');

  const datePills = Array.from(document.querySelectorAll<HTMLButtonElement>('.date-pill'));
  let selectedDays: number | null = null;
  const NOW = Date.now();
  const DAY_MS = 86400000;
  // "Last day" (selectedDays === 1) means yesterday only — the digester runs
  // early in the morning, so today's window is empty. Other ranges remain
  // a simple rolling window ending now.
  function dateWindow(): [number, number] {
    if (selectedDays === null) return [-Infinity, Infinity];
    if (selectedDays === 1) return [NOW - 2 * DAY_MS, NOW - DAY_MS];
    return [NOW - selectedDays * DAY_MS, Infinity];
  }

  function thresholdFromSlider(v: number): number { return v / 10; }

  const allChips = Array.from(labelsCell.querySelectorAll<HTMLButtonElement>('.chip'));
  const groups = Array.from(labelsCell.querySelectorAll<HTMLElement>('.filter-group'));
  const wires = Array.from(document.querySelectorAll<HTMLElement>('.sidebar-list .wire'));
  const currentWire = document.querySelector<HTMLElement>('[data-current="true"] .wire');

  const scoresOf = new Map<HTMLButtonElement, number[]>();
  const datesOf = new Map<HTMLButtonElement, number[]>();
  for (const chip of allChips) {
    scoresOf.set(chip, (chip.dataset.scores ?? '').split(',').filter(Boolean).map(Number));
    datesOf.set(chip, (chip.dataset.dates ?? '').split(',').filter(Boolean).map(Number));
  }

  // ── URL persistence ──────────────────────────────────────────────
  // Serialise the current non-default filter state into a query string.
  // Returns '' when everything is at the default (slider=10, all selected)
  // so we don't litter clean URLs with params.
  function buildQueryString(): string {
    const params = new URLSearchParams();
    const iv = parseInt(slider.value);
    if (iv !== 10) params.set('i', String(iv));
    const visibleChips = allChips.filter(c => !c.classList.contains('is-filtered'));
    const allSelected = visibleChips.every(c => c.dataset.selected === 'true');
    if (!allSelected) {
      const selected = visibleChips.filter(c => c.dataset.selected === 'true').map(c => c.dataset.tag ?? '');
      if (selected.length) params.set('t', selected.join('|'));
    }
    if (selectedDays !== null) {
      const dMap: Record<number, string> = { 1: 'lastday', 3: '3d', 7: '7d', 30: '30d' };
      if (dMap[selectedDays]) params.set('d', dMap[selectedDays]);
    }
    return params.toString();
  }

  function syncUrl(): void {
    const qs = buildQueryString();
    const base = window.location.pathname;
    history.replaceState(null, '', qs ? `${base}?${qs}` : base);
  }

  // Restore state from URL params before first paint.
  function restoreFromUrl(): void {
    const params = new URLSearchParams(window.location.search);
    const iv = params.get('i');
    if (iv) slider.value = iv;
    const t = params.get('t');
    if (t) {
      const saved = new Set(t.split('|').filter(Boolean));
      for (const chip of allChips) {
        const on = saved.has(chip.dataset.tag ?? '');
        chip.dataset.selected = on ? 'true' : 'false';
        chip.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
    }
    const d = params.get('d');
    if (d) {
      const reverseMap: Record<string, number> = { lastday: 1, today: 1, '3d': 3, '7d': 7, '30d': 30 };
      if (reverseMap[d] !== undefined) {
        selectedDays = reverseMap[d];
        for (const p of datePills) p.dataset.active = p.dataset.days === String(selectedDays) ? 'true' : 'false';
      }
    }
  }

  // Intercept sidebar link clicks and carry the current filter state forward.
  document.querySelector('.sidebar-list')?.addEventListener('click', ev => {
    const link = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!link) return;
    sessionStorage.setItem('commit-scroll-y', String(window.scrollY));
    const qs = buildQueryString();
    if (!qs) return; // default state — let the native navigation proceed as-is
    ev.preventDefault();
    window.location.href = link.href.split('?')[0] + '?' + qs;
  });
  // ────────────────────────────────────────────────────────────────

  function setFiltered(el: HTMLElement, filtered: boolean): void {
    el.classList.toggle('is-filtered', filtered);
    el.setAttribute('aria-hidden', filtered ? 'true' : 'false');
  }

  function updateChipsForLevel(min: number, floor: number, ceil: number): HTMLButtonElement[] {
    const visible: HTMLButtonElement[] = [];
    for (const chip of allChips) {
      const scores = scoresOf.get(chip) ?? [];
      const dates = datesOf.get(chip) ?? [];
      const count = scores.reduce((n, s, i) => {
        const d = dates[i] ?? 0;
        return n + ((s >= min) && d >= floor && d <= ceil ? 1 : 0);
      }, 0);
      setFiltered(chip, count === 0);
      const badge = chip.querySelector<HTMLElement>('.chip-count');
      if (badge) badge.textContent = String(count);
      if (count > 0) visible.push(chip);
    }
    for (const group of groups) {
      setFiltered(group, !group.querySelector('.chip:not(.is-filtered)'));
    }
    return visible;
  }

  function selectedSet(visibleChips: HTMLButtonElement[]): Set<string> {
    const s = new Set<string>();
    for (const c of visibleChips) if (c.dataset.selected === 'true') s.add(c.dataset.tag ?? '');
    return s;
  }

  function passesLabels(tagStr: string | undefined, selected: Set<string>, visibleCount: number): boolean {
    if (visibleCount === 0 || selected.size === visibleCount) return true;
    if (selected.size === 0) return false;
    return (tagStr ?? '').split('|').filter(Boolean).some(t => selected.has(t));
  }

  function apply(value: number): void {
    const min = thresholdFromSlider(value);
    const [floor, ceil] = dateWindow();
    const visibleChips = updateChipsForLevel(min, floor, ceil);
    const selected = selectedSet(visibleChips);
    let visible = 0;

    for (const el of wires) {
      const isCurrent = el === currentWire;
      const score = parseFloat(el.dataset.score ?? '0');
      const ts = parseFloat(el.dataset.date ?? '0');
      const passes = score >= min && ts >= floor && ts <= ceil && passesLabels(el.dataset.tags, selected, visibleChips.length);
      if (isCurrent) {
        setFiltered(el, false);
        el.classList.toggle('wire-pinned', !passes);
        visible++;
      } else {
        setFiltered(el, !passes);
        if (passes) visible++;
      }
    }
    if (visibleCounter) visibleCounter.textContent = String(visible);
    const anyDeselected = visibleChips.some(c => c.dataset.selected !== 'true');
    labelsCell.classList.toggle('tags-active', anyDeselected);
    syncUrl();
  }

  function setVisibleChips(selected: boolean): void {
    for (const c of allChips) {
      if (c.classList.contains('is-filtered')) continue;
      c.dataset.selected = selected ? 'true' : 'false';
      c.setAttribute('aria-pressed', selected ? 'true' : 'false');
    }
  }

  labelsCell.addEventListener('click', ev => {
    const target = (ev.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!target) return;
    const visibleChips = allChips.filter(c => !c.classList.contains('is-filtered'));
    const allSelected = visibleChips.length > 0 && visibleChips.every(c => c.dataset.selected === 'true');
    if (allSelected) {
      for (const c of visibleChips) {
        c.dataset.selected = c === target ? 'true' : 'false';
        c.setAttribute('aria-pressed', c === target ? 'true' : 'false');
      }
    } else {
      const on = target.dataset.selected !== 'true';
      target.dataset.selected = on ? 'true' : 'false';
      target.setAttribute('aria-pressed', on ? 'true' : 'false');
      const anySelected = visibleChips.some(c => c.dataset.selected === 'true');
      if (!anySelected) {
        for (const c of visibleChips) { c.dataset.selected = 'true'; c.setAttribute('aria-pressed', 'true'); }
      }
    }
    apply(parseInt(slider.value));
  });

  document.querySelectorAll<HTMLButtonElement>('.filter-toggle').forEach(btn => {
    btn.addEventListener('click', () => { setVisibleChips(btn.dataset.action === 'mark-all'); apply(parseInt(slider.value)); });
  });

  for (const pill of datePills) {
    pill.addEventListener('click', () => {
      const v = pill.dataset.days ?? '';
      selectedDays = v === '' ? null : parseInt(v);
      for (const p of datePills) p.dataset.active = p === pill ? 'true' : 'false';
      apply(parseInt(slider.value));
    });
  }

  const impactCell = document.querySelector<HTMLElement>('.filter-cell-impact')!;
  const ticks = Array.from(document.querySelectorAll<HTMLElement>('.filter-ticks span'));
  function stopFromValue(v: number): number { return Math.min(5, Math.floor((v - 10) / 18) + 1); }
  function updateTicks(v: number): void {
    const stop = stopFromValue(v);
    for (const t of ticks) t.dataset.active = t.dataset.stop === String(stop) ? 'true' : 'false';
  }

  slider.addEventListener('input', () => { const v = parseInt(slider.value); updateTicks(v); apply(v); });
  slider.addEventListener('pointerdown', () => { impactCell.dataset.using = 'true'; });
  const clearUsing = () => { impactCell.dataset.using = 'false'; };
  slider.addEventListener('pointerup', clearUsing);
  slider.addEventListener('pointercancel', clearUsing);

  document.documentElement.classList.add('filter-init');
  restoreFromUrl();
  apply(parseInt(slider.value));
  updateTicks(parseInt(slider.value));
  requestAnimationFrame(() => requestAnimationFrame(() => document.documentElement.classList.remove('filter-init')));

  // Bring the current commit into view inside the sidebar's own scroll
  // container. Walk up to the nearest ancestor that actually scrolls and
  // adjust *its* scrollTop directly — using element.scrollIntoView() here
  // would also scroll the window, which would fight the restoration below.
  function revealCurrentInSidebar(): void {
    if (!currentWire) return;
    let scroller: HTMLElement | null = currentWire.parentElement;
    while (scroller && scroller !== document.body) {
      const cs = getComputedStyle(scroller);
      if ((cs.overflowY === 'auto' || cs.overflowY === 'scroll') &&
          scroller.scrollHeight > scroller.clientHeight) break;
      scroller = scroller.parentElement;
    }
    if (!scroller || scroller === document.body) return;
    const wireRect = currentWire.getBoundingClientRect();
    const scrollerRect = scroller.getBoundingClientRect();
    const offsetWithin = wireRect.top - scrollerRect.top + scroller.scrollTop;
    const target = offsetWithin - (scroller.clientHeight - currentWire.clientHeight) / 2;
    scroller.scrollTop = Math.max(0, target);
  }

  const savedScrollY = sessionStorage.getItem('commit-scroll-y');
  if (savedScrollY !== null) {
    sessionStorage.removeItem('commit-scroll-y');
    window.scrollTo({ top: parseInt(savedScrollY), behavior: 'instant' });
    revealCurrentInSidebar();
    document.documentElement.classList.remove('scroll-restoring');
  } else {
    revealCurrentInSidebar();
  }
</script>

</PublicLayout>

