---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, getProject } from '../../../config/projects';

export async function getStaticPaths() {
  const paths = [];
  for (const p of PROJECTS) {
    const entries = await getCollection('landings', ({ data }) => data.project === p.slug);
    for (const entry of entries) {
      paths.push({
        params: { project: p.slug, slug: entry.id },
        props: { entry, projectSlug: p.slug },
      });
    }
  }
  return paths;
}

const { entry, projectSlug } = Astro.props as { entry: any; projectSlug: string };
const project = getProject(projectSlug)!;
const d = entry.data;
const { Content } = await entry.render();

const all = (await getCollection('landings', ({ data }) => data.project === projectSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex(e => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

// Cross-link this landing back to the discussion that birthed the patch.
// Match by patch_id first (git's stable cross-platform key), then fall back
// to the explicit discussion_id_link trailer. Stay within-project so we
// never merge content across projects.
const sameProjectDiscussions = await getCollection(
  'discussions',
  ({ data }) => data.project === projectSlug,
);
const landingPatchId = d.patch_id ?? null;
const discussionIdLink = d.discussion_id_link ?? null;
let linkedDiscussion: any = null;
if (landingPatchId) {
  linkedDiscussion = sameProjectDiscussions.find(
    e => e.data.patch_id && e.data.patch_id === landingPatchId,
  ) ?? null;
}
if (!linkedDiscussion && discussionIdLink) {
  linkedDiscussion = sameProjectDiscussions.find(
    e => e.data.discussion_id === discussionIdLink,
  ) ?? null;
}

const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const dateStrShort = d.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
---

<PublicLayout project={project} title={d.headline} description={d.tldr}>
  <article class="article">
    <nav class="crumb">
      <a href={`/${project.slug}/`}>Front Page</a>
      <span class="sep">&rsaquo;</span>
      <a href={`/${project.slug}/#stream`}>The Wire</a>
      <span class="sep">&rsaquo;</span>
      <span class="sub">{d.subsystem}</span>
    </nav>

    <div class="article-date">{dateStrShort}</div>

    <header class="article-head">
      <div class="kicker-row">
        <span class="wsj-kicker">{d.subsystem}</span>
        {d.impact_score != null && (
          <>
            <span class="kicker-sep">&mdash;</span>
            <span class="impact-pill">Impact {d.impact_score}&thinsp;/&thinsp;10</span>
          </>
        )}
        {d.performance_win && <span class="badge perf">Performance Win</span>}
        {d.breaking_change && <span class="badge breaking">Breaking Change</span>}
      </div>

      <h1 class="head">{d.headline}</h1>
      <p class="deck">{d.tldr}</p>

      <div class="byline-row">
        {d.author && <span class="byline">By <em>{d.author}</em></span>}
        <span class="byline-date">{dateStr}</span>
        {d.outcome && <span class="byline-outcome">{d.outcome.replace(/_/g, ' ')}</span>}
      </div>
    </header>

    {linkedDiscussion && (
      <aside class="thread-link">
        <div class="thread-link-head">From the Thread</div>
        <a class="thread-link-body" href={`/${project.slug}/discussions/${linkedDiscussion.id}`}>
          <span class="thread-link-headline">{linkedDiscussion.data.headline}</span>
          <span class="thread-link-arrow">&rarr;</span>
        </a>
        {linkedDiscussion.data.proposer && (
          <div class="thread-link-meta">
            Proposed by <em>{linkedDiscussion.data.proposer}</em>
            {linkedDiscussion.data.exchanges && linkedDiscussion.data.exchanges.length > 0 && (
              <>
                <span class="bullet">&middot;</span>
                <span>
                  {linkedDiscussion.data.exchanges.length}{' '}
                  {linkedDiscussion.data.exchanges.length === 1 ? 'voice' : 'voices'} on file
                </span>
              </>
            )}
          </div>
        )}
      </aside>
    )}

    <div class="body wsj-dropcap">
      <Content />
    </div>

    {(d.series_parts ?? []).length > 0 && (
      <section class="extra">
        <h2>Part of a Series</h2>
        <ul>
          {d.series_parts!.map(p => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {(d.tags ?? []).length > 0 && (
      <div class="tags">
        <span class="tags-label">Filed Under:</span>
        {d.tags!.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="source">
      <a href={d.url} target="_blank" rel="noopener">View Commit &rarr;</a>
    </div>

    {(d.primer_expert || d.primer_general) && (
      <aside class="primer">
        <div class="primer-head">What is this even about?</div>
        {d.primer_expert && (
          <div class="primer-variant">
            <div class="primer-audience">For toolchain folks</div>
            <p>{d.primer_expert}</p>
          </div>
        )}
        {d.primer_general && (
          <div class="primer-variant">
            <div class="primer-audience">For everyone else</div>
            <p>{d.primer_general}</p>
          </div>
        )}
      </aside>
    )}

    <nav class="prevnext">
      {next && (
        <a href={`/${project.slug}/landings/${next.id}`} class="nav-prev">
          <span class="nav-label">&larr; Earlier</span>
          <span class="nav-title">{next.data.headline}</span>
        </a>
      )}
      {prev && (
        <a href={`/${project.slug}/landings/${prev.id}`} class="nav-next">
          <span class="nav-label">Next &rarr;</span>
          <span class="nav-title">{prev.data.headline}</span>
        </a>
      )}
    </nav>
  </article>
</PublicLayout>

<style>
  .article {
    max-width: 680px;
    margin: 0 auto;
    padding: 0.5rem 0 2rem;
  }

  .crumb {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .crumb a { color: var(--color-muted); text-decoration: none; }
  .crumb a:hover { color: var(--color-accent); }
  .crumb .sep { color: var(--color-rule); }
  .crumb .sub { color: var(--color-accent); font-weight: 700; }

  .article-date {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 1.5rem;
  }

  .article-head { text-align: center; margin-bottom: 1.5rem; }

  .kicker-row {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .kicker-sep { color: var(--color-rule-strong); }

  .impact-pill {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 1px;
    border-bottom: 2px solid var(--color-ink);
  }

  .badge {
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    border: 1px solid;
  }
  .badge.perf { color: #0a5c2f; border-color: #0a5c2f; }
  .badge.breaking { color: var(--color-accent); border-color: var(--color-accent); }

  .head {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: clamp(1.85rem, 4.2vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }

  .deck {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--color-muted);
    margin: 0 auto 1rem;
    max-width: 580px;
  }

  .byline-row {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-muted);
    display: inline-flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
  }
  .byline em { font-weight: 600; color: var(--color-ink); font-style: italic; }
  .byline-outcome { text-transform: uppercase; letter-spacing: 0.08em; font-style: normal; font-size: 0.72rem; font-family: var(--font-sans); }

  .thread-link {
    margin: 0.5rem 0 1.25rem;
    padding: 0.9rem 1rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-paper);
  }
  .thread-link-head {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .thread-link-body {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-ink);
  }
  .thread-link-headline {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
    letter-spacing: -0.005em;
    border-bottom: 1px solid transparent;
  }
  .thread-link-body:hover .thread-link-headline {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .thread-link-arrow {
    color: var(--color-accent);
    font-weight: 700;
  }
  .thread-link-meta {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.82rem;
    color: var(--color-muted);
    display: inline-flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .thread-link-meta em { font-weight: 600; color: var(--color-ink); font-style: italic; }
  .thread-link .bullet { color: var(--color-rule); }

  .body {
    font-family: var(--font-serif);
    font-size: 1.06rem;
    line-height: 1.7;
    color: var(--color-ink);
    padding-top: 0.75rem;
    margin-top: 1rem;
  }
  .body :global(p) { margin: 0 0 1.05em; }
  .body :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .body :global(a:hover) { background: var(--color-accent); color: var(--color-paper); }
  .body :global(h2) {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.35rem;
    margin: 1.6em 0 0.45em;
    letter-spacing: -0.01em;
  }
  .body :global(h3) {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin: 1.4em 0 0.4em;
  }
  .body :global(blockquote) {
    margin: 1.2em 0;
    padding: 0.4em 0 0.4em 1em;
    border-left: 3px solid var(--color-accent);
    font-style: italic;
    color: var(--color-muted);
  }
  /* Inline code + pre blocks inherit GitHub-style rules from global.css */

  .extra {
    margin: 2rem 0 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }
  .extra h2 {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }
  .extra ul { margin: 0; padding-left: 1.25rem; font-family: var(--font-serif); font-size: 0.95rem; line-height: 1.55; }
  .extra a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid var(--color-accent); }

  .tags {
    margin: 2rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tags-label { color: var(--color-muted); margin-right: 0.6rem; font-weight: 700; }
  .tag {
    color: var(--color-ink);
    margin-right: 0.75rem;
    border-bottom: 1px dotted var(--color-muted);
    padding-bottom: 1px;
  }

  .source {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 2rem;
  }
  .source a { color: var(--color-accent); text-decoration: none; font-weight: 700; }

  .primer {
    margin: 0 0 2rem;
    padding: 1rem 0 0;
    border-top: 1px dashed var(--color-rule);
    opacity: 0.55;
  }
  .primer-head {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
  }
  .primer-variant + .primer-variant {
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px dotted var(--color-rule);
  }
  .primer-audience {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }
  .primer p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
  }

  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 3px double var(--color-rule-strong);
  }
  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: inherit;
  }
  .nav-next { text-align: right; }
  .nav-label {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
  }
  .nav-title {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .nav-prev:hover .nav-title, .nav-next:hover .nav-title { color: var(--color-accent); }
</style>
