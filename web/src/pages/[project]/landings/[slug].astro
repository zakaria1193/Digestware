---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import CommitRow from '../../../components/CommitRow.astro';
import FilterBar from '../../../components/FilterBar.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, getProject } from '../../../config/projects';
import { SHOW_IMPACT_SCORE } from '../../../config/features';
import { rankTags, groupTags } from '../../../lib/filterTags';
import { isPublic } from '../../../lib/visibility';
import { relativeDate } from '../../../lib/dates';
import { inlineCode } from '../../../lib/inlineCode';

export async function getStaticPaths() {
  const paths = [];
  for (const p of PROJECTS) {
    // Stubs are admin-only; don't generate public detail pages for them.
    const entries = await getCollection(
      'landings',
      ({ data }) => data.project === p.slug && isPublic(data),
    );
    for (const entry of entries) {
      paths.push({
        params: { project: p.slug, slug: entry.id },
        props: { entry, projectSlug: p.slug },
      });
    }
  }
  return paths;
}

const { entry, projectSlug } = Astro.props as { entry: any; projectSlug: string };
const project = getProject(projectSlug)!;
const d = entry.data;
const { Content } = await entry.render();

const all = (await getCollection(
  'landings',
  ({ data }) => data.project === projectSlug && isPublic(data),
))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex(e => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

// Cross-link this landing back to the discussion that birthed the patch.
// Match by patch_id first (git's stable cross-platform key), then fall back
// to the explicit discussion_id_link trailer. Stay within-project so we
// never merge content across projects.
const sameProjectDiscussions = await getCollection(
  'discussions',
  ({ data }) => data.project === projectSlug && isPublic(data),
);
const landingPatchId = d.patch_id ?? null;
const discussionIdLink = d.discussion_id_link ?? null;
let linkedDiscussion: any = null;
if (landingPatchId) {
  linkedDiscussion = sameProjectDiscussions.find(
    e => e.data.patch_id && e.data.patch_id === landingPatchId,
  ) ?? null;
}
if (!linkedDiscussion && discussionIdLink) {
  linkedDiscussion = sameProjectDiscussions.find(
    e => e.data.discussion_id === discussionIdLink,
  ) ?? null;
}
// Last resort: discussion_id_link is sometimes a synthesized reference like
// "public_inbox:binutils#34165" (a PR number) rather than a real
// discussion_id, so it never matches the exact lookup above. The same PR
// number does appear in the discussion's headline/title (e.g. "PR 34165 …"),
// so fall back to matching on that. If several threads mention the same PR,
// prefer the earliest one — the original report is what "birthed" the fix.
if (!linkedDiscussion && discussionIdLink) {
  const prMatch = discussionIdLink.match(/#(\d+)$/);
  if (prMatch) {
    const prRe = new RegExp(`\\bPR\\s*0*${prMatch[1]}\\b`, 'i');
    const candidates = sameProjectDiscussions
      .filter(e => prRe.test(e.data.headline ?? '') || prRe.test(e.data.title ?? ''))
      .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
    linkedDiscussion = candidates[0] ?? null;
  }
}

const dateStr = relativeDate(d.date, { year: 'numeric', month: 'long', day: 'numeric' });
const dateStrShort = relativeDate(d.date, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();

function scoreColor(n: number | null | undefined): string {
  if (n == null) return '#888';
  if (n <= 2)  return '#5a5a5a';
  if (n <= 4)  return '#2e6a8e';
  if (n <= 6)  return '#1a4d8a';
  if (n <= 8)  return '#7a1a2e';
  return '#b80018';
}

// Filter bar data — same chip set as the home page would render for this
// project so navigating between the two views keeps the same filter UI.
// The home page also folds in discussions; we do the same so a tag chip
// is present whether the user came from a discussion or a commit.
type TagCategoryFile = { assignments: Record<string, string> };
const tagCategoryModules = import.meta.glob<TagCategoryFile>(
  '../../../data/tag-categories/*.json',
  { eager: true },
);
const tagCategoryFile = tagCategoryModules[`../../../data/tag-categories/${projectSlug}.json`];
const tagAssignments: Record<string, string> = tagCategoryFile?.assignments ?? {};

const rankedTags = rankTags([...sameProjectDiscussions, ...all]);
const groupedTags = groupTags(rankedTags, tagAssignments);
const totalItems = sameProjectDiscussions.length + all.length;

---

<PublicLayout project={project} title={d.headline} description={d.tldr}>

  <script is:inline>
    // Pre-paint scroll-restore setup. When the previous page stashed a
    // scroll position in sessionStorage (sidebar commit-switch flow), tell
    // the browser to skip its own restoration and hide the page until our
    // main script can place us at the saved Y. Avoids the top→Y flash.
    if (sessionStorage.getItem('commit-scroll-y') !== null) {
      try { history.scrollRestoration = 'manual'; } catch (e) {}
      document.documentElement.classList.add('scroll-restoring');
      // Safety: never leave the page permanently hidden if something fails.
      setTimeout(() => document.documentElement.classList.remove('scroll-restoring'), 800);
    }
  </script>

  <FilterBar rankedTags={rankedTags} groupedTags={groupedTags} totalItems={totalItems} />

  <div class="landing-layout">
    <aside class="commits-sidebar" data-carry-filter>
      <div class="sidebar-sticky-head">
        <div class="sidebar-brand">Latest Commits</div>
        <div class="sidebar-sub">{all.length} commit{all.length !== 1 ? 's' : ''}</div>
        <div class="sidebar-rule-thick"></div>
        <div class="sidebar-rule-thin"></div>
      </div>
      <div class="sidebar-list">
        {all.map(e => (
          <div
            class:list={["sidebar-item", e.id === entry.id && "sidebar-item-current"]}
            data-current={e.id === entry.id ? "true" : undefined}
          >
            <CommitRow entry={e} projectSlug={projectSlug} />
          </div>
        ))}
      </div>
    </aside>

  <article class="article">
    <nav class="crumb">
      <a href={`/${project.slug}/`}>Front Page</a>
      <span class="sep">&rsaquo;</span>
      <a href={`/${project.slug}/#stream`}>Latest Commits</a>
      <span class="sep">&rsaquo;</span>
      <span class="sub">{d.subsystem}</span>
    </nav>

    <div class="article-date">{dateStrShort}</div>

    <header class="article-head">
      <div class="kicker-row">
        <span class="wsj-kicker">{d.subsystem}</span>
        {SHOW_IMPACT_SCORE && d.impact_score != null && (
          <>
            <span class="kicker-sep">&mdash;</span>
            <span class="impact-pill" style={`color: ${scoreColor(d.impact_score)}; border-bottom-color: ${scoreColor(d.impact_score)}`}>Impact {d.impact_score}&thinsp;/&thinsp;10</span>
          </>
        )}
        {d.performance_win && <span class="badge perf">Performance Win</span>}
        {d.breaking_change && <span class="badge breaking">Breaking Change</span>}
      </div>

      <h1 class="head">{d.headline}</h1>
      <p class="deck">{d.tldr}</p>

      <div class="byline-row">
        {d.author && <span class="byline">By <em>{d.author}</em></span>}
        <span class="byline-date">{dateStr}</span>
        {d.outcome && <span class="byline-outcome">{d.outcome.replace(/_/g, ' ')}</span>}
      </div>
    </header>

    <div class="body wsj-dropcap">
      <Content />
    </div>

    {d.primer_expert && (
      <section class="extra">
        <h2>In Details</h2>
        <p set:html={inlineCode(d.primer_expert)} />
      </section>
    )}

    {(d.primer_glossary ?? []).length > 0 && (
      <section class="glossary">
        <div class="glossary-head">
          <span class="glossary-label">For Context</span>
          <span class="glossary-rule"></span>
        </div>
        <dl class="glossary-list">
          {d.primer_glossary!.map((item: any) => (
            <>
              <dt class="glossary-term">{item.term}</dt>
              <dd class="glossary-def" set:html={inlineCode(item.definition)} />
            </>
          ))}
        </dl>
      </section>
    )}

    {(d.series_parts ?? []).length > 0 && (
      <section class="extra">
        <h2>Part of a Series</h2>
        <ul>
          {d.series_parts!.map(p => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {(d.tags ?? []).length > 0 && (
      <div class="tags">
        <span class="tags-label">Filed Under:</span>
        {d.tags!.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="source">
      <a href={d.url} target="_blank" rel="noopener">View Commit &rarr;</a>
      {linkedDiscussion && (
        <a href={`/${project.slug}/discussions/${linkedDiscussion.id}`}>From the Discussion Thread &rarr;</a>
      )}
    </div>

    <nav class="prevnext">
      {next && (
        <a href={`/${project.slug}/landings/${next.id}`} class="nav-prev">
          <span class="nav-label">&larr; Earlier</span>
          <span class="nav-title">{next.data.headline}</span>
        </a>
      )}
      {prev && (
        <a href={`/${project.slug}/landings/${prev.id}`} class="nav-next">
          <span class="nav-label">Next &rarr;</span>
          <span class="nav-title">{prev.data.headline}</span>
        </a>
      )}
    </nav>
  </article>
  </div>

<script>
  // Scroll restoration on arrival: when the previous page (the project
  // home or another landing) stashed window.scrollY in sessionStorage,
  // place us back at it before the body becomes visible. The sidebar's
  // own scroll position is recovered independently by bringing the
  // currently-open commit into view inside its scroll container.
  const currentWire = document.querySelector<HTMLElement>('[data-current="true"] .wire');

  function revealCurrentInSidebar(): void {
    if (!currentWire) return;
    let scroller: HTMLElement | null = currentWire.parentElement;
    while (scroller && scroller !== document.body) {
      const cs = getComputedStyle(scroller);
      if ((cs.overflowY === 'auto' || cs.overflowY === 'scroll') &&
          scroller.scrollHeight > scroller.clientHeight) break;
      scroller = scroller.parentElement;
    }
    if (!scroller || scroller === document.body) return;
    const wireRect = currentWire.getBoundingClientRect();
    const scrollerRect = scroller.getBoundingClientRect();
    const offsetWithin = wireRect.top - scrollerRect.top + scroller.scrollTop;
    const target = offsetWithin - (scroller.clientHeight - currentWire.clientHeight) / 2;
    scroller.scrollTop = Math.max(0, target);
  }

  const savedScrollY = sessionStorage.getItem('commit-scroll-y');
  if (savedScrollY !== null) {
    sessionStorage.removeItem('commit-scroll-y');
    window.scrollTo({ top: parseInt(savedScrollY), behavior: 'instant' });
    revealCurrentInSidebar();
    document.documentElement.classList.remove('scroll-restoring');
  } else {
    revealCurrentInSidebar();
  }
</script>

</PublicLayout>

<style>
  /* Hide the page until the inline scroll-restore script places us at the
     saved Y, so users don't see a top→Y flash when switching commits. */
  :global(html.scroll-restoring) body { visibility: hidden; }

  /* ── Two-column layout: sidebar + article ── */
  .landing-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: start;
  }

  @media (min-width: 900px) {
    .landing-layout {
      grid-template-columns: minmax(260px, 1fr) minmax(0, 3fr);
      gap: 2rem;
    }
  }

  /* ── Sidebar ── */
  .commits-sidebar {
    display: none;
  }

  @media (min-width: 900px) {
    .commits-sidebar {
      display: block;
      position: sticky;
      top: 0.75rem;
      max-height: calc(100vh - 1.5rem);
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: thin;
      scrollbar-color: var(--color-rule) transparent;
      border-right: 1px solid var(--color-rule-strong);
      padding-right: 1.5rem;
    }
    .commits-sidebar::-webkit-scrollbar { width: 6px; }
    .commits-sidebar::-webkit-scrollbar-thumb { background: var(--color-rule); }
  }

  .sidebar-sticky-head {
    position: sticky;
    top: 0;
    background: var(--color-paper);
    padding-bottom: 0.5rem;
    z-index: 1;
  }

  .sidebar-brand {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    line-height: 1.1;
    padding-top: 0.5rem;
  }

  .sidebar-sub {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }

  .sidebar-rule-thick {
    height: 3px;
    background: var(--color-ink);
    margin-bottom: 2px;
  }

  .sidebar-rule-thin {
    height: 1px;
    background: var(--color-ink);
    margin-bottom: 0.4rem;
  }

  .sidebar-list {
    padding-bottom: 2rem;
  }

  /* Highlight the currently viewed commit */
  .sidebar-item-current :global(.wire) {
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    border-left: 2px solid var(--color-accent);
    padding-left: 0.55rem;
    padding-right: 0.4rem;
    margin-left: -0.55rem;
    margin-right: -0.4rem;
  }

  .sidebar-item-current :global(.wire-headline) {
    color: var(--color-accent);
  }

  /* Current commit stays visible even when filters would hide it;
     a subtle "viewing" label signals it's pinned. */
  .sidebar-item-current :global(.wire.wire-pinned) {
    opacity: 0.45;
    border-left-style: dashed;
  }
  .sidebar-item-current :global(.wire.wire-pinned::after) {
    content: 'viewing';
    display: block;
    font-family: var(--font-sans);
    font-size: 0.52rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 0.15rem;
  }

  /* ── Article column ── */
  .article {
    max-width: 680px;
    padding: 0.5rem 0 2rem;
    min-width: 0;
  }

  @media (min-width: 900px) {
    .article { padding-left: 1.5rem; }
  }

  @media (min-width: 1100px) {
    .article { padding-left: 2.5rem; }
  }

  @media (min-width: 1400px) {
    .article { padding-left: 3.5rem; }
  }

  .crumb {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .crumb a { color: var(--color-muted); text-decoration: none; }
  .crumb a:hover { color: var(--color-accent); }
  .crumb .sep { color: var(--color-rule); }
  .crumb .sub { color: var(--color-accent); font-weight: 700; }

  .article-date {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 1.5rem;
  }

  .article-head { text-align: center; margin-bottom: 1.5rem; }

  .kicker-row {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .kicker-sep { color: var(--color-rule-strong); }

  .impact-pill {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 1px;
    border-bottom: 2px solid var(--color-ink);
  }

  .badge {
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    border: 1px solid;
  }
  .badge.perf { color: #0a5c2f; border-color: #0a5c2f; }
  .badge.breaking { color: var(--color-accent); border-color: var(--color-accent); }

  .head {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: clamp(1.85rem, 4.2vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }

  .deck {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--color-muted);
    margin: 0 auto 1rem;
    max-width: 580px;
  }

  .byline-row {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-muted);
    display: inline-flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
  }
  .byline em { font-weight: 600; color: var(--color-ink); font-style: italic; }
  .byline-outcome { text-transform: uppercase; letter-spacing: 0.08em; font-style: normal; font-size: 0.72rem; font-family: var(--font-sans); }

  .body {
    font-family: var(--font-serif);
    font-size: 1.06rem;
    line-height: 1.7;
    color: var(--color-ink);
    padding-top: 0.75rem;
    margin-top: 1rem;
  }
  .body :global(p) { margin: 0 0 1.05em; }
  .body :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .body :global(a:hover) { background: var(--color-accent); color: var(--color-paper); }
  .body :global(h2) {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.35rem;
    margin: 1.6em 0 0.45em;
    letter-spacing: -0.01em;
  }
  .body :global(h3) {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin: 1.4em 0 0.4em;
  }
  .body :global(blockquote) {
    margin: 1.2em 0;
    padding: 0.4em 0 0.4em 1em;
    border-left: 3px solid var(--color-accent);
    font-style: italic;
    color: var(--color-muted);
  }
  /* Inline code + pre blocks inherit GitHub-style rules from global.css */

  .extra {
    margin: 2rem 0 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }
  .extra h2 {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }
  .extra ul { margin: 0; padding-left: 1.25rem; font-family: var(--font-serif); font-size: 0.95rem; line-height: 1.55; }
  .extra p { margin: 0; font-family: var(--font-serif); font-size: 0.95rem; line-height: 1.6; color: var(--color-ink); }
  .extra a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid var(--color-accent); }

  .tags {
    margin: 2rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tags-label { color: var(--color-muted); margin-right: 0.6rem; font-weight: 700; }
  .tag {
    color: var(--color-ink);
    margin-right: 0.75rem;
    border-bottom: 1px dotted var(--color-muted);
    padding-bottom: 1px;
  }

  .source {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
  .source a { color: var(--color-accent); text-decoration: none; font-weight: 700; }

  .glossary {
    margin: 2rem 0 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }
  .glossary-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .glossary-label {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .glossary-rule {
    flex: 1;
    height: 1px;
    background: var(--color-rule);
  }
  .glossary-list {
    margin: 0;
    padding: 0;
  }
  .glossary-term {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    margin: 0.8rem 0 0.15rem;
  }
  .glossary-term:first-child { margin-top: 0; }
  .glossary-def {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
    padding: 0;
  }

  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 3px double var(--color-rule-strong);
  }
  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: inherit;
  }
  .nav-next { text-align: right; }
  .nav-label {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
  }
  .nav-title {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .nav-prev:hover .nav-title, .nav-next:hover .nav-title { color: var(--color-accent); }
</style>
