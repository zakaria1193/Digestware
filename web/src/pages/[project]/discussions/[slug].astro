---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, getProject } from '../../../config/projects';

export async function getStaticPaths() {
  const paths = [];
  for (const p of PROJECTS) {
    const entries = await getCollection('discussions', ({ data }) => data.project === p.slug);
    for (const entry of entries) {
      paths.push({
        params: { project: p.slug, slug: entry.id },
        props: { entry, projectSlug: p.slug },
      });
    }
  }
  return paths;
}

const { entry, projectSlug } = Astro.props as { entry: any; projectSlug: string };
const project = getProject(projectSlug)!;
const d = entry.data;
const { Content } = await entry.render();

// Prev/next stays within the same project — no cross-project merging.
const all = (await getCollection('discussions', ({ data }) => data.project === projectSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex(e => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const outcomeLabels: Record<string, string> = {
  committed: 'Committed',
  ready: 'Ready to Land',
  under_review: 'Under Review',
  needs_revision: 'Needs Revision',
  nackd: 'NACK\u2019d',
  proposed: 'Proposed',
  stalled: 'Stalled',
  withdrawn: 'Withdrawn',
};
const outcomeLabel = outcomeLabels[d.outcome ?? 'proposed'] ?? (d.outcome ?? 'proposed').replace(/_/g, ' ');
const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const dateStrShort = d.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();

function scoreColor(n: number | null | undefined): string {
  if (n == null) return '#888';
  if (n <= 2)  return '#5a5a5a';
  if (n <= 4)  return '#2e6a8e';
  if (n <= 6)  return '#1a4d8a';
  if (n <= 8)  return '#7a1a2e';
  return '#b80018';
}
---

<PublicLayout project={project} title={d.headline} description={d.tldr}>
  <article class="article">
    <nav class="crumb">
      <a href={`/${project.slug}/`}>Front Page</a>
      <span class="sep">&rsaquo;</span>
      <span class="sub">{d.subsystem}</span>
    </nav>

    <div class="article-date">{dateStrShort}</div>

    <header class="article-head">
      <div class="kicker-row">
        <span class="wsj-kicker">{d.subsystem}</span>
        <span class="kicker-sep">&mdash;</span>
        <span class="outcome-pill">{outcomeLabel}</span>
        {d.impact_score != null && (
          <>
            <span class="kicker-sep">&mdash;</span>
            <span class="score-pill" style={`color: ${scoreColor(d.impact_score)}; border-bottom-color: ${scoreColor(d.impact_score)}`}>
              Impact {d.impact_score}&thinsp;/&thinsp;10
            </span>
          </>
        )}
        {d.sentiment_score != null && (
          <>
            <span class="kicker-sep">&mdash;</span>
            <span class="score-pill" style={`color: ${scoreColor(d.sentiment_score)}; border-bottom-color: ${scoreColor(d.sentiment_score)}`}>
              Sentiment {d.sentiment_score}&thinsp;/&thinsp;10
            </span>
          </>
        )}
      </div>

      <h1 class="head">{d.headline}</h1>

      <p class="deck">{d.tldr}</p>

      <div class="byline-row">
        {d.proposer && <span class="byline">By <em>{d.proposer}</em></span>}
        <span class="byline-date">{dateStr}</span>
      </div>
    </header>

    <div class="body wsj-dropcap">
      <Content />
    </div>

    {(d.exchanges ?? []).length > 0 && (
      <section class="exchanges">
        <div class="exchanges-head">
          <span class="exchanges-label">In the Thread</span>
          <span class="exchanges-rule"></span>
          <span class="exchanges-meta">
            {d.exchanges!.length} {d.exchanges!.length === 1 ? 'participant' : 'participants'}
          </span>
        </div>
        <ol class="exchanges-list">
          {d.exchanges!.map((e: any, i: number) => (
            <li class:list={["exchange", e.role && `role-${e.role}`]}>
              <div class="exchange-head">
                <span class="exchange-marker" aria-hidden="true">{i === 0 ? '\u00A7' : '\u00B6'}</span>
                <span class="exchange-author">{e.author}</span>
                {e.role && <span class="exchange-role">{e.role}</span>}
              </div>
              <p class="exchange-position">{e.position}</p>
              {e.quote && (
                <blockquote class="exchange-quote">&ldquo;{e.quote}&rdquo;</blockquote>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    {(d.technical_tradeoffs ?? []).length > 0 && (d.exchanges ?? []).length > 1 && (
      <section class="extra">
        <h2>Technical Tradeoffs</h2>
        <ul>
          {d.technical_tradeoffs!.map(t => <li>{t}</li>)}
        </ul>
      </section>
    )}

    {d.primer_expert && (
      <section class="extra">
        <h2>In Details</h2>
        <p>{d.primer_expert}</p>
      </section>
    )}

    {d.primer_general && (
      <section class="extra">
        <h2>For Context</h2>
        <p>{d.primer_general}</p>
      </section>
    )}

    {(d.series_parts ?? []).length > 0 && (
      <section class="extra">
        <h2>Part of a Series</h2>
        <ul>
          {d.series_parts!.map(p => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {(d.tags ?? []).length > 0 && (
      <div class="tags">
        <span class="tags-label">Filed Under:</span>
        {d.tags!.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="source">
      <a href={d.url} target="_blank" rel="noopener">View Original Thread &rarr;</a>
    </div>

    {(d.primer_glossary ?? []).length > 0 && (
      <section class="glossary">
        <div class="glossary-head">
          <span class="glossary-label">Glossary</span>
          <span class="glossary-rule"></span>
        </div>
        <dl class="glossary-list">
          {d.primer_glossary!.map((item: any) => (
            <>
              <dt class="glossary-term">{item.term}</dt>
              <dd class="glossary-def">{item.definition}</dd>
            </>
          ))}
        </dl>
      </section>
    )}

    <nav class="prevnext">
      {next && (
        <a href={`/${project.slug}/discussions/${next.id}`} class="nav-prev">
          <span class="nav-label">&larr; Earlier</span>
          <span class="nav-title">{next.data.headline}</span>
        </a>
      )}
      {prev && (
        <a href={`/${project.slug}/discussions/${prev.id}`} class="nav-next">
          <span class="nav-label">Next &rarr;</span>
          <span class="nav-title">{prev.data.headline}</span>
        </a>
      )}
    </nav>
  </article>
</PublicLayout>

<style>
  .article {
    max-width: 680px;
    margin: 0 auto;
    padding: 0.5rem 0 2rem;
  }

  .crumb {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .crumb a { color: var(--color-muted); text-decoration: none; }
  .crumb a:hover { color: var(--color-accent); }
  .crumb .sep { color: var(--color-rule); }
  .crumb .sub { color: var(--color-accent); font-weight: 700; }

  .article-date {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 1.5rem;
  }

  .article-head { text-align: center; margin-bottom: 1.5rem; }

  .kicker-row {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .kicker-sep { color: var(--color-rule-strong); }
  .outcome-pill {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 1px;
    border-bottom: 2px solid var(--color-ink);
  }

  .head {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: clamp(1.85rem, 4.2vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }

  .deck {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--color-muted);
    margin: 0 auto 1rem;
    max-width: 580px;
  }

  .byline-row {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-muted);
    display: inline-flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
  }
  .byline em { font-weight: 600; color: var(--color-ink); font-style: italic; }

  .score-pill {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-bottom: 1px;
    border-bottom: 2px solid;
  }

  .body {
    font-family: var(--font-serif);
    font-size: 1.06rem;
    line-height: 1.7;
    color: var(--color-ink);
    padding-top: 0.5rem;
  }
  .body :global(p) { margin: 0 0 1.05em; }
  .body :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .body :global(a:hover) { background: var(--color-accent); color: var(--color-paper); }
  .body :global(h2) {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.35rem;
    margin: 1.6em 0 0.45em;
    letter-spacing: -0.01em;
  }
  .body :global(h3) {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin: 1.4em 0 0.4em;
  }
  .body :global(blockquote) {
    margin: 1.2em 0;
    padding: 0.4em 0 0.4em 1em;
    border-left: 3px solid var(--color-accent);
    font-style: italic;
    color: var(--color-muted);
  }
  /* Inline code + pre blocks inherit GitHub-style rules from global.css */

  .exchanges {
    margin: 2rem 0 1.75rem;
    padding-top: 1.25rem;
    border-top: 3px double var(--color-rule-strong);
  }
  .exchanges-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .exchanges-label {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .exchanges-rule {
    flex: 1;
    height: 1px;
    background: var(--color-rule);
  }
  .exchanges-meta {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .exchanges-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .exchange {
    padding: 0.85rem 0 0.95rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .exchange:last-child { border-bottom: none; }
  .exchange-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
    flex-wrap: wrap;
  }
  .exchange-marker {
    font-family: var(--font-serif-display);
    font-size: 1rem;
    font-weight: 900;
    color: var(--color-accent);
    line-height: 1;
  }
  .exchange-author {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }
  .exchange-role {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 0.08rem 0.4rem;
    border: 1px solid var(--color-rule);
  }
  .exchange.role-proposer .exchange-role {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .exchange.role-maintainer .exchange-role {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
  .exchange-position {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0;
  }
  .exchange-quote {
    margin: 0.55rem 0 0;
    padding: 0.2rem 0 0.2rem 0.9rem;
    border-left: 3px solid var(--color-rule);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .extra {
    margin: 2rem 0 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }
  .extra h2 {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
    letter-spacing: -0.005em;
  }
  .extra ul {
    margin: 0;
    padding-left: 1.25rem;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .extra li { margin-bottom: 0.35em; }
  .extra p { margin: 0; font-family: var(--font-serif); font-size: 0.95rem; line-height: 1.6; color: var(--color-ink); }
  .extra a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid var(--color-accent); }

  .tags {
    margin: 2rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tags-label {
    color: var(--color-muted);
    margin-right: 0.6rem;
    font-weight: 700;
  }
  .tag {
    color: var(--color-ink);
    margin-right: 0.75rem;
    border-bottom: 1px dotted var(--color-muted);
    padding-bottom: 1px;
  }

  .source {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 2rem;
  }
  .source a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 700;
  }

  .glossary {
    margin: 2rem 0 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }
  .glossary-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .glossary-label {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .glossary-rule {
    flex: 1;
    height: 1px;
    background: var(--color-rule);
  }
  .glossary-list {
    margin: 0;
    padding: 0;
  }
  .glossary-term {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    margin: 0.8rem 0 0.15rem;
  }
  .glossary-term:first-child { margin-top: 0; }
  .glossary-def {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0 0 0 0;
    padding: 0;
  }

  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 3px double var(--color-rule-strong);
  }
  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: inherit;
  }
  .nav-next { text-align: right; }
  .nav-label {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
  }
  .nav-title {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .nav-prev:hover .nav-title, .nav-next:hover .nav-title { color: var(--color-accent); }
</style>
