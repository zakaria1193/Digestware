---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, getProject } from '../../../config/projects';

export async function getStaticPaths() {
  const paths = [];
  for (const p of PROJECTS) {
    const entries = await getCollection('discussions', ({ data }) => data.project === p.slug);
    for (const entry of entries) {
      paths.push({
        params: { project: p.slug, slug: entry.id },
        props: { entry, projectSlug: p.slug },
      });
    }
  }
  return paths;
}

const { entry, projectSlug } = Astro.props as { entry: any; projectSlug: string };
const project = getProject(projectSlug)!;
const d = entry.data;
const { Content } = await entry.render();

// Prev/next stays within the same project — no cross-project merging.
const all = (await getCollection('discussions', ({ data }) => data.project === projectSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex(e => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const outcomeLabels: Record<string, string> = {
  committed: 'Committed',
  ready: 'Ready to Land',
  under_review: 'Under Review',
  needs_revision: 'Needs Revision',
  nackd: 'NACK\u2019d',
  proposed: 'Proposed',
  stalled: 'Stalled',
  withdrawn: 'Withdrawn',
};
const outcomeLabel = outcomeLabels[d.outcome ?? 'proposed'] ?? (d.outcome ?? 'proposed').replace(/_/g, ' ');
const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const dateStrShort = d.date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
---

<PublicLayout project={project} title={d.headline} description={d.tldr}>
  <article class="article">
    <nav class="crumb">
      <a href={`/${project.slug}/`}>Front Page</a>
      <span class="sep">&rsaquo;</span>
      <span class="sub">{d.subsystem}</span>
    </nav>

    <div class="article-date">{dateStrShort}</div>

    <header class="article-head">
      <div class="kicker-row">
        <span class="wsj-kicker">{d.subsystem}</span>
        <span class="kicker-sep">&mdash;</span>
        <span class="outcome-pill">{outcomeLabel}</span>
      </div>

      <h1 class="head">{d.headline}</h1>

      <p class="deck">{d.tldr}</p>

      <div class="byline-row">
        {d.proposer && <span class="byline">By <em>{d.proposer}</em></span>}
        <span class="byline-date">{dateStr}</span>
        {d.sentiment_score != null && (
          <span class="byline-score">Sentiment {d.sentiment_score}&thinsp;/&thinsp;10</span>
        )}
      </div>
    </header>

    {d.stakes && (
      <aside class="stakes">
        <div class="stakes-head">What&rsquo;s at Stake</div>
        <p>{d.stakes}</p>
      </aside>
    )}

    <div class="body wsj-dropcap">
      <Content />
    </div>

    {(d.technical_tradeoffs ?? []).length > 0 && (
      <section class="extra">
        <h2>Technical Tradeoffs</h2>
        <ul>
          {d.technical_tradeoffs!.map(t => <li>{t}</li>)}
        </ul>
      </section>
    )}

    {(d.series_parts ?? []).length > 0 && (
      <section class="extra">
        <h2>Part of a Series</h2>
        <ul>
          {d.series_parts!.map(p => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {(d.tags ?? []).length > 0 && (
      <div class="tags">
        <span class="tags-label">Filed Under:</span>
        {d.tags!.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="source">
      <a href={d.url} target="_blank" rel="noopener">View Original Thread &rarr;</a>
    </div>

    {d.primer && (
      <aside class="primer">
        <div class="primer-head">What is this even about?</div>
        <p>{d.primer}</p>
      </aside>
    )}

    <nav class="prevnext">
      {next && (
        <a href={`/${project.slug}/discussions/${next.id}`} class="nav-prev">
          <span class="nav-label">&larr; Earlier</span>
          <span class="nav-title">{next.data.headline}</span>
        </a>
      )}
      {prev && (
        <a href={`/${project.slug}/discussions/${prev.id}`} class="nav-next">
          <span class="nav-label">Next &rarr;</span>
          <span class="nav-title">{prev.data.headline}</span>
        </a>
      )}
    </nav>
  </article>
</PublicLayout>

<style>
  .article {
    max-width: 680px;
    margin: 0 auto;
    padding: 0.5rem 0 2rem;
  }

  .crumb {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .crumb a { color: var(--color-muted); text-decoration: none; }
  .crumb a:hover { color: var(--color-accent); }
  .crumb .sep { color: var(--color-rule); }
  .crumb .sub { color: var(--color-accent); font-weight: 700; }

  .article-date {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 1.5rem;
  }

  .article-head { text-align: center; margin-bottom: 1.5rem; }

  .kicker-row {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
  }
  .kicker-sep { color: var(--color-rule-strong); }
  .outcome-pill {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 1px;
    border-bottom: 2px solid var(--color-ink);
  }

  .head {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: clamp(1.85rem, 4.2vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
    color: var(--color-ink);
  }

  .deck {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--color-muted);
    margin: 0 auto 1rem;
    max-width: 580px;
  }

  .byline-row {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-muted);
    display: inline-flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
  }
  .byline em { font-weight: 600; color: var(--color-ink); font-style: italic; }
  .byline-score { letter-spacing: 0.02em; }

  .stakes {
    border-top: 1px solid var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule-strong);
    padding: 0.9rem 0;
    margin: 0 0 1.75rem;
  }
  .stakes-head {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .stakes p {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.55;
    margin: 0;
    color: var(--color-ink);
  }

  .body {
    font-family: var(--font-serif);
    font-size: 1.06rem;
    line-height: 1.7;
    color: var(--color-ink);
    padding-top: 0.5rem;
  }
  .body :global(p) { margin: 0 0 1.05em; }
  .body :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }
  .body :global(a:hover) { background: var(--color-accent); color: var(--color-paper); }
  .body :global(h2) {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.35rem;
    margin: 1.6em 0 0.45em;
    letter-spacing: -0.01em;
  }
  .body :global(h3) {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin: 1.4em 0 0.4em;
  }
  .body :global(blockquote) {
    margin: 1.2em 0;
    padding: 0.4em 0 0.4em 1em;
    border-left: 3px solid var(--color-accent);
    font-style: italic;
    color: var(--color-muted);
  }
  /* Inline code + pre blocks inherit GitHub-style rules from global.css */

  .extra {
    margin: 2rem 0 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }
  .extra h2 {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
    letter-spacing: -0.005em;
  }
  .extra ul {
    margin: 0;
    padding-left: 1.25rem;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .extra li { margin-bottom: 0.35em; }
  .extra a { color: var(--color-accent); text-decoration: none; border-bottom: 1px solid var(--color-accent); }

  .tags {
    margin: 2rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tags-label {
    color: var(--color-muted);
    margin-right: 0.6rem;
    font-weight: 700;
  }
  .tag {
    color: var(--color-ink);
    margin-right: 0.75rem;
    border-bottom: 1px dotted var(--color-muted);
    padding-bottom: 1px;
  }

  .source {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: 2rem;
  }
  .source a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 700;
  }

  .primer {
    margin: 0 0 2rem;
    padding: 1rem 0 0;
    border-top: 1px dashed var(--color-rule);
    opacity: 0.55;
  }
  .primer-head {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.4rem;
  }
  .primer p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 0;
  }

  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 3px double var(--color-rule-strong);
  }
  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: inherit;
  }
  .nav-next { text-align: right; }
  .nav-label {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
  }
  .nav-title {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .nav-prev:hover .nav-title, .nav-next:hover .nav-title { color: var(--color-accent); }
</style>
