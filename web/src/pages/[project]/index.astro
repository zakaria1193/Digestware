---
import PublicLayout from '../../layouts/PublicLayout.astro';
import BentoCard from '../../components/BentoCard.astro';
import CommitRow from '../../components/CommitRow.astro';
import LessonHero from '../../components/LessonHero.astro';
import LessonBacklog from '../../components/LessonBacklog.astro';
import FilterBar from '../../components/FilterBar.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, getProject } from '../../config/projects';
import { rankTags, groupTags } from '../../lib/filterTags';
import { isPublic } from '../../lib/visibility';

export async function getStaticPaths() {
  return PROJECTS.map(p => ({ params: { project: p.slug }, props: { projectSlug: p.slug } }));
}

const { projectSlug } = Astro.props as { projectSlug: string };
const project = getProject(projectSlug)!;

// HARD rule: never merge content across projects — filter by `project` field.
// Stubs (agent-side placeholders for failed LLM batches) are excluded from the
// public site; they remain visible under /admin for ops triage.
const allDiscussions = (await getCollection(
  'discussions',
  ({ data }) => data.project === projectSlug && isPublic(data),
))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const bySubsystem = new Map<string, typeof allDiscussions>();
for (const d of allDiscussions) {
  const sub = d.data.subsystem;
  if (!bySubsystem.has(sub)) bySubsystem.set(sub, []);
  bySubsystem.get(sub)!.push(d);
}

function clusterGroup(entries: typeof allDiscussions): Map<string, { count: number; show: boolean }> {
  const result = new Map<string, { count: number; show: boolean }>();
  const sevenDays = 7 * 24 * 60 * 60 * 1000;
  const visited = new Set<string>();

  for (const entry of entries) {
    if (visited.has(entry.id)) continue;
    const cluster = [entry];
    visited.add(entry.id);

    for (const other of entries) {
      if (visited.has(other.id)) continue;
      const dateDiff = Math.abs(entry.data.date.getTime() - other.data.date.getTime());
      const sharedTag = (entry.data.tags ?? []).some(t => (other.data.tags ?? []).includes(t));
      if (sharedTag && dateDiff <= sevenDays) {
        cluster.push(other);
        visited.add(other.id);
      }
    }

    cluster.sort((a, b) => {
      const sa = a.data.impact_score ?? a.data.sentiment_score ?? 0;
      const sb = b.data.impact_score ?? b.data.sentiment_score ?? 0;
      return sb - sa;
    });
    result.set(cluster[0].id, { count: cluster.length, show: true });
    for (let i = 1; i < cluster.length; i++) {
      result.set(cluster[i].id, { count: 1, show: false });
    }
  }
  return result;
}

const landings = (await getCollection(
  'landings',
  ({ data }) => data.project === projectSlug && isPublic(data),
))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const subsystemKeys = [...bySubsystem.keys()].sort((a, b) => {
  const latestA = bySubsystem.get(a)![0]?.data.date.getTime() ?? 0;
  const latestB = bySubsystem.get(b)![0]?.data.date.getTime() ?? 0;
  return latestB - latestA;
});

// Tag categories are produced at digest-generation time by
// agents/tag_categorizer.py and written to web/src/data/tag-categories/<project>.json.
// Astro's import.meta.glob inlines the JSON at build time; if the file is
// missing the filter bar degrades gracefully (every chip lands in "Other").
type TagCategoryFile = { assignments: Record<string, string> };
const tagCategoryModules = import.meta.glob<TagCategoryFile>(
  '../../data/tag-categories/*.json',
  { eager: true },
);
const tagCategoryFile = tagCategoryModules[`../../data/tag-categories/${projectSlug}.json`];
const tagAssignments: Record<string, string> = tagCategoryFile?.assignments ?? {};

// The week's lesson. Newest wins; absent is normal (no eligible commit that
// week, or a mirror that hasn't caught up yet) and simply renders nothing.
// Once a second lesson exists the two behind the hero are listed under it, so
// the front page always surfaces the three most recent rather than burying
// everything but the newest.
const lessons = (await getCollection(
  'lessons',
  ({ data }) => data.project === projectSlug && isPublic(data),
))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestLesson = lessons[0] ?? null;
const previousLessons = lessons.slice(1, 3);

const rankedTags = rankTags([...allDiscussions, ...landings]);
const groupedTags = groupTags(rankedTags, tagAssignments);
const totalItems = allDiscussions.length + landings.length;
---

<PublicLayout project={project} isHome>
  <FilterBar rankedTags={rankedTags} groupedTags={groupedTags} totalItems={totalItems} />

  <div class="page-grid">
    <!-- Left: Commit Stream (sidebar) -->
    <aside class="commit-stream" id="stream" data-carry-filter>
      <div class="stream-sticky-head">
        <div class="stream-head">
          <div class="stream-brand">Latest Commits</div>
          <div class="stream-sub">{landings.length} commit{landings.length !== 1 ? 's' : ''}</div>
        </div>
        <div class="stream-rule"></div>
        <div class="stream-rule-thin"></div>
      </div>

      <div class="stream-list" id="stream-list">
        {landings.length === 0 && (
          <p class="empty-wire">No landed commits in the current window.</p>
        )}
        {landings.map(entry => <CommitRow entry={entry} projectSlug={project.slug} />)}
      </div>
    </aside>

    <!-- Right: Lesson of the Week, then the Bento Grid -->
    <div class="main-col">
      <!-- Sits outside [data-subsystem-block], so the tag filter never
           collapses it. Intentional: the lesson is the week's editorial
           anchor, not one more filterable item in the feed. -->
      {latestLesson && <LessonHero entry={latestLesson} projectSlug={project.slug} />}
      <LessonBacklog entries={previousLessons} projectSlug={project.slug} />

      <div class="wsj-section-head">
        <h2>Active Discussions</h2>
        <span class="wsj-section-rule"></span>
        <span class="wsj-meta">{allDiscussions.length} discussions</span>
      </div>

      {subsystemKeys.length === 0 && (
        <p class="empty">No active discussions in the current window.</p>
      )}

      {subsystemKeys.map(sub => {
        const entries = bySubsystem.get(sub)!;
        const clusterMap = clusterGroup(entries);
        const visibleEntries = entries.filter(e => clusterMap.get(e.id)?.show !== false);
        if (visibleEntries.length === 0) return null;
        return (
          <section class="subsystem-block" data-subsystem-block>
            <div class="subsystem-head">
              <span class="wsj-section-label">{sub}</span>
              <span class="wsj-section-rule"></span>
            </div>
            <div class="bento-grid">
              {visibleEntries.map((entry, i) => (
                <BentoCard entry={entry} projectSlug={project.slug} clusterCount={clusterMap.get(entry.id)?.count ?? 1} featured={i === 0} />
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>
</PublicLayout>

<style>
  .page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* On a phone the single column follows DOM order, which would open the page
     on the commit stream and push the lesson below it. The lesson is the
     editorial anchor, so it leads; the stream follows the grid. The desktop
     rule below restores the stream to its left-hand column. */
  .main-col { min-width: 0; order: 1; }
  .commit-stream { order: 2; }

  .empty, .empty-wire {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-muted);
    padding: 1rem 0;
  }
  .empty-wire { font-size: 0.85rem; }

  .subsystem-block { margin-bottom: 2rem; }
  .subsystem-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    /* Featured cards (`.story-featured`) take `grid-column: span 2`. With the
       default sparse auto-flow, a span-2 card that lands where two contiguous
       columns aren't free skips forward, leaving holes that later
       normal-width cards flow past — producing visible empty slots in the
       middle or on the left. `dense` backfills those holes. */
    grid-auto-flow: dense;
  }

  .commit-stream {
    font-family: var(--font-serif);
  }


  .stream-sticky-head {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-paper);
    padding-top: 0.25rem;
  }
  .stream-head { padding-bottom: 0.15rem; }
  .stream-brand {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--color-ink);
    padding-top: 0.5rem;
  }
  .stream-sub {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }
  .stream-rule {
    border-top: 3px double var(--color-rule-strong);
    margin-top: 0.5rem;
  }
  .stream-rule-thin {
    border-top: 1px solid var(--color-rule-strong);
    margin-top: 2px;
    margin-bottom: 0.5rem;
  }

  .stream-list { display: flex; flex-direction: column; }

  /* The subsystem section collapses its full vertical footprint when its only
     visible card has been filtered away. */
  .subsystem-block {
    overflow: hidden;
    max-height: 9999px;
    transition:
      opacity 0.36s cubic-bezier(0.4, 0, 0.2, 1),
      max-height 0.36s cubic-bezier(0.4, 0, 0.2, 1),
      margin 0.36s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .subsystem-block.is-filtered {
    opacity: 0;
    max-height: 0;
    margin: 0;
    pointer-events: none;
  }

  :global(html.filter-init) .subsystem-block {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .subsystem-block {
      transition: none !important;
    }
  }

  @media (min-width: 900px) {
    .page-grid {
      grid-template-columns: minmax(260px, 1fr) minmax(0, 3fr);
      gap: 2rem;
    }
    .bento-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.75rem;
      row-gap: 0;
    }
    .commit-stream {
      order: 0;
      border-right: 1px solid var(--color-rule-strong);
      padding-right: 1.5rem;
      position: sticky;
      top: 0.75rem;
      max-height: calc(100vh - 1.5rem);
      overflow-y: auto;
      align-self: start;
    }
    .commit-stream::-webkit-scrollbar { width: 6px; }
    .commit-stream::-webkit-scrollbar-thumb { background: var(--color-rule); }
  }

  @media (min-width: 1200px) {
    .bento-grid {
      grid-template-columns: 1fr 1fr 1fr;
      column-gap: 1.5rem;
    }
  }
</style>
