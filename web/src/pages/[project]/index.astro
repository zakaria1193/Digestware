---
import PublicLayout from '../../layouts/PublicLayout.astro';
import BentoCard from '../../components/BentoCard.astro';
import CommitRow from '../../components/CommitRow.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, getProject } from '../../config/projects';
import { SHOW_IMPACT_SCORE } from '../../config/features';

export async function getStaticPaths() {
  return PROJECTS.map(p => ({ params: { project: p.slug }, props: { projectSlug: p.slug } }));
}

const { projectSlug } = Astro.props as { projectSlug: string };
const project = getProject(projectSlug)!;

// HARD rule: never merge content across projects — filter by `project` field.
const allDiscussions = (await getCollection('discussions', ({ data }) => data.project === projectSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const bySubsystem = new Map<string, typeof allDiscussions>();
for (const d of allDiscussions) {
  const sub = d.data.subsystem;
  if (!bySubsystem.has(sub)) bySubsystem.set(sub, []);
  bySubsystem.get(sub)!.push(d);
}

function clusterGroup(entries: typeof allDiscussions): Map<string, { count: number; show: boolean }> {
  const result = new Map<string, { count: number; show: boolean }>();
  const sevenDays = 7 * 24 * 60 * 60 * 1000;
  const visited = new Set<string>();

  for (const entry of entries) {
    if (visited.has(entry.id)) continue;
    const cluster = [entry];
    visited.add(entry.id);

    for (const other of entries) {
      if (visited.has(other.id)) continue;
      const dateDiff = Math.abs(entry.data.date.getTime() - other.data.date.getTime());
      const sharedTag = (entry.data.tags ?? []).some(t => (other.data.tags ?? []).includes(t));
      if (sharedTag && dateDiff <= sevenDays) {
        cluster.push(other);
        visited.add(other.id);
      }
    }

    cluster.sort((a, b) => {
      const sa = a.data.impact_score ?? a.data.sentiment_score ?? 0;
      const sb = b.data.impact_score ?? b.data.sentiment_score ?? 0;
      return sb - sa;
    });
    result.set(cluster[0].id, { count: cluster.length, show: true });
    for (let i = 1; i < cluster.length; i++) {
      result.set(cluster[i].id, { count: 1, show: false });
    }
  }
  return result;
}

const landings = (await getCollection('landings', ({ data }) => data.project === projectSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const subsystemKeys = [...bySubsystem.keys()].sort((a, b) => {
  const latestA = bySubsystem.get(a)![0]?.data.date.getTime() ?? 0;
  const latestB = bySubsystem.get(b)![0]?.data.date.getTime() ?? 0;
  return latestB - latestA;
});

// Aggregate impact scores per tag across both collections. The full score list
// (not just the count) is shipped to the client so each chip can recompute its
// live count as the impact slider moves — chips with zero items at the current
// threshold get hidden, and categories that empty out collapse with them.
const scoresByTag = new Map<string, number[]>();
const datesByTag = new Map<string, number[]>();
for (const entry of [...allDiscussions, ...landings]) {
  const score = entry.data.impact_score ?? entry.data.sentiment_score ?? -1;
  const ts = entry.data.date.getTime();
  for (const tag of entry.data.tags ?? []) {
    if (!scoresByTag.has(tag)) scoresByTag.set(tag, []);
    scoresByTag.get(tag)!.push(score);
    if (!datesByTag.has(tag)) datesByTag.set(tag, []);
    datesByTag.get(tag)!.push(ts);
  }
}
const rankedTags = [...scoresByTag.entries()]
  .map(([name, scores]) => ({ name, count: scores.length, scores, dates: datesByTag.get(name) ?? [] }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const totalItems = allDiscussions.length + landings.length;

// Tag categories are produced at digest-generation time by
// agents/tag_categorizer.py and written to web/src/data/tag-categories/<project>.json.
// Astro's import.meta.glob inlines the JSON at build time; if the file is
// missing the filter bar degrades gracefully (every chip lands in "Other").
type TagCategoryFile = { assignments: Record<string, string> };
const tagCategoryModules = import.meta.glob<TagCategoryFile>(
  '../../data/tag-categories/*.json',
  { eager: true },
);
const tagCategoryFile = tagCategoryModules[`../../data/tag-categories/${projectSlug}.json`];
const tagAssignments: Record<string, string> = tagCategoryFile?.assignments ?? {};

const CATEGORY_ORDER = ['architectures', 'components', 'topics', 'news', 'other'] as const;
type Category = typeof CATEGORY_ORDER[number];
const CATEGORY_LABELS: Record<Category, string> = {
  architectures: 'Architectures',
  components: 'Components',
  topics: 'Topics',
  news: 'News & Policy',
  other: 'Other',
};

function categoryFor(tag: string): Category {
  const raw = tagAssignments[tag];
  return (CATEGORY_ORDER as readonly string[]).includes(raw) ? (raw as Category) : 'other';
}

type RankedTag = { name: string; count: number; scores: number[]; dates: number[] };
const groupedTags: Array<{ category: Category; tags: RankedTag[] }> = [];
for (const cat of CATEGORY_ORDER) {
  const bucket = rankedTags.filter(t => categoryFor(t.name) === cat);
  if (bucket.length > 0) groupedTags.push({ category: cat, tags: bucket });
}

---

<PublicLayout project={project}>
  <!-- Page-wide filter ribbon: governs both commits and discussions -->
  <section class="filter-bar" aria-label="Digest filters">
    <div class="filter-bar-head">
      <span class="wsj-section-label">Filters</span>
      <span class="wsj-section-rule"></span>
    </div>

    <div class="filter-bar-body" data-impact-hidden={SHOW_IMPACT_SCORE ? undefined : 'true'}>
      <div class="filter-cell filter-cell-impact" style={SHOW_IMPACT_SCORE ? undefined : 'display:none'} aria-hidden={SHOW_IMPACT_SCORE ? undefined : 'true'}>
        <span class="filter-cell-label">Impact</span>
        <div class="filter-cell-control">
          <input type="range" id="impact-filter" min="10" max="100" step="1" value={SHOW_IMPACT_SCORE ? "30" : "10"} aria-label="Minimum impact level" />
          <div class="filter-ticks">
            <span data-stop="1">Lowest</span>
            <span data-stop="2">Low</span>
            <span data-stop="3">Mid</span>
            <span data-stop="4">High</span>
            <span data-stop="5">Highest</span>
          </div>
        </div>
      </div>

      <div class="filter-cell filter-cell-date">
        <span class="filter-cell-label">Date</span>
        <div class="filter-cell-control">
          <div class="date-pills">
            <button type="button" class="date-pill" data-days="" data-active="true">All time</button>
            <button type="button" class="date-pill" data-days="1">Last day</button>
            <button type="button" class="date-pill" data-days="3">Last 3 days</button>
            <button type="button" class="date-pill" data-days="7">Last week</button>
            <button type="button" class="date-pill" data-days="30">Last month</button>
          </div>
        </div>
      </div>

      <div class="filter-cell filter-cell-labels" data-expanded="false">
        <div class="filter-cell-label-row">
          <button
            type="button"
            class="filter-cell-label-eyebrow"
            aria-expanded="false"
            aria-controls="filter-groups"
          >
            <span class="filter-cell-label">Labels</span>
            <span class="filter-cell-chevron" aria-hidden="true">&#9662;</span>
            <span class="filter-cell-meta">
              <span id="filter-visible">{totalItems}</span> of {totalItems}
            </span>
          </button>
          {rankedTags.length > 0 && (
            <div class="filter-toggles">
              <button type="button" class="filter-toggle" data-action="mark-all">Mark&nbsp;All</button>
              <span class="filter-toggle-sep">/</span>
              <button type="button" class="filter-toggle" data-action="unmark-all">Unmark&nbsp;All</button>
            </div>
          )}
        </div>
        {rankedTags.length === 0 && (
          <span class="filter-empty">No labels in the current window.</span>
        )}

        {rankedTags.length > 0 && (
          <div class="filter-groups" id="filter-groups">
            <div class="filter-groups-inner">
              {groupedTags.map(g => (
                <section class="filter-group" data-group={g.category}>
                  <span class="filter-group-label">{CATEGORY_LABELS[g.category]}</span>
                  <div class="filter-group-chips">
                    {g.tags.map(t => (
                      <button
                        type="button"
                        class="chip"
                        data-tag={t.name}
                        data-selected="true"
                        aria-pressed="true"
                        data-scores={t.scores.join(',')}
                        data-dates={t.dates.join(',')}
                      >
                        <span class="chip-name">{t.name}</span>
                        <span class="chip-count">{t.count}</span>
                      </button>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="page-grid">
    <!-- Left: Commit Stream (sidebar) -->
    <aside class="commit-stream" id="stream">
      <div class="stream-sticky-head">
        <div class="stream-head">
          <div class="stream-brand">Latest Commits</div>
          <div class="stream-sub">{landings.length} commit{landings.length !== 1 ? 's' : ''}</div>
        </div>
        <div class="stream-rule"></div>
        <div class="stream-rule-thin"></div>
      </div>

      <div class="stream-list" id="stream-list">
        {landings.length === 0 && (
          <p class="empty-wire">No landed commits in the current window.</p>
        )}
        {landings.map(entry => <CommitRow entry={entry} projectSlug={project.slug} />)}
      </div>
    </aside>

    <!-- Right: Bento Grid -->
    <div class="main-col">
      <div class="wsj-section-head">
        <h2>Ongoing Discussions</h2>
        <span class="wsj-section-rule"></span>
        <span class="wsj-meta">{allDiscussions.length} discussions</span>
      </div>

      {subsystemKeys.length === 0 && (
        <p class="empty">No ongoing discussions in the current window.</p>
      )}

      {subsystemKeys.map(sub => {
        const entries = bySubsystem.get(sub)!;
        const clusterMap = clusterGroup(entries);
        const visibleEntries = entries.filter(e => clusterMap.get(e.id)?.show !== false);
        if (visibleEntries.length === 0) return null;
        return (
          <section class="subsystem-block" data-subsystem-block>
            <div class="subsystem-head">
              <span class="wsj-section-label">{sub}</span>
              <span class="wsj-section-rule"></span>
            </div>
            <div class="bento-grid">
              {visibleEntries.map(entry => (
                <BentoCard entry={entry} projectSlug={project.slug} clusterCount={clusterMap.get(entry.id)?.count ?? 1} />
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>

<script>
  const slider = document.getElementById('impact-filter') as HTMLInputElement;
  const labelsCell = document.querySelector<HTMLElement>('.filter-cell-labels')!;
  const visibleCounter = document.getElementById('filter-visible');

  const datePills = Array.from(document.querySelectorAll<HTMLButtonElement>('.date-pill'));
  let selectedDays: number | null = null;
  const NOW = Date.now();
  const DAY_MS = 86400000;
  // "Last day" (selectedDays === 1) means yesterday only — the digester runs
  // early in the morning, so today's window is empty. Other ranges remain
  // a simple rolling window ending now.
  function dateWindow(): [number, number] {
    if (selectedDays === null) return [-Infinity, Infinity];
    if (selectedDays === 1) return [NOW - 2 * DAY_MS, NOW - DAY_MS];
    return [NOW - selectedDays * DAY_MS, Infinity];
  }

  // Slider values are integers in [10, 100]; the live threshold is value/10
  // so the impact floor moves continuously between 1.0 and 10.0.
  function thresholdFromSlider(value: number): number {
    return value / 10;
  }

  const allChips = Array.from(labelsCell.querySelectorAll<HTMLButtonElement>('.chip'));
  const groups = Array.from(labelsCell.querySelectorAll<HTMLElement>('.filter-group'));
  const wires = Array.from(document.querySelectorAll<HTMLElement>('.wire'));
  const stories = Array.from(document.querySelectorAll<HTMLElement>('.story'));
  const subsystemBlocks = Array.from(
    document.querySelectorAll<HTMLElement>('[data-subsystem-block]')
  );

  // Pre-parse `data-scores` and `data-dates` once; chips never change identity, only visibility.
  const scoresOf = new Map<HTMLButtonElement, number[]>();
  const datesOf = new Map<HTMLButtonElement, number[]>();
  for (const chip of allChips) {
    scoresOf.set(
      chip,
      (chip.dataset.scores ?? '').split(',').filter(Boolean).map(s => parseInt(s)),
    );
    datesOf.set(
      chip,
      (chip.dataset.dates ?? '').split(',').filter(Boolean).map(Number),
    );
  }

  // Story collapse takes 0.36s (see BentoCard.astro `.story` transition).
  // Wait slightly longer before dropping the card from the grid so the
  // animation finishes uninterrupted.
  const HIDE_AFTER_MS = 400;
  const hideTimers = new WeakMap<HTMLElement, number>();

  function setFiltered(el: HTMLElement, filtered: boolean): void {
    const wasFiltered = el.classList.contains('is-filtered');
    el.classList.toggle('is-filtered', filtered);
    el.setAttribute('aria-hidden', filtered ? 'true' : 'false');

    // Bento grid cells (`.story`) must drop out of layout when hidden, not
    // just collapse to zero size — otherwise their reserved slots punch
    // visible holes in the grid (especially featured cards that span 2
    // columns). Other filterable elements (chips, groups, wires, subsystem
    // blocks) live outside the grid and stay animated.
    if (!el.classList.contains('story')) return;
    if (filtered === wasFiltered) return;

    const prev = hideTimers.get(el);
    if (prev !== undefined) {
      clearTimeout(prev);
      hideTimers.delete(el);
    }

    if (filtered) {
      if (document.documentElement.classList.contains('filter-init')) {
        // First paint has transitions suppressed — hide immediately so the
        // grid lays out without the filtered slot from the very first frame.
        el.style.display = 'none';
      } else {
        // Let the collapse animation play, then remove from grid flow.
        const t = setTimeout(() => {
          if (el.classList.contains('is-filtered')) el.style.display = 'none';
          hideTimers.delete(el);
        }, HIDE_AFTER_MS) as unknown as number;
        hideTimers.set(el, t);
      }
    } else {
      el.style.display = '';
    }
  }

  function updateChipsForLevel(min: number, floor: number, ceil: number): HTMLButtonElement[] {
    const visible: HTMLButtonElement[] = [];
    for (const chip of allChips) {
      const scores = scoresOf.get(chip) ?? [];
      const dates = datesOf.get(chip) ?? [];
      const count = scores.reduce((n, s, i) => {
        const d = dates[i] ?? 0;
        return n + ((s < 0 || s >= min) && d >= floor && d <= ceil ? 1 : 0);
      }, 0);
      setFiltered(chip, count === 0);
      const badge = chip.querySelector<HTMLElement>('.chip-count');
      if (badge) badge.textContent = String(count);
      if (count > 0) visible.push(chip);
    }
    for (const group of groups) {
      const anyVisible = !!group.querySelector('.chip:not(.is-filtered)');
      setFiltered(group, !anyVisible);
    }
    return visible;
  }

  function selectedSet(visibleChips: HTMLButtonElement[]): Set<string> {
    const s = new Set<string>();
    for (const c of visibleChips) {
      if (c.dataset.selected === 'true') s.add(c.dataset.tag ?? '');
    }
    return s;
  }

  function passesLabels(
    tagStr: string | undefined,
    selected: Set<string>,
    visibleCount: number,
  ): boolean {
    // All currently-visible chips selected → treat as filter-off so untagged items
    // (and items whose tags are themselves below the impact floor) still show.
    if (visibleCount === 0 || selected.size === visibleCount) return true;
    if (selected.size === 0) return false;
    const tags = (tagStr ?? '').split('|').filter(Boolean);
    for (const t of tags) if (selected.has(t)) return true;
    return false;
  }

  function apply(value: number): number {
    const min = thresholdFromSlider(value);
    const [floor, ceil] = dateWindow();
    const visibleChips = updateChipsForLevel(min, floor, ceil);
    const selected = selectedSet(visibleChips);
    let visible = 0;

    for (const el of [...wires, ...stories]) {
      const score = parseFloat(el.dataset.score ?? '-1');
      const ts = parseFloat(el.dataset.date ?? '0');
      const show = (score < 0 || score >= min) && ts >= floor && ts <= ceil && passesLabels(el.dataset.tags, selected, visibleChips.length);
      setFiltered(el, !show);
      if (show) visible++;
    }
    for (const block of subsystemBlocks) {
      const anyVisible = !!block.querySelector('.story:not(.is-filtered)');
      setFiltered(block, !anyVisible);
    }
    if (visibleCounter) visibleCounter.textContent = String(visible);
    return visible;
  }

  // Track manual slider changes so auto-adjust doesn't override user intent.
  let userAdjusted = false;

  function autoAdjust(): void {
    if (userAdjusted) return;
    let current = parseInt(slider.value);
    let visible = parseInt(visibleCounter?.textContent ?? '0');
    while (visible < 5 && current > 10) {
      current--;
      slider.value = String(current);
      visible = apply(current);
    }
    updateTicks(current);
  }

  // After a manual move that hides everything, give the user 1s of quiet
  // before easing the slider back down to the highest threshold that still
  // shows ≥1 item. Any further input cancels both the wait and the animation.
  let tooHighTimer: ReturnType<typeof setTimeout> | null = null;
  let tooHighRAF: number | null = null;

  function cancelTooHighAdjust(): void {
    if (tooHighTimer !== null) {
      clearTimeout(tooHighTimer);
      tooHighTimer = null;
    }
    if (tooHighRAF !== null) {
      cancelAnimationFrame(tooHighRAF);
      tooHighRAF = null;
    }
  }

  function smoothAdjustToShowSomething(): void {
    const startValue = parseInt(slider.value);
    let target = 10;
    for (let v = startValue - 1; v >= 10; v--) {
      if (apply(v) > 0) {
        target = v;
        break;
      }
    }
    apply(startValue);
    if (target >= startValue) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      slider.value = String(target);
      updateTicks(target);
      apply(target);
      return;
    }

    const duration = 400;
    const startTime = performance.now();
    const step = (now: number) => {
      const elapsed = now - startTime;
      const t = Math.min(1, elapsed / duration);
      const eased = 1 - Math.pow(1 - t, 2);
      const current = Math.round(startValue - (startValue - target) * eased);
      slider.value = String(current);
      updateTicks(current);
      apply(current);
      if (t < 1) {
        tooHighRAF = requestAnimationFrame(step);
      } else {
        tooHighRAF = null;
      }
    };
    tooHighRAF = requestAnimationFrame(step);
  }

  function setVisibleChips(selected: boolean): void {
    for (const c of allChips) {
      if (c.classList.contains('is-filtered')) continue;
      c.dataset.selected = selected ? 'true' : 'false';
      c.setAttribute('aria-pressed', selected ? 'true' : 'false');
    }
  }

  labelsCell.addEventListener('click', (ev) => {
    const target = (ev.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!target) return;

    // If everything is currently selected, the click isolates the clicked
    // chip (unselects all others) instead of just turning it off — that's
    // the "show me only this tag" shortcut from the all-on starting state.
    const visibleChips = allChips.filter(c => !c.classList.contains('is-filtered'));
    const allSelected =
      visibleChips.length > 0 &&
      visibleChips.every(c => c.dataset.selected === 'true');

    if (allSelected) {
      for (const c of visibleChips) {
        const isTarget = c === target;
        c.dataset.selected = isTarget ? 'true' : 'false';
        c.setAttribute('aria-pressed', isTarget ? 'true' : 'false');
      }
    } else {
      const on = target.dataset.selected !== 'true';
      target.dataset.selected = on ? 'true' : 'false';
      target.setAttribute('aria-pressed', on ? 'true' : 'false');

      // Unselecting the last selected chip drops the user into a "nothing
      // visible" trap. Round-trip back to the all-on baseline instead so
      // the next click is meaningful.
      const anySelected = visibleChips.some(c => c.dataset.selected === 'true');
      if (!anySelected) {
        for (const c of visibleChips) {
          c.dataset.selected = 'true';
          c.setAttribute('aria-pressed', 'true');
        }
      }
    }
    apply(parseInt(slider.value));
    autoAdjust();
  });

  document.querySelectorAll<HTMLButtonElement>('.filter-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      setVisibleChips(btn.dataset.action === 'mark-all');
      apply(parseInt(slider.value));
      autoAdjust();
    });
  });

  for (const pill of datePills) {
    pill.addEventListener('click', () => {
      const v = pill.dataset.days ?? '';
      selectedDays = v === '' ? null : parseInt(v);
      for (const p of datePills) p.dataset.active = p === pill ? 'true' : 'false';
      userAdjusted = false;
      apply(parseInt(slider.value));
      autoAdjust();
    });
  }

  const impactCell = document.querySelector<HTMLElement>('.filter-cell-impact')!;
  const ticks = Array.from(document.querySelectorAll<HTMLElement>('.filter-ticks span'));
  // Slider is 10–100; map to 5 equal zones (each 18 wide) → stop label 1–5.
  function stopFromValue(v: number): number {
    return Math.min(5, Math.floor((v - 10) / 18) + 1);
  }
  function updateTicks(sliderValue: number): void {
    const stop = stopFromValue(sliderValue);
    for (const t of ticks) t.dataset.active = t.dataset.stop === String(stop) ? 'true' : 'false';
  }

  slider.addEventListener('input', () => {
    userAdjusted = true;
    cancelTooHighAdjust();
    const level = parseInt(slider.value);
    updateTicks(level);
    const visible = apply(level);
    if (visible === 0) {
      tooHighTimer = setTimeout(() => {
        tooHighTimer = null;
        smoothAdjustToShowSomething();
      }, 1000);
    }
  });
  // Touch drags don't trigger :hover; mark the cell as in-use while the
  // pointer is pressed so the intermediate ticks stay expanded.
  slider.addEventListener('pointerdown', () => { impactCell.dataset.using = 'true'; });
  const clearUsing = () => { impactCell.dataset.using = 'false'; };
  slider.addEventListener('pointerup', clearUsing);
  slider.addEventListener('pointercancel', clearUsing);

  // Labels panel: manual expand/collapse only — never on hover.
  const eyebrow = labelsCell.querySelector<HTMLButtonElement>('.filter-cell-label-eyebrow');
  function setLabelsExpanded(expanded: boolean): void {
    labelsCell.dataset.expanded = expanded ? 'true' : 'false';
    eyebrow?.setAttribute('aria-expanded', expanded ? 'true' : 'false');
  }
  eyebrow?.addEventListener('click', () => {
    setLabelsExpanded(labelsCell.dataset.expanded !== 'true');
  });

  // Suppress the first paint's collapse animation: items below the default
  // threshold would otherwise flash in fully expanded and then animate down.
  document.documentElement.classList.add('filter-init');
  apply(parseInt(slider.value));
  updateTicks(parseInt(slider.value));
  const anyWireVisible = wires.some(w => !w.classList.contains('is-filtered'));
  if (!anyWireVisible && wires.length > 0) {
    slider.value = '10';
    apply(10);
    updateTicks(parseInt(slider.value));
  }
  autoAdjust();
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      document.documentElement.classList.remove('filter-init');
    });
  });

  // Carry the current filter state to landing (commit detail) pages so the
  // sidebar filter selection is not lost when clicking a commit from here.
  function buildLandingQueryString(): string {
    const params = new URLSearchParams();
    const iv = parseInt(slider.value);
    if (iv !== 10) params.set('i', String(iv));
    const visibleChips = allChips.filter(c => !c.classList.contains('is-filtered'));
    const allSelected = visibleChips.every(c => c.dataset.selected === 'true');
    if (!allSelected) {
      const selected = visibleChips
        .filter(c => c.dataset.selected === 'true')
        .map(c => c.dataset.tag ?? '');
      if (selected.length) params.set('t', selected.join('|'));
    }
    if (selectedDays !== null) {
      const dMap: Record<number, string> = { 1: 'lastday', 3: '3d', 7: '7d', 30: '30d' };
      if (dMap[selectedDays]) params.set('d', dMap[selectedDays]);
    }
    return params.toString();
  }

  document.querySelector('.commit-stream')?.addEventListener('click', ev => {
    const link = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!link) return;
    const qs = buildLandingQueryString();
    if (!qs) return;
    ev.preventDefault();
    window.location.href = link.href.split('?')[0] + '?' + qs;
  });
</script>

