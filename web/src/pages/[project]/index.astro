---
import PublicLayout from '../../layouts/PublicLayout.astro';
import BentoCard from '../../components/BentoCard.astro';
import CommitRow from '../../components/CommitRow.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, getProject } from '../../config/projects';

export async function getStaticPaths() {
  return PROJECTS.map(p => ({ params: { project: p.slug }, props: { projectSlug: p.slug } }));
}

const { projectSlug } = Astro.props as { projectSlug: string };
const project = getProject(projectSlug)!;

// HARD rule: never merge content across projects — filter by `project` field.
const allDiscussions = (await getCollection('discussions', ({ data }) => data.project === projectSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const bySubsystem = new Map<string, typeof allDiscussions>();
for (const d of allDiscussions) {
  const sub = d.data.subsystem;
  if (!bySubsystem.has(sub)) bySubsystem.set(sub, []);
  bySubsystem.get(sub)!.push(d);
}

function clusterGroup(entries: typeof allDiscussions): Map<string, { count: number; show: boolean }> {
  const result = new Map<string, { count: number; show: boolean }>();
  const sevenDays = 7 * 24 * 60 * 60 * 1000;
  const visited = new Set<string>();

  for (const entry of entries) {
    if (visited.has(entry.id)) continue;
    const cluster = [entry];
    visited.add(entry.id);

    for (const other of entries) {
      if (visited.has(other.id)) continue;
      const dateDiff = Math.abs(entry.data.date.getTime() - other.data.date.getTime());
      const sharedTag = (entry.data.tags ?? []).some(t => (other.data.tags ?? []).includes(t));
      if (sharedTag && dateDiff <= sevenDays) {
        cluster.push(other);
        visited.add(other.id);
      }
    }

    cluster.sort((a, b) => {
      const sa = a.data.impact_score ?? a.data.sentiment_score ?? 0;
      const sb = b.data.impact_score ?? b.data.sentiment_score ?? 0;
      return sb - sa;
    });
    result.set(cluster[0].id, { count: cluster.length, show: true });
    for (let i = 1; i < cluster.length; i++) {
      result.set(cluster[i].id, { count: 1, show: false });
    }
  }
  return result;
}

const landings = (await getCollection('landings', ({ data }) => data.project === projectSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const subsystemKeys = [...bySubsystem.keys()].sort((a, b) => {
  const latestA = bySubsystem.get(a)![0]?.data.date.getTime() ?? 0;
  const latestB = bySubsystem.get(b)![0]?.data.date.getTime() ?? 0;
  return latestB - latestA;
});

// Aggregate tag frequencies across both collections, rank by frequency.
const tagCounts = new Map<string, number>();
for (const entry of [...allDiscussions, ...landings]) {
  for (const tag of entry.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const rankedTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name, count]) => ({ name, count }));
const TOP_N = 6;
const topTags = rankedTags.slice(0, TOP_N);
const moreTags = rankedTags.slice(TOP_N);
const totalItems = allDiscussions.length + landings.length;

// Tag categories are produced at digest-generation time by
// agents/tag_categorizer.py and written to web/src/data/tag-categories/<project>.json.
// Astro's import.meta.glob inlines the JSON at build time; if the file is
// missing the filter bar degrades gracefully (every chip lands in "Other").
type TagCategoryFile = { assignments: Record<string, string> };
const tagCategoryModules = import.meta.glob<TagCategoryFile>(
  '../../data/tag-categories/*.json',
  { eager: true },
);
const tagCategoryFile = tagCategoryModules[`../../data/tag-categories/${projectSlug}.json`];
const tagAssignments: Record<string, string> = tagCategoryFile?.assignments ?? {};

const CATEGORY_ORDER = ['architectures', 'components', 'topics', 'news', 'other'] as const;
type Category = typeof CATEGORY_ORDER[number];
const CATEGORY_LABELS: Record<Category, string> = {
  architectures: 'Architectures',
  components: 'Components',
  topics: 'Topics',
  news: 'News & Policy',
  other: 'Other',
};

function categoryFor(tag: string): Category {
  const raw = tagAssignments[tag];
  return (CATEGORY_ORDER as readonly string[]).includes(raw) ? (raw as Category) : 'other';
}

type RankedTag = { name: string; count: number };
const groupedMoreTags: Array<{ category: Category; tags: RankedTag[] }> = [];
for (const cat of CATEGORY_ORDER) {
  const bucket = moreTags.filter(t => categoryFor(t.name) === cat);
  if (bucket.length > 0) groupedMoreTags.push({ category: cat, tags: bucket });
}

---

<PublicLayout project={project}>
  <!-- Page-wide filter ribbon: governs both commits and discussions -->
  <section class="filter-bar" aria-label="Digest filters">
    <div class="filter-bar-head">
      <span class="wsj-section-label">Filters</span>
      <span class="wsj-section-rule"></span>
      <span class="wsj-meta"><span id="filter-visible">{totalItems}</span> of {totalItems}</span>
    </div>

    <div class="filter-bar-body">
      <div class="filter-cell filter-cell-impact">
        <span class="filter-cell-label">Impact</span>
        <div class="filter-cell-control">
          <input type="range" id="impact-filter" min="1" max="3" step="1" value="2" aria-label="Minimum impact level" />
          <div class="filter-ticks">
            <span>Low</span>
            <span>Avg</span>
            <span>High</span>
          </div>
        </div>
      </div>

      <div class="filter-cell filter-cell-labels">
        <div class="filter-cell-label-row">
          <span class="filter-cell-label">Labels</span>
          {rankedTags.length > 0 && (
            <div class="filter-toggles">
              <button type="button" class="filter-toggle" data-action="mark-all">Mark&nbsp;All</button>
              <span class="filter-toggle-sep">/</span>
              <button type="button" class="filter-toggle" data-action="unmark-all">Unmark&nbsp;All</button>
            </div>
          )}
        </div>
        <div class="filter-chips" id="filter-chips">
          {rankedTags.length === 0 && (
            <span class="filter-empty">No labels in the current window.</span>
          )}
          {topTags.map(t => (
            <button type="button" class="chip" data-tag={t.name} data-selected="true" aria-pressed="true">
              <span class="chip-name">{t.name}</span>
              <span class="chip-count">{t.count}</span>
            </button>
          ))}
          {moreTags.length > 0 && (
            <button type="button" class="filter-show-all" id="filter-show-all" aria-expanded="false">
              Show&nbsp;all&nbsp;<span class="chip-count">+{moreTags.length}</span>
            </button>
          )}
        </div>

        {moreTags.length > 0 && (
          <div class="filter-groups" id="filter-groups" hidden>
            {groupedMoreTags.map(g => (
              <section class="filter-group" data-group={g.category}>
                <span class="filter-group-label">{CATEGORY_LABELS[g.category]}</span>
                <div class="filter-group-chips">
                  {g.tags.map(t => (
                    <button type="button" class="chip chip-extra" data-tag={t.name} data-selected="true" aria-pressed="true">
                      <span class="chip-name">{t.name}</span>
                      <span class="chip-count">{t.count}</span>
                    </button>
                  ))}
                </div>
              </section>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="page-grid">
    <!-- Left: Commit Stream (sidebar) -->
    <aside class="commit-stream" id="stream">
      <div class="stream-head">
        <div class="stream-brand">Latest&nbsp;Merges</div>
        <div class="stream-sub">Fresh commits, on the hour</div>
      </div>
      <div class="stream-rule"></div>
      <div class="stream-rule-thin"></div>

      <div class="stream-list" id="stream-list">
        {landings.length === 0 && (
          <p class="empty-wire">No landed commits in the current window.</p>
        )}
        {landings.map(entry => <CommitRow entry={entry} projectSlug={project.slug} />)}
      </div>
    </aside>

    <!-- Right: Bento Grid -->
    <div class="main-col">
      <div class="wsj-section-head">
        <h2>Today&rsquo;s Digest</h2>
        <span class="wsj-section-rule"></span>
        <span class="wsj-meta">{allDiscussions.length} discussions</span>
      </div>

      {subsystemKeys.length === 0 && (
        <p class="empty">No discussions in the current digest window.</p>
      )}

      {subsystemKeys.map(sub => {
        const entries = bySubsystem.get(sub)!;
        const clusterMap = clusterGroup(entries);
        const visibleEntries = entries.filter(e => clusterMap.get(e.id)?.show !== false);
        if (visibleEntries.length === 0) return null;
        return (
          <section class="subsystem-block" data-subsystem-block>
            <div class="subsystem-head">
              <span class="wsj-section-label">{sub}</span>
              <span class="wsj-section-rule"></span>
            </div>
            <div class="bento-grid">
              {visibleEntries.map(entry => (
                <BentoCard entry={entry} projectSlug={project.slug} clusterCount={clusterMap.get(entry.id)?.count ?? 1} />
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </div>

<script>
  const slider = document.getElementById('impact-filter') as HTMLInputElement;
  const labelsCell = document.querySelector<HTMLElement>('.filter-cell-labels')!;
  const groupsWrapper = document.getElementById('filter-groups') as HTMLElement | null;
  const showAllBtn = document.getElementById('filter-show-all') as HTMLButtonElement | null;
  const visibleCounter = document.getElementById('filter-visible');
  const thresholds = [0, 4, 8];

  const chips = Array.from(labelsCell.querySelectorAll<HTMLButtonElement>('.chip'));
  const allTagsCount = chips.length;
  const wires = Array.from(document.querySelectorAll<HTMLElement>('.wire'));
  const stories = Array.from(document.querySelectorAll<HTMLElement>('.story'));
  const subsystemBlocks = Array.from(
    document.querySelectorAll<HTMLElement>('[data-subsystem-block]')
  );

  function selectedSet(): Set<string> {
    const s = new Set<string>();
    for (const c of chips) {
      if (c.dataset.selected === 'true') s.add(c.dataset.tag ?? '');
    }
    return s;
  }

  function passesLabels(tagStr: string | undefined, selected: Set<string>): boolean {
    // "Mark All" (every chip selected) is treated as filter-off so no-tag items show too.
    if (allTagsCount === 0 || selected.size === allTagsCount) return true;
    if (selected.size === 0) return false;
    const tags = (tagStr ?? '').split('|').filter(Boolean);
    for (const t of tags) if (selected.has(t)) return true;
    return false;
  }

  function apply(level: number): void {
    const min = thresholds[Math.max(0, Math.min(2, level - 1))];
    const selected = selectedSet();
    let visible = 0;

    for (const el of wires) {
      const score = parseInt(el.dataset.score ?? '0');
      const show = score >= min && passesLabels(el.dataset.tags, selected);
      el.hidden = !show;
      if (show) visible++;
    }
    for (const el of stories) {
      const score = parseInt(el.dataset.score ?? '0');
      const show = score >= min && passesLabels(el.dataset.tags, selected);
      el.hidden = !show;
      if (show) visible++;
    }
    for (const block of subsystemBlocks) {
      const anyVisible = block.querySelector('.story:not([hidden])');
      block.hidden = !anyVisible;
    }
    if (visibleCounter) visibleCounter.textContent = String(visible);
  }

  function setAllChips(selected: boolean): void {
    for (const c of chips) {
      c.dataset.selected = selected ? 'true' : 'false';
      c.setAttribute('aria-pressed', selected ? 'true' : 'false');
    }
  }

  // Chip click → toggle individual label (delegated across the whole Labels cell
  // so it catches chips inside the collapsible category groups too)
  labelsCell.addEventListener('click', (ev) => {
    const target = (ev.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!target) return;
    const on = target.dataset.selected !== 'true';
    target.dataset.selected = on ? 'true' : 'false';
    target.setAttribute('aria-pressed', on ? 'true' : 'false');
    apply(parseInt(slider.value));
  });

  // Mark All / Unmark All
  document.querySelectorAll<HTMLButtonElement>('.filter-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      setAllChips(btn.dataset.action === 'mark-all');
      apply(parseInt(slider.value));
    });
  });

  // Show All / Show Less — toggle the whole groups wrapper (chips inside stay
  // in the DOM so they still contribute to selectedSet()/passesLabels()).
  if (showAllBtn && groupsWrapper) {
    const extraCount = groupsWrapper.querySelectorAll<HTMLElement>('.chip-extra').length;
    showAllBtn.addEventListener('click', () => {
      const expanded = showAllBtn.getAttribute('aria-expanded') === 'true';
      groupsWrapper.hidden = expanded;
      showAllBtn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      showAllBtn.innerHTML = expanded
        ? `Show&nbsp;all&nbsp;<span class="chip-count">+${extraCount}</span>`
        : `Show&nbsp;less`;
    });
  }

  slider.addEventListener('input', () => apply(parseInt(slider.value)));

  // Default to Avg; fall back to Low if it would show nothing in the commit stream.
  apply(2);
  const anyWireVisible = wires.some(w => !w.hidden);
  if (!anyWireVisible && wires.length > 0) {
    slider.value = '1';
    apply(1);
  }
</script>

</PublicLayout>

<style>
  .page-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .main-col { min-width: 0; }

  .empty, .empty-wire {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-muted);
    padding: 1rem 0;
  }
  .empty-wire { font-size: 0.85rem; }

  .subsystem-block { margin-bottom: 2rem; }
  .subsystem-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .commit-stream {
    font-family: var(--font-serif);
    padding-top: 0.25rem;
  }

  .stream-head { text-align: center; padding-bottom: 0.15rem; }
  .stream-brand {
    font-family: var(--font-serif-display);
    font-weight: 900;
    font-size: 1.9rem;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .stream-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.78rem;
    color: var(--color-muted);
    margin-top: 0.15rem;
  }
  .stream-rule {
    border-top: 3px double var(--color-rule-strong);
    margin-top: 0.5rem;
  }
  .stream-rule-thin {
    border-top: 1px solid var(--color-rule-strong);
    margin-top: 2px;
    margin-bottom: 0.5rem;
  }

  .stream-list { display: flex; flex-direction: column; }

  /* ---------- Unified filter ribbon (spans both columns) ---------- */
  .filter-bar {
    margin: 0 0 1.4rem;
    padding: 0.1rem 0 0.9rem;
    border-top: 3px double var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .filter-bar-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0 0.6rem;
  }
  .filter-bar-head .wsj-meta {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .filter-bar-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem 2rem;
    align-items: start;
  }

  .filter-cell-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .filter-cell-impact {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 0.9rem;
    align-items: center;
  }
  .filter-cell-impact .filter-cell-control {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  #impact-filter {
    width: 100%;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .filter-ticks {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .filter-cell-labels {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }
  .filter-cell-label-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .filter-toggles {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .filter-toggle {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .filter-toggle:hover { color: var(--color-accent); }
  .filter-toggle-sep {
    color: var(--color-rule);
    font-family: var(--font-sans);
    font-size: 0.58rem;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    align-items: baseline;
  }
  .filter-empty {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .chip {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: transparent;
    border: 0;
    padding: 0.1rem 0 0.18rem;
    cursor: pointer;
    border-bottom: 2px solid var(--color-accent);
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    transition: opacity 0.12s ease, color 0.12s ease;
  }
  .chip:hover { opacity: 0.72; }
  .chip[data-selected="false"] {
    color: var(--color-muted);
    border-bottom-color: var(--color-rule);
    border-bottom-style: dotted;
    opacity: 0.55;
  }
  .chip[data-selected="false"] .chip-name {
    text-decoration: line-through;
    text-decoration-color: var(--color-rule);
  }
  .chip-count {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-muted);
  }

  .filter-show-all {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: transparent;
    border: 0;
    padding: 0.1rem 0 0.18rem;
    cursor: pointer;
    border-bottom: 1px solid var(--color-accent);
  }
  .filter-show-all:hover { opacity: 0.75; }

  /* Expanded overflow chips, grouped by taxonomy category */
  .filter-groups {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.55rem;
    padding-top: 0.5rem;
    border-top: 1px dotted var(--color-rule);
  }
  .filter-group {
    display: grid;
    grid-template-columns: minmax(7.5rem, auto) 1fr;
    gap: 0.3rem 0.9rem;
    align-items: baseline;
  }
  .filter-group-label {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding-top: 0.18rem;
    border-right: 1px solid var(--color-rule);
    padding-right: 0.75rem;
    text-align: right;
  }
  .filter-group-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    align-items: baseline;
  }
  @media (max-width: 700px) {
    .filter-group { grid-template-columns: 1fr; }
    .filter-group-label {
      border-right: 0;
      border-bottom: 1px solid var(--color-rule);
      padding: 0 0 0.2rem;
      text-align: left;
    }
  }

  @media (min-width: 900px) {
    .filter-bar-body {
      grid-template-columns: minmax(220px, 1fr) minmax(0, 3fr);
    }
  }

  @media (min-width: 900px) {
    .page-grid {
      grid-template-columns: minmax(260px, 1fr) minmax(0, 3fr);
      gap: 2rem;
    }
    .bento-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.75rem;
      row-gap: 0;
    }
    .commit-stream {
      border-right: 1px solid var(--color-rule-strong);
      padding-right: 1.5rem;
      position: sticky;
      top: 0.75rem;
      max-height: calc(100vh - 1.5rem);
      overflow-y: auto;
      align-self: start;
    }
    .commit-stream::-webkit-scrollbar { width: 6px; }
    .commit-stream::-webkit-scrollbar-thumb { background: var(--color-rule); }
  }

  @media (min-width: 1200px) {
    .bento-grid {
      grid-template-columns: 1fr 1fr 1fr;
      column-gap: 1.5rem;
    }
  }
</style>
