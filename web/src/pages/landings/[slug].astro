---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('landings');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await entry.render();

const all = (await getCollection('landings'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex(e => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const impactColor = (d.impact_score ?? 0) >= 9
  ? '#d97706'
  : (d.impact_score ?? 0) >= 7
  ? '#2563eb'
  : '#6b7280';

const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<PublicLayout title={d.headline} description={d.tldr}>
  <article class="detail-page">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span class="sub">{d.subsystem}</span>
    </nav>

    <header class="article-header">
      <div class="meta-top">
        <span class="subsystem-label">{d.subsystem}</span>
        {(d.impact_score != null) && (
          <span class="impact-badge" style={`color: ${impactColor}; border-color: ${impactColor}40;`}>
            Impact {d.impact_score}/10
          </span>
        )}
        {d.performance_win && (
          <span class="badge perf">⚡ Perf win</span>
        )}
        {d.breaking_change && (
          <span class="badge breaking">⚠ Breaking</span>
        )}
      </div>
      <h1 class="headline">{d.headline}</h1>
      <p class="tldr">{d.tldr}</p>
      <div class="meta-bottom">
        <time class="date">{dateStr}</time>
        {d.author && <span class="separator">·</span>}
        {d.author && <span class="author">{d.author}</span>}
        {d.outcome && <span class="separator">·</span>}
        {d.outcome && <span class="outcome">{d.outcome.replace(/_/g, ' ')}</span>}
      </div>
    </header>

    {d.why_it_matters && (
      <div class="stakes-block">
        <strong>Why it matters:</strong> {d.why_it_matters}
      </div>
    )}

    {d.impact_rationale && (
      <div class="rationale-block">
        <strong>Impact rationale:</strong> {d.impact_rationale}
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {(d.series_parts ?? []).length > 0 && (
      <section class="series-block">
        <h2>Part of a series</h2>
        <ul>
          {d.series_parts!.map(p => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {(d.tags ?? []).length > 0 && (
      <div class="tags">
        {d.tags!.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="source-link">
      <a href={d.url} target="_blank" rel="noopener">View commit →</a>
    </div>

    <nav class="prevnext">
      {next && (
        <a href={`/landings/${next.id}`} class="prev-link">
          <span class="nav-label">← Older</span>
          <span class="nav-title">{next.data.headline}</span>
        </a>
      )}
      {prev && (
        <a href={`/landings/${prev.id}`} class="next-link">
          <span class="nav-label">Newer →</span>
          <span class="nav-title">{prev.data.headline}</span>
        </a>
      )}
    </nav>
  </article>
</PublicLayout>

<style>
  .detail-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem;
  }

  .breadcrumb {
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    color: #555555;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .breadcrumb a { color: #555555; text-decoration: none; }
  .breadcrumb a:hover { color: #111111; }
  .breadcrumb .sub {
    color: #b8860b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-header { margin-bottom: 1.5rem; }

  .meta-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .subsystem-label {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b8860b;
  }

  .impact-badge {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid;
    border-radius: 2px;
    font-weight: 600;
  }

  .badge {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    border: 1px solid;
  }

  .badge.perf { color: #059669; border-color: #05966940; background: #ecfdf5; }
  .badge.breaking { color: #dc2626; border-color: #dc262640; background: #fef2f2; }

  .headline {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    color: #111111;
  }

  .tldr {
    font-family: system-ui, sans-serif;
    font-size: 1rem;
    color: #555555;
    line-height: 1.55;
    margin: 0 0 0.75rem;
    font-style: italic;
  }

  .meta-bottom {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    color: #555555;
    flex-wrap: wrap;
  }

  .separator { color: #dddddd; }

  .stakes-block, .rationale-block {
    border-left: 3px solid #b8860b;
    padding: 0.75rem 1rem;
    font-family: system-ui, sans-serif;
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 1rem;
    border-radius: 0 2px 2px 0;
  }

  .stakes-block { background: #fefce8; }
  .rationale-block { background: #f9fafb; border-color: #9ca3af; }

  .prose {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    line-height: 1.7;
    color: #111111;
    border-top: 1px solid #dddddd;
    padding-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(a) { color: #b8860b; }

  .series-block {
    margin-bottom: 1.5rem;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
  }

  .series-block h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .series-block ul { margin: 0; padding-left: 1.25rem; line-height: 1.6; }
  .series-block a { color: #b8860b; }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    color: #b8860b;
    padding: 0.2rem 0.5rem;
    border: 1px solid #e6c94a40;
    background: #fefce8;
    border-radius: 2px;
  }

  .source-link {
    border-top: 1px solid #dddddd;
    padding-top: 1rem;
    margin-bottom: 2rem;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
  }

  .source-link a { color: #b8860b; text-decoration: none; }

  .prevnext {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid #dddddd;
    padding-top: 1.5rem;
  }

  .prev-link, .next-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    max-width: 45%;
  }

  .next-link { text-align: right; margin-left: auto; }

  .nav-label {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    color: #555555;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nav-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.9rem;
    color: #111111;
    line-height: 1.3;
  }

  .prev-link:hover .nav-title, .next-link:hover .nav-title { color: #b8860b; }
</style>
