---
// Root path redirects to the default project (`/<project>/`) on the shared
// origin.
import { DEFAULT_PROJECT, getProject, absoluteUrl } from '../config/projects';
const target = `/${DEFAULT_PROJECT}/`;
const canonicalUrl = absoluteUrl(getProject(DEFAULT_PROJECT)!, target);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>&hellip;</p>
    <script is:inline set:html={`window.location.replace(${JSON.stringify(target)});`}></script>
  </body>
</html>
