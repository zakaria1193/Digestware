---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('discussions');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await entry.render();

// Prev / next within collection sorted by date
const all = (await getCollection('discussions'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const idx = all.findIndex(e => e.id === entry.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const outcomeColors: Record<string, string> = {
  committed: '#16a34a',
  ready: '#2563eb',
  under_review: '#d97706',
  needs_revision: '#dc2626',
  nackd: '#dc2626',
  proposed: '#6b7280',
  stalled: '#9ca3af',
  withdrawn: '#9ca3af',
};
const outcomeColor = outcomeColors[d.outcome ?? 'proposed'] ?? '#6b7280';
const outcomeLabel = (d.outcome ?? 'proposed').replace(/_/g, ' ');
const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<PublicLayout title={d.headline} description={d.tldr}>
  <article class="detail-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span class="sub">{d.subsystem}</span>
    </nav>

    <!-- Header -->
    <header class="article-header">
      <div class="meta-top">
        <span class="subsystem-label">{d.subsystem}</span>
        <span class="outcome-badge" style={`color: ${outcomeColor}; border-color: ${outcomeColor}40;`}>
          <span class="dot" style={`background: ${outcomeColor};`}></span>
          {outcomeLabel}
        </span>
      </div>
      <h1 class="headline">{d.headline}</h1>
      <p class="tldr">{d.tldr}</p>
      <div class="meta-bottom">
        <time class="date">{dateStr}</time>
        {d.proposer && <span class="separator">·</span>}
        {d.proposer && <span class="author">{d.proposer}</span>}
        {(d.sentiment_score != null) && <span class="separator">·</span>}
        {(d.sentiment_score != null) && (
          <span class="score">Sentiment {d.sentiment_score}/10</span>
        )}
      </div>
    </header>

    <!-- Stakes / why it matters -->
    {d.stakes && (
      <div class="stakes-block">
        <strong>Why it matters:</strong> {d.stakes}
      </div>
    )}

    <!-- Body -->
    <div class="prose">
      <Content />
    </div>

    <!-- Technical tradeoffs -->
    {(d.technical_tradeoffs ?? []).length > 0 && (
      <section class="tradeoffs">
        <h2>Technical tradeoffs</h2>
        <ul>
          {d.technical_tradeoffs!.map(t => <li>{t}</li>)}
        </ul>
      </section>
    )}

    <!-- Series parts -->
    {(d.series_parts ?? []).length > 0 && (
      <section class="series-block">
        <h2>Part of a series</h2>
        <ul>
          {d.series_parts!.map(p => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <!-- Tags -->
    {(d.tags ?? []).length > 0 && (
      <div class="tags">
        {d.tags!.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <!-- Source link -->
    <div class="source-link">
      <a href={d.url} target="_blank" rel="noopener">View original source →</a>
    </div>

    <!-- Prev / Next -->
    <nav class="prevnext">
      {next && (
        <a href={`/discussions/${next.id}`} class="prev-link">
          <span class="nav-label">← Older</span>
          <span class="nav-title">{next.data.headline}</span>
        </a>
      )}
      {prev && (
        <a href={`/discussions/${prev.id}`} class="next-link">
          <span class="nav-label">Newer →</span>
          <span class="nav-title">{prev.data.headline}</span>
        </a>
      )}
    </nav>
  </article>
</PublicLayout>

<style>
  .detail-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem;
  }

  .breadcrumb {
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    color: #555555;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: #555555;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #111111;
  }

  .breadcrumb .sub {
    color: #b8860b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-header {
    margin-bottom: 1.5rem;
  }

  .meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .subsystem-label {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b8860b;
  }

  .outcome-badge {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid;
    border-radius: 2px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .headline {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    color: #111111;
  }

  .tldr {
    font-family: system-ui, sans-serif;
    font-size: 1rem;
    color: #555555;
    line-height: 1.55;
    margin: 0 0 0.75rem;
    font-style: italic;
  }

  .meta-bottom {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    color: #555555;
    flex-wrap: wrap;
  }

  .separator { color: #dddddd; }

  .stakes-block {
    background: #fefce8;
    border-left: 3px solid #b8860b;
    padding: 0.75rem 1rem;
    font-family: system-ui, sans-serif;
    font-size: 0.88rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
    border-radius: 0 2px 2px 0;
  }

  .prose {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    line-height: 1.7;
    color: #111111;
    border-top: 1px solid #dddddd;
    padding-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(a) { color: #b8860b; }

  .tradeoffs, .series-block {
    margin-bottom: 1.5rem;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
  }

  .tradeoffs h2, .series-block h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: #111111;
  }

  .tradeoffs ul, .series-block ul {
    margin: 0;
    padding-left: 1.25rem;
    color: #333333;
    line-height: 1.6;
  }

  .series-block a { color: #b8860b; }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    color: #b8860b;
    padding: 0.2rem 0.5rem;
    border: 1px solid #e6c94a40;
    background: #fefce8;
    border-radius: 2px;
  }

  .source-link {
    border-top: 1px solid #dddddd;
    padding-top: 1rem;
    margin-bottom: 2rem;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
  }

  .source-link a {
    color: #b8860b;
    text-decoration: none;
  }

  .prevnext {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid #dddddd;
    padding-top: 1.5rem;
  }

  .prev-link, .next-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    max-width: 45%;
  }

  .next-link {
    text-align: right;
    margin-left: auto;
  }

  .nav-label {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    color: #555555;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nav-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.9rem;
    color: #111111;
    line-height: 1.3;
  }

  .prev-link:hover .nav-title, .next-link:hover .nav-title {
    color: #b8860b;
  }
</style>
