---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const discussions = await getCollection('discussions');
  return discussions.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const isUrl = (v: unknown): v is string =>
  typeof v === 'string' && /^https?:\/\//.test(v);

const attributes: Array<[string, unknown]> = [
  ['project', d.project],
  ['subsystem', d.subsystem],
  ['patch_id', d.patch_id],
  ['discussion_id', d.discussion_id],
  ['source_type', d.source_type],
  ['title', d.title],
  ['headline', d.headline],
  ['tldr', d.tldr],
  ['stakes', d.stakes],
  ['proposer', d.proposer],
  ['consensus', d.consensus],
  ['outcome', d.outcome],
  ['sentiment_score', d.sentiment_score],
  ['sentiment_rationale', d.sentiment_rationale],
  ['series_id', d.series_id],
  ['series_role', d.series_role],
  ['series_parts', d.series_parts],
  ['tags', d.tags],
  ['url', d.url],
  ['bugzilla_url', d.bugzilla_url],
  ['date', d.date],
];
---

<AdminLayout title={d.title} section="discussions">
  <div class="mb-4">
    <a href="/admin/discussions" class="text-xs text-zinc-500 hover:text-zinc-300">← All discussions</a>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 space-y-3 text-sm">
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Project / Subsystem</p>
          <p class="font-mono">{d.project} / {d.subsystem}</p>
        </div>
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Date</p>
          <p class="font-mono">{d.date.toISOString().slice(0, 10)}</p>
        </div>
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Proposer</p>
          <p class="text-xs break-words">{d.proposer ?? '—'}</p>
        </div>
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Source type</p>
          <p>{d.source_type}</p>
        </div>
        <div class="flex gap-6">
          <div>
            <p class="text-xs text-zinc-500 mb-0.5">Consensus</p>
            <p class={`font-semibold ${
              d.consensus === 'Accepted' ? 'text-emerald-400' :
              d.consensus === 'Rejected' ? 'text-red-400' : 'text-zinc-400'
            }`}>{d.consensus ?? '—'}</p>
          </div>
          <div>
            <p class="text-xs text-zinc-500 mb-0.5">Sentiment</p>
            <p class={`text-xl font-bold ${
              (d.sentiment_score ?? 5) >= 7 ? 'text-emerald-400' :
              (d.sentiment_score ?? 5) <= 3 ? 'text-red-400' : 'text-zinc-400'
            }`}>{d.sentiment_score ?? '—'}<span class="text-xs text-zinc-500">/10</span></p>
          </div>
        </div>
        {d.url && (
          <div>
            <a href={d.url} target="_blank" rel="noopener noreferrer"
               class="text-xs text-amber-400 hover:text-amber-300 break-all">
              View thread →
            </a>
          </div>
        )}
        {d.bugzilla_url && (
          <div>
            <a href={d.bugzilla_url} target="_blank" rel="noopener noreferrer"
               class="text-xs text-blue-400 hover:text-blue-300 break-all">
              Bugzilla →
            </a>
          </div>
        )}
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 text-sm">
        <p class="text-xs text-zinc-500 mb-2 uppercase tracking-wide">All attributes</p>
        <dl class="space-y-2">
          {attributes.map(([key, value]) => (
            <div>
              <dt class="text-[11px] text-zinc-500 font-mono">{key}</dt>
              <dd class="text-xs text-zinc-200 break-words">
                {value === null || value === undefined || value === '' ? (
                  <span class="text-zinc-600">—</span>
                ) : value instanceof Date ? (
                  <span class="font-mono">{value.toISOString()}</span>
                ) : typeof value === 'boolean' ? (
                  <span class={value ? 'text-emerald-400' : 'text-zinc-500'}>{String(value)}</span>
                ) : Array.isArray(value) ? (
                  value.length === 0 ? (
                    <span class="text-zinc-600">[]</span>
                  ) : (
                    <ul class="space-y-1 mt-0.5">
                      {value.map(item => (
                        <li class="flex gap-1.5">
                          <span class="text-zinc-600 shrink-0">•</span>
                          {typeof item === 'object' && item !== null ? (
                            <span class="font-mono text-[11px] break-all">{JSON.stringify(item)}</span>
                          ) : (
                            <span class="break-words">{String(item)}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )
                ) : isUrl(value) ? (
                  <a href={value} target="_blank" rel="noopener noreferrer"
                     class="text-amber-400 hover:text-amber-300 break-all">{value}</a>
                ) : (
                  <span class="break-words">{String(value)}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="lg:col-span-2">
      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6 prose prose-invert prose-sm max-w-none">
        <h1 class="text-base font-semibold text-zinc-100 not-prose mb-4">{d.title}</h1>
        <Content />
      </div>
    </div>
  </div>
</AdminLayout>
