---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const discussions = await getCollection('discussions');
  return discussions.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const isUrl = (v: unknown): v is string =>
  typeof v === 'string' && /^https?:\/\//.test(v);

const attributes: Array<[string, unknown]> = [
  ['project', d.project],
  ['subsystem', d.subsystem],
  ['patch_id', d.patch_id],
  ['discussion_id', d.discussion_id],
  ['source_type', d.source_type],
  ['title', d.title],
  ['headline', d.headline],
  ['tldr', d.tldr],
  ['stakes', d.stakes],
  ['proposer', d.proposer],
  ['consensus', d.consensus],
  ['outcome', d.outcome],
  ['sentiment_score', d.sentiment_score],
  ['sentiment_rationale', d.sentiment_rationale],
  ['technical_tradeoffs', d.technical_tradeoffs],
  ['series_id', d.series_id],
  ['series_role', d.series_role],
  ['series_parts', d.series_parts],
  ['tags', d.tags],
  ['url', d.url],
  ['bugzilla_url', d.bugzilla_url],
  ['date', d.date],
];
---

<AdminLayout title={d.title} section="discussions">
  <style>
    .admin-card {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      padding: 1rem;
    }
    .admin-card p {
      color: var(--color-ink);
    }
    .admin-card .label {
      font-size: 0.75rem;
      color: var(--color-muted);
      margin-bottom: 0.125rem;
    }
    .content-prose {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      padding: 1.5rem;
    }
    .content-prose :global(h1), .content-prose :global(h2), .content-prose :global(h3) {
      color: var(--color-ink);
    }
    .content-prose :global(p), .content-prose :global(li) {
      color: var(--color-ink);
    }
    .content-prose :global(a) {
      color: var(--color-accent);
    }
  </style>

  <div class="mb-4">
    <a href="/admin/discussions" class="text-xs transition-colors" style="color: var(--color-muted);">← All discussions</a>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1 space-y-4">
      <div class="admin-card space-y-3 text-sm">
        <div>
          <p class="label">Project / Subsystem</p>
          <p class="font-mono text-sm">{d.project} / {d.subsystem}</p>
        </div>
        <div>
          <p class="label">Date</p>
          <p class="font-mono text-sm">{d.date.toISOString().slice(0, 10)}</p>
        </div>
        <div>
          <p class="label">Proposer</p>
          <p class="text-xs break-words">{d.proposer ?? '—'}</p>
        </div>
        <div>
          <p class="label">Source type</p>
          <p>{d.source_type}</p>
        </div>
        <div class="flex gap-6">
          <div>
            <p class="label">Consensus</p>
            <p class="font-semibold" style={`color: ${
              d.consensus === 'Accepted' ? '#2ecc71' :
              d.consensus === 'Rejected' ? '#e74c3c' : 'var(--color-muted)'
            }`}>{d.consensus ?? '—'}</p>
          </div>
          <div>
            <p class="label">Sentiment</p>
            <p class="text-xl font-bold" style={`color: ${
              (d.sentiment_score ?? 5) >= 7 ? '#2ecc71' :
              (d.sentiment_score ?? 5) <= 3 ? '#e74c3c' : 'var(--color-muted)'
            }`}>{d.sentiment_score ?? '—'}<span class="text-xs" style="color: var(--color-muted);">/10</span></p>
          </div>
        </div>
        {d.technical_tradeoffs && d.technical_tradeoffs.length > 0 && (
          <div>
            <p class="label">Technical tradeoffs</p>
            <ul class="space-y-1">
              {d.technical_tradeoffs.map(t => (
                <li class="text-xs flex gap-2" style="color: var(--color-ink);">
                  <span class="shrink-0" style="color: var(--color-muted);">•</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {d.url && (
          <div>
            <a href={d.url} target="_blank" rel="noopener noreferrer"
               class="text-xs transition-colors break-all"
               style="color: var(--color-accent);">
              View thread →
            </a>
          </div>
        )}
        {d.bugzilla_url && (
          <div>
            <a href={d.bugzilla_url} target="_blank" rel="noopener noreferrer"
               class="text-xs transition-colors break-all"
               style="color: var(--color-accent);">
              Bugzilla →
            </a>
          </div>
        )}
      </div>

      <div class="admin-card text-sm">
        <p class="text-xs uppercase tracking-wide mb-2" style="color: var(--color-muted);">All attributes</p>
        <dl class="space-y-2">
          {attributes.map(([key, value]) => (
            <div>
              <dt class="text-[11px] font-mono" style="color: var(--color-muted);">{key}</dt>
              <dd class="text-xs break-words" style="color: var(--color-ink);">
                {value === null || value === undefined || value === '' ? (
                  <span style="color: var(--color-muted);">—</span>
                ) : value instanceof Date ? (
                  <span class="font-mono">{value.toISOString()}</span>
                ) : typeof value === 'boolean' ? (
                  <span style={value ? 'color: #2ecc71;' : 'color: var(--color-muted);'}>{String(value)}</span>
                ) : Array.isArray(value) ? (
                  value.length === 0 ? (
                    <span style="color: var(--color-muted);">[]</span>
                  ) : (
                    <ul class="space-y-1 mt-0.5">
                      {value.map(item => (
                        <li class="flex gap-1.5">
                          <span class="shrink-0" style="color: var(--color-muted);">•</span>
                          {typeof item === 'object' && item !== null ? (
                            <span class="font-mono text-[11px] break-all">{JSON.stringify(item)}</span>
                          ) : (
                            <span class="break-words">{String(item)}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )
                ) : isUrl(value) ? (
                  <a href={value} target="_blank" rel="noopener noreferrer"
                     class="transition-colors break-all"
                     style="color: var(--color-accent);">{value}</a>
                ) : (
                  <span class="break-words">{String(value)}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="lg:col-span-2">
      <div class="content-prose prose prose-sm max-w-none">
        <h1 class="text-base font-semibold not-prose mb-4" style="color: var(--color-ink);">{d.title}</h1>
        <Content />
      </div>
    </div>
  </div>
</AdminLayout>
