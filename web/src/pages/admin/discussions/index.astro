---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const discussions = (await getCollection('discussions'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<AdminLayout title="Discussions" section="discussions">
  <div class="mb-4">
    <p class="text-sm text-zinc-400">{discussions.length} threads indexed</p>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-zinc-800 text-xs text-zinc-500 uppercase tracking-wide">
          <th class="px-4 py-3 text-left font-medium">Date</th>
          <th class="px-4 py-3 text-left font-medium">Project</th>
          <th class="px-4 py-3 text-left font-medium">Title</th>
          <th class="px-4 py-3 text-left font-medium">Proposer</th>
          <th class="px-4 py-3 text-center font-medium">Consensus</th>
          <th class="px-4 py-3 text-center font-medium">Sentiment</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800">
        {discussions.map(e => (
          <tr class="hover:bg-zinc-800/40 transition-colors">
            <td class="px-4 py-2.5 font-mono text-xs text-zinc-500 whitespace-nowrap">
              {e.data.date.toISOString().slice(0, 10)}
            </td>
            <td class="px-4 py-2.5">
              <span class="font-mono text-xs bg-zinc-800 text-zinc-300 px-1.5 py-0.5 rounded">
                {e.data.project}
              </span>
            </td>
            <td class="px-4 py-2.5 max-w-xs">
              <a
                href={`/admin/discussions/${e.id}`}
                class="text-zinc-200 hover:text-amber-400 transition-colors line-clamp-1"
                title={e.data.title}
              >
                {e.data.title}
              </a>
            </td>
            <td class="px-4 py-2.5 text-xs text-zinc-400 max-w-[10rem] truncate">
              {e.data.proposer ?? '—'}
            </td>
            <td class="px-4 py-2.5 text-center">
              <span class={`text-xs px-2 py-0.5 rounded-full ${
                e.data.consensus === 'Accepted' ? 'bg-emerald-900/50 text-emerald-400' :
                e.data.consensus === 'Rejected' ? 'bg-red-900/50 text-red-400' :
                'bg-zinc-800 text-zinc-400'
              }`}>
                {e.data.consensus ?? '—'}
              </span>
            </td>
            <td class="px-4 py-2.5 text-center">
              <span class={`text-xs font-bold tabular-nums ${
                (e.data.sentiment_score ?? 5) >= 7 ? 'text-emerald-400' :
                (e.data.sentiment_score ?? 5) <= 3 ? 'text-red-400' : 'text-zinc-400'
              }`}>
                {e.data.sentiment_score ?? '—'}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
