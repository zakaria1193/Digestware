---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const discussions = (await getCollection('discussions'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<AdminLayout title="Discussions" section="discussions">
  <style>
    .discussions-table {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .discussions-table table {
      width: 100%;
      font-size: 0.875rem;
    }
    .discussions-table thead tr {
      border-bottom: 1px solid var(--color-rule);
      color: var(--color-muted);
    }
    .discussions-table tbody tr {
      border-bottom: 1px solid var(--color-rule);
      transition: background-color 0.2s;
    }
    .discussions-table tbody tr:hover {
      background: rgba(26, 26, 26, 0.05);
    }
    .project-tag {
      font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
      font-size: 0.75rem;
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      color: var(--color-ink);
      padding: 0.375rem 0.375rem;
      border-radius: 0.25rem;
    }
    .consensus-badge {
      font-size: 0.75rem;
      padding: 0.5rem 0.5rem;
      border-radius: 9999px;
    }
    .consensus-accepted {
      background: rgba(46, 204, 113, 0.1);
      color: #2ecc71;
    }
    .consensus-rejected {
      background: rgba(231, 76, 60, 0.1);
      color: #e74c3c;
    }
    .consensus-pending {
      background: rgba(26, 26, 26, 0.05);
      color: var(--color-muted);
    }
  </style>

  <div class="mb-4">
    <p class="text-sm" style="color: var(--color-muted);">{discussions.length} threads indexed</p>
  </div>

  <div class="discussions-table">
    <table>
      <thead>
        <tr>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Date</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Project</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Title</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Proposer</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Consensus</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Sentiment</th>
        </tr>
      </thead>
      <tbody>
        {discussions.map(e => (
          <tr>
            <td class="px-4 py-2.5 font-mono text-xs whitespace-nowrap" style="color: var(--color-muted);">
              {e.data.date.toISOString().slice(0, 10)}
            </td>
            <td class="px-4 py-2.5">
              <span class="project-tag">
                {e.data.project}
              </span>
            </td>
            <td class="px-4 py-2.5 max-w-xs">
              <a
                href={`/admin/discussions/${e.id}`}
                class="transition-colors line-clamp-1"
                style="color: var(--color-ink);"
                title={e.data.title}
              >
                {e.data.title}
              </a>
            </td>
            <td class="px-4 py-2.5 text-xs max-w-[10rem] truncate" style="color: var(--color-muted);">
              {e.data.proposer ?? '—'}
            </td>
            <td class="px-4 py-2.5 text-center">
              <span class={`consensus-badge ${
                e.data.consensus === 'Accepted' ? 'consensus-accepted' :
                e.data.consensus === 'Rejected' ? 'consensus-rejected' :
                'consensus-pending'
              }`}>
                {e.data.consensus ?? '—'}
              </span>
            </td>
            <td class="px-4 py-2.5 text-center">
              <span class={`text-xs font-bold tabular-nums`}
                style={`color: ${
                  (e.data.sentiment_score ?? 5) >= 7 ? '#2ecc71' :
                  (e.data.sentiment_score ?? 5) <= 3 ? '#e74c3c' : 'var(--color-muted)'
                }`}>
                {e.data.sentiment_score ?? '—'}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
