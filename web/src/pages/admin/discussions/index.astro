---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const discussions = (await getCollection('discussions'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<AdminLayout title="Discussions" section="discussions">
  <style>
    .discussions-table {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .discussions-table table {
      width: 100%;
      font-size: 0.875rem;
    }
    .discussions-table thead tr {
      border-bottom: 1px solid var(--color-rule);
      color: var(--color-muted);
    }
    .discussions-table tbody tr {
      border-bottom: 1px solid var(--color-rule);
      transition: background-color 0.2s;
    }
    .discussions-table tbody tr:hover {
      background: rgba(26, 26, 26, 0.05);
    }
    .project-tag {
      font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
      font-size: 0.75rem;
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      color: var(--color-ink);
      padding: 0.375rem 0.375rem;
      border-radius: 0.25rem;
    }
    .consensus-badge {
      font-size: 0.75rem;
      padding: 0.5rem 0.5rem;
      border-radius: 9999px;
    }
    .consensus-accepted {
      background: rgba(46, 204, 113, 0.1);
      color: #2ecc71;
    }
    .consensus-rejected {
      background: rgba(231, 76, 60, 0.1);
      color: #e74c3c;
    }
    .consensus-pending {
      background: rgba(26, 26, 26, 0.05);
      color: var(--color-muted);
    }
  </style>

  <div class="mb-4 flex items-center justify-between">
    <p class="text-sm" style="color: var(--color-muted);">
      <span id="row-count">{discussions.length}</span> of {discussions.length} threads
      <span id="filter-label" style="color: var(--color-accent);"></span>
    </p>
    <div class="text-xs flex gap-2" style="color: var(--color-muted);">
      <a href="/admin/discussions" class="filter-link" data-filter="">All</a>
      <span>·</span>
      <a href="/admin/discussions?filter=stubs" class="filter-link" data-filter="stubs">Stubs</a>
    </div>
  </div>

  <div class="discussions-table">
    <table>
      <thead>
        <tr>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Date</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Project</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Title</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Proposer</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Consensus</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Sentiment</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Stub</th>
        </tr>
      </thead>
      <tbody>
        {discussions.map(e => (
          <tr data-stub={e.data.is_stub ? '1' : '0'}>
            <td class="px-4 py-2.5 font-mono text-xs whitespace-nowrap" style="color: var(--color-muted);">
              {e.data.date.toISOString().slice(0, 10)}
            </td>
            <td class="px-4 py-2.5">
              <span class="project-tag">
                {e.data.project}
              </span>
            </td>
            <td class="px-4 py-2.5 max-w-xs">
              <a
                href={`/admin/discussions/${e.id}`}
                class="transition-colors line-clamp-1"
                style="color: var(--color-ink);"
                title={e.data.title}
              >
                {e.data.title}
              </a>
            </td>
            <td class="px-4 py-2.5 text-xs max-w-[10rem] truncate" style="color: var(--color-muted);">
              {e.data.proposer ?? '—'}
            </td>
            <td class="px-4 py-2.5 text-center">
              <span class={`consensus-badge ${
                e.data.consensus === 'Accepted' ? 'consensus-accepted' :
                e.data.consensus === 'Rejected' ? 'consensus-rejected' :
                'consensus-pending'
              }`}>
                {e.data.consensus ?? '—'}
              </span>
            </td>
            <td class="px-4 py-2.5 text-center">
              <span class={`text-xs font-bold tabular-nums`}
                style={`color: ${
                  (e.data.sentiment_score ?? 5) >= 7 ? '#2ecc71' :
                  (e.data.sentiment_score ?? 5) <= 3 ? '#e74c3c' : 'var(--color-muted)'
                }`}>
                {e.data.sentiment_score ?? '—'}
              </span>
            </td>
            <td class="px-4 py-2.5 text-center">
              {e.data.is_stub ? (
                <span class="text-xs font-semibold" style="color: var(--color-muted);">stub</span>
              ) : (
                <span class="text-xs" style="color: var(--color-muted);">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const filter = params.get('filter') ?? '';
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.discussions-table tbody tr'));
    const countEl = document.getElementById('row-count');
    const labelEl = document.getElementById('filter-label');
    const labels: Record<string, string> = {
      stubs: '· filtered: stubs (failed digests)',
    };
    function rowPasses(r: HTMLTableRowElement, f: string): boolean {
      if (f === 'stubs') return r.dataset.stub === '1';
      return true;
    }
    let visible = 0;
    for (const r of rows) {
      const show = rowPasses(r, filter);
      r.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    if (countEl) countEl.textContent = String(visible);
    if (labelEl) labelEl.textContent = labels[filter] ?? '';
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.filter-link')) {
      if ((a.dataset.filter ?? '') === filter) {
        a.style.color = 'var(--color-accent)';
        a.style.fontWeight = '700';
      }
    }
  </script>
</AdminLayout>
