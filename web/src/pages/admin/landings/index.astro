---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const landings = (await getCollection('landings'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const projects = [...new Set(landings.map(e => e.data.project))].sort();
---

<AdminLayout title="Landings" section="landings">
  <style>
    .landings-table {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .landings-table table {
      width: 100%;
      font-size: 0.875rem;
    }
    .landings-table thead tr {
      border-bottom: 1px solid var(--color-rule);
      color: var(--color-muted);
    }
    .landings-table tbody tr {
      border-bottom: 1px solid var(--color-rule);
      transition: background-color 0.2s;
    }
    .landings-table tbody tr:hover {
      background: rgba(26, 26, 26, 0.05);
    }
    .project-tag {
      font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
      font-size: 0.75rem;
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      color: var(--color-ink);
      padding: 0.375rem 0.375rem;
      border-radius: 0.25rem;
    }
  </style>

  <div class="mb-4 flex items-center justify-between">
    <p class="text-sm" style="color: var(--color-muted);">{landings.length} commits indexed</p>
  </div>

  <div class="landings-table">
    <table>
      <thead>
        <tr>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Date</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Project</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Subsystem</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Commit</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Author</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Impact</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Perf</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Breaking</th>
        </tr>
      </thead>
      <tbody>
        {landings.map(e => (
          <tr>
            <td class="px-4 py-2.5 font-mono text-xs whitespace-nowrap" style="color: var(--color-muted);">
              {e.data.date.toISOString().slice(0, 10)}
            </td>
            <td class="px-4 py-2.5">
              <span class="project-tag">
                {e.data.project}
              </span>
            </td>
            <td class="px-4 py-2.5 text-xs" style="color: var(--color-muted);">{e.data.subsystem}</td>
            <td class="px-4 py-2.5">
              <a
                href={`/admin/landings/${e.id}`}
                class="font-mono text-xs transition-colors"
                style="color: var(--color-accent);"
              >
                {e.data.commit_hash?.slice(0, 8) ?? e.id.slice(0, 8)}
              </a>
            </td>
            <td class="px-4 py-2.5 text-xs max-w-[10rem] truncate" style="color: var(--color-muted);">
              {e.data.author ?? '—'}
            </td>
            <td class="px-4 py-2.5 text-center">
              <span class={`text-xs font-bold tabular-nums`}
                style={`color: ${(e.data.impact_score ?? 0) >= 8 ? 'var(--color-accent)' : 'var(--color-muted)'}`}>
                {e.data.impact_score ?? '—'}
              </span>
            </td>
            <td class="px-4 py-2.5 text-center">
              {e.data.performance_win ? (
                <span class="text-xs" style="color: #2ecc71;">yes</span>
              ) : (
                <span class="text-xs" style="color: var(--color-muted);">—</span>
              )}
            </td>
            <td class="px-4 py-2.5 text-center">
              {e.data.breaking_change ? (
                <span class="text-xs font-semibold" style="color: #e74c3c;">yes</span>
              ) : (
                <span class="text-xs" style="color: var(--color-muted);">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
