---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { SHOW_IMPACT_SCORE } from '../../../config/features';

const landings = (await getCollection('landings'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<AdminLayout title="Landings" section="landings">
  <style>
    .landings-table {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .landings-table table {
      width: 100%;
      font-size: 0.875rem;
    }
    .landings-table thead tr {
      border-bottom: 1px solid var(--color-rule);
      color: var(--color-muted);
    }
    .landings-table tbody tr {
      border-bottom: 1px solid var(--color-rule);
      transition: background-color 0.2s;
    }
    .landings-table tbody tr:hover {
      background: rgba(26, 26, 26, 0.05);
    }
    .project-tag {
      font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
      font-size: 0.75rem;
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      color: var(--color-ink);
      padding: 0.375rem 0.375rem;
      border-radius: 0.25rem;
    }
  </style>

  <div class="mb-4 flex items-center justify-between">
    <p class="text-sm" style="color: var(--color-muted);">
      <span id="row-count">{landings.length}</span> of {landings.length} commits
      <span id="filter-label" style="color: var(--color-accent);"></span>
    </p>
    <div class="text-xs flex gap-2" style="color: var(--color-muted);">
      <a href="/admin/landings" class="filter-link" data-filter="">All</a>
      <span>·</span>
      {SHOW_IMPACT_SCORE && (
        <>
          <a href="/admin/landings?filter=high-impact" class="filter-link" data-filter="high-impact">High&nbsp;impact</a>
          <span>·</span>
        </>
      )}
      <a href="/admin/landings?filter=breaking" class="filter-link" data-filter="breaking">Breaking</a>
      <span>·</span>
      <a href="/admin/landings?filter=stubs" class="filter-link" data-filter="stubs">Stubs</a>
    </div>
  </div>

  <div class="landings-table">
    <table>
      <thead>
        <tr>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Date</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Project</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Subsystem</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Commit</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Author</th>
          {SHOW_IMPACT_SCORE && (
            <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Impact</th>
          )}
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Perf</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Breaking</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Stub</th>
        </tr>
      </thead>
      <tbody>
        {landings.map(e => (
          <tr
            data-impact={e.data.impact_score ?? -1}
            data-breaking={e.data.breaking_change ? '1' : '0'}
            data-stub={e.data.is_stub ? '1' : '0'}
          >
            <td class="px-4 py-2.5 font-mono text-xs whitespace-nowrap" style="color: var(--color-muted);">
              {e.data.date.toISOString().slice(0, 10)}
            </td>
            <td class="px-4 py-2.5">
              <span class="project-tag">
                {e.data.project}
              </span>
            </td>
            <td class="px-4 py-2.5 text-xs" style="color: var(--color-muted);">{e.data.subsystem}</td>
            <td class="px-4 py-2.5">
              <a
                href={`/admin/landings/${e.id}`}
                class="font-mono text-xs transition-colors"
                style="color: var(--color-accent);"
              >
                {e.data.commit_hash?.slice(0, 8) ?? e.id.slice(0, 8)}
              </a>
            </td>
            <td class="px-4 py-2.5 text-xs max-w-[10rem] truncate" style="color: var(--color-muted);">
              {e.data.author ?? '—'}
            </td>
            {SHOW_IMPACT_SCORE && (
              <td class="px-4 py-2.5 text-center">
                <span class={`text-xs font-bold tabular-nums`}
                  style={`color: ${(e.data.impact_score ?? 0) >= 8 ? 'var(--color-accent)' : 'var(--color-muted)'}`}>
                  {e.data.impact_score ?? '—'}
                </span>
              </td>
            )}
            <td class="px-4 py-2.5 text-center">
              {e.data.performance_win ? (
                <span class="text-xs" style="color: #2ecc71;">yes</span>
              ) : (
                <span class="text-xs" style="color: var(--color-muted);">—</span>
              )}
            </td>
            <td class="px-4 py-2.5 text-center">
              {e.data.breaking_change ? (
                <span class="text-xs font-semibold" style="color: #e74c3c;">yes</span>
              ) : (
                <span class="text-xs" style="color: var(--color-muted);">—</span>
              )}
            </td>
            <td class="px-4 py-2.5 text-center">
              {e.data.is_stub ? (
                <span class="text-xs font-semibold" style="color: var(--color-muted);">stub</span>
              ) : (
                <span class="text-xs" style="color: var(--color-muted);">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const filter = params.get('filter') ?? '';
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.landings-table tbody tr'));
    const countEl = document.getElementById('row-count');
    const labelEl = document.getElementById('filter-label');
    const labels: Record<string, string> = {
      'high-impact': '· filtered: high impact (≥8)',
      breaking: '· filtered: breaking changes',
      stubs: '· filtered: stubs (failed digests)',
    };
    function rowPasses(r: HTMLTableRowElement, f: string): boolean {
      if (f === 'high-impact') return parseInt(r.dataset.impact ?? '-1') >= 8;
      if (f === 'breaking') return r.dataset.breaking === '1';
      if (f === 'stubs') return r.dataset.stub === '1';
      return true;
    }
    let visible = 0;
    for (const r of rows) {
      const show = rowPasses(r, filter);
      r.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    if (countEl) countEl.textContent = String(visible);
    if (labelEl) labelEl.textContent = labels[filter] ?? '';
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.filter-link')) {
      if ((a.dataset.filter ?? '') === filter) {
        a.style.color = 'var(--color-accent)';
        a.style.fontWeight = '700';
      }
    }
  </script>
</AdminLayout>
