---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const landings = await getCollection('landings');
  return landings.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const isUrl = (v: unknown): v is string =>
  typeof v === 'string' && /^https?:\/\//.test(v);

const attributes: Array<[string, unknown]> = [
  ['project', d.project],
  ['subsystem', d.subsystem],
  ['patch_id', d.patch_id],
  ['commit_hash', d.commit_hash],
  ['source_type', d.source_type],
  ['headline', d.headline],
  ['tldr', d.tldr],
  ['author', d.author],
  ['impact_score', d.impact_score],
  ['outcome', d.outcome],
  ['performance_win', d.performance_win],
  ['breaking_change', d.breaking_change],
  ['series_id', d.series_id],
  ['series_parts', d.series_parts],
  ['tags', d.tags],
  ['discussion_id_link', d.discussion_id_link],
  ['bugzilla_pr', d.bugzilla_pr],
  ['url', d.url],
  ['date', d.date],
];
---

<AdminLayout title={`Landing: ${d.commit_hash?.slice(0, 12) ?? entry.id}`} section="landings">
  <div class="mb-4">
    <a href="/admin/landings" class="text-xs text-zinc-500 hover:text-zinc-300">← All landings</a>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 space-y-3 text-sm">
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Project / Subsystem</p>
          <p class="font-mono">{d.project} / {d.subsystem}</p>
        </div>
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Date</p>
          <p class="font-mono">{d.date.toISOString().slice(0, 10)}</p>
        </div>
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Author</p>
          <p>{d.author ?? '—'}</p>
        </div>
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Commit</p>
          <p class="font-mono text-xs break-all">{d.commit_hash ?? '—'}</p>
        </div>
        <div>
          <p class="text-xs text-zinc-500 mb-0.5">Source</p>
          <p>{d.source_type}</p>
        </div>
        <div class="flex gap-4">
          <div>
            <p class="text-xs text-zinc-500 mb-0.5">Impact</p>
            <p class={`text-xl font-bold ${(d.impact_score ?? 0) >= 8 ? 'text-amber-400' : ''}`}>
              {d.impact_score ?? '—'}<span class="text-xs text-zinc-500">/10</span>
            </p>
          </div>
          <div>
            <p class="text-xs text-zinc-500 mb-0.5">Perf win</p>
            <p class={d.performance_win ? 'text-emerald-400' : 'text-zinc-600'}>{d.performance_win ? 'Yes' : 'No'}</p>
          </div>
          <div>
            <p class="text-xs text-zinc-500 mb-0.5">Breaking</p>
            <p class={d.breaking_change ? 'text-red-400 font-semibold' : 'text-zinc-600'}>{d.breaking_change ? 'Yes' : 'No'}</p>
          </div>
        </div>
        {d.url && (
          <div>
            <a href={d.url} target="_blank" rel="noopener noreferrer"
               class="text-xs text-amber-400 hover:text-amber-300 break-all">
              View on GitHub →
            </a>
          </div>
        )}
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4 text-sm">
        <p class="text-xs text-zinc-500 mb-2 uppercase tracking-wide">All attributes</p>
        <dl class="space-y-2">
          {attributes.map(([key, value]) => (
            <div>
              <dt class="text-[11px] text-zinc-500 font-mono">{key}</dt>
              <dd class="text-xs text-zinc-200 break-words">
                {value === null || value === undefined || value === '' ? (
                  <span class="text-zinc-600">—</span>
                ) : value instanceof Date ? (
                  <span class="font-mono">{value.toISOString()}</span>
                ) : typeof value === 'boolean' ? (
                  <span class={value ? 'text-emerald-400' : 'text-zinc-500'}>{String(value)}</span>
                ) : Array.isArray(value) ? (
                  value.length === 0 ? (
                    <span class="text-zinc-600">[]</span>
                  ) : (
                    <ul class="space-y-1 mt-0.5">
                      {value.map(item => (
                        <li class="flex gap-1.5">
                          <span class="text-zinc-600 shrink-0">•</span>
                          {typeof item === 'object' && item !== null ? (
                            <span class="font-mono text-[11px] break-all">{JSON.stringify(item)}</span>
                          ) : (
                            <span class="break-words">{String(item)}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )
                ) : isUrl(value) ? (
                  <a href={value} target="_blank" rel="noopener noreferrer"
                     class="text-amber-400 hover:text-amber-300 break-all">{value}</a>
                ) : (
                  <span class="break-words">{String(value)}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="lg:col-span-2">
      <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6 prose prose-invert prose-sm max-w-none">
        <Content />
      </div>
    </div>
  </div>
</AdminLayout>
