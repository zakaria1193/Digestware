---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const landings = await getCollection('landings');
  return landings.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const isUrl = (v: unknown): v is string =>
  typeof v === 'string' && /^https?:\/\//.test(v);

const attributes: Array<[string, unknown]> = [
  ['project', d.project],
  ['subsystem', d.subsystem],
  ['patch_id', d.patch_id],
  ['commit_hash', d.commit_hash],
  ['source_type', d.source_type],
  ['headline', d.headline],
  ['tldr', d.tldr],
  ['why_it_matters', d.why_it_matters],
  ['author', d.author],
  ['impact_score', d.impact_score],
  ['impact_rationale', d.impact_rationale],
  ['outcome', d.outcome],
  ['performance_win', d.performance_win],
  ['breaking_change', d.breaking_change],
  ['series_id', d.series_id],
  ['series_parts', d.series_parts],
  ['tags', d.tags],
  ['discussion_id_link', d.discussion_id_link],
  ['bugzilla_pr', d.bugzilla_pr],
  ['url', d.url],
  ['date', d.date],
];
---

<AdminLayout title={`Landing: ${d.commit_hash?.slice(0, 12) ?? entry.id}`} section="landings">
  <style>
    .admin-card {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      padding: 1rem;
    }
    .admin-card p {
      color: var(--color-ink);
    }
    .admin-card .label {
      font-size: 0.75rem;
      color: var(--color-muted);
      margin-bottom: 0.125rem;
    }
    .content-prose {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      padding: 1.5rem;
    }
    .content-prose :global(h1), .content-prose :global(h2), .content-prose :global(h3),
    .content-prose :global(h4), .content-prose :global(h5), .content-prose :global(h6) {
      color: var(--color-ink);
    }
    .content-prose :global(p), .content-prose :global(li) {
      color: var(--color-ink);
    }
    .content-prose :global(a) {
      color: var(--color-accent);
    }
    .content-prose :global(code) {
      color: var(--color-ink);
      background: rgba(26, 26, 26, 0.05);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
    }
  </style>

  <div class="mb-4">
    <a href="/admin/landings" class="text-xs transition-colors" style="color: var(--color-muted);">← All landings</a>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1 space-y-4">
      <div class="admin-card space-y-3 text-sm">
        <div>
          <p class="label">Project / Subsystem</p>
          <p class="font-mono text-sm">{d.project} / {d.subsystem}</p>
        </div>
        <div>
          <p class="label">Date</p>
          <p class="font-mono text-sm">{d.date.toISOString().slice(0, 10)}</p>
        </div>
        <div>
          <p class="label">Author</p>
          <p>{d.author ?? '—'}</p>
        </div>
        <div>
          <p class="label">Commit</p>
          <p class="font-mono text-xs break-all">{d.commit_hash ?? '—'}</p>
        </div>
        <div>
          <p class="label">Source</p>
          <p>{d.source_type}</p>
        </div>
        <div class="flex gap-4">
          <div>
            <p class="label">Impact</p>
            <p class="text-xl font-bold" style={`color: ${(d.impact_score ?? 0) >= 8 ? 'var(--color-accent)' : 'var(--color-ink)'}`}>
              {d.impact_score ?? '—'}<span class="text-xs" style="color: var(--color-muted);">/10</span>
            </p>
          </div>
          <div>
            <p class="label">Perf win</p>
            <p style={d.performance_win ? 'color: #2ecc71;' : 'color: var(--color-muted);'}>{d.performance_win ? 'Yes' : 'No'}</p>
          </div>
          <div>
            <p class="label">Breaking</p>
            <p style={d.breaking_change ? 'color: #e74c3c; font-weight: bold;' : 'color: var(--color-muted);'}>{d.breaking_change ? 'Yes' : 'No'}</p>
          </div>
        </div>
        {d.url && (
          <div>
            <a href={d.url} target="_blank" rel="noopener noreferrer"
               class="text-xs transition-colors break-all"
               style="color: var(--color-accent);">
              View on GitHub →
            </a>
          </div>
        )}
      </div>

      <div class="admin-card text-sm">
        <p class="text-xs uppercase tracking-wide mb-2" style="color: var(--color-muted);">All attributes</p>
        <dl class="space-y-2">
          {attributes.map(([key, value]) => (
            <div>
              <dt class="text-[11px] font-mono" style="color: var(--color-muted);">{key}</dt>
              <dd class="text-xs break-words" style="color: var(--color-ink);">
                {value === null || value === undefined || value === '' ? (
                  <span style="color: var(--color-muted);">—</span>
                ) : value instanceof Date ? (
                  <span class="font-mono">{value.toISOString()}</span>
                ) : typeof value === 'boolean' ? (
                  <span style={value ? 'color: #2ecc71;' : 'color: var(--color-muted);'}>{String(value)}</span>
                ) : Array.isArray(value) ? (
                  value.length === 0 ? (
                    <span style="color: var(--color-muted);">[]</span>
                  ) : (
                    <ul class="space-y-1 mt-0.5">
                      {value.map(item => (
                        <li class="flex gap-1.5">
                          <span style="color: var(--color-muted);" class="shrink-0">•</span>
                          {typeof item === 'object' && item !== null ? (
                            <span class="font-mono text-[11px] break-all">{JSON.stringify(item)}</span>
                          ) : (
                            <span class="break-words">{String(item)}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )
                ) : isUrl(value) ? (
                  <a href={value} target="_blank" rel="noopener noreferrer"
                     class="transition-colors break-all"
                     style="color: var(--color-accent);">{value}</a>
                ) : (
                  <span class="break-words">{String(value)}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="lg:col-span-2">
      <div class="content-prose prose prose-sm max-w-none">
        <Content />
      </div>
    </div>
  </div>
</AdminLayout>
