---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { SHOW_IMPACT_SCORE } from '../../config/features';

const [discussions, landings] = await Promise.all([
  getCollection('discussions'),
  getCollection('landings'),
]);

const projects = [...new Set([
  ...landings.map(e => e.data.project),
  ...discussions.map(e => e.data.project),
])].sort();

const recentLandings = [...landings]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const recentDiscussions = [...discussions]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const highImpactLandings = landings.filter(e => (e.data.impact_score ?? 0) >= 8).length;
const breakingChanges = landings.filter(e => e.data.breaking_change).length;
// Stubs = agent-side placeholders (LLM batch failed or omitted the item).
// They're hidden from the public site but tracked here so failures stay
// visible to ops.
const stubLandings = landings.filter(e => e.data.is_stub).length;
const stubDiscussions = discussions.filter(e => e.data.is_stub).length;
const stubTotal = stubLandings + stubDiscussions;
---

<AdminLayout title="Dashboard" section="dashboard">
  <style>
    .admin-card {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      padding: 1rem;
      display: block;
      text-decoration: none;
      color: inherit;
      transition: background-color 0.15s, border-color 0.15s, transform 0.15s;
    }
    a.admin-card:hover {
      background: rgba(26, 26, 26, 0.04);
      border-color: var(--color-accent);
      transform: translateY(-1px);
    }
    .admin-card p {
      color: var(--color-muted);
    }
    .admin-card .value {
      color: var(--color-ink);
    }
    .admin-link:hover {
      background: rgba(26, 26, 26, 0.05);
    }
  </style>

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-5 mb-8">
    <a class="admin-card" href="/admin/landings">
      <p class="text-xs uppercase tracking-wide mb-1">Landings</p>
      <p class="text-3xl font-bold tabular-nums value">{landings.length}</p>
    </a>
    <a class="admin-card" href="/admin/discussions">
      <p class="text-xs uppercase tracking-wide mb-1">Discussions</p>
      <p class="text-3xl font-bold tabular-nums value">{discussions.length}</p>
    </a>
    {SHOW_IMPACT_SCORE && (
      <a class="admin-card" href="/admin/landings?filter=high-impact">
        <p class="text-xs uppercase tracking-wide mb-1">High Impact ≥8</p>
        <p class="text-3xl font-bold tabular-nums value" style="color: var(--color-accent);">{highImpactLandings}</p>
      </a>
    )}
    <a class="admin-card" href="/admin/landings?filter=breaking">
      <p class="text-xs uppercase tracking-wide mb-1">Breaking Changes</p>
      <p class="text-3xl font-bold tabular-nums value" style="color: var(--color-market-red);">{breakingChanges}</p>
    </a>
    <div class="admin-card" title={`${stubLandings} stub landings + ${stubDiscussions} stub discussions`}>
      <p class="text-xs uppercase tracking-wide mb-1">Stubs (failed)</p>
      <p class="text-3xl font-bold tabular-nums value" style="color: var(--color-muted);">{stubTotal}</p>
      <p class="text-xs mt-1" style="color: var(--color-muted);">
        <a href="/admin/landings?filter=stubs" style="color: var(--color-accent);">{stubLandings} L</a>
        ·
        <a href="/admin/discussions?filter=stubs" style="color: var(--color-accent);">{stubDiscussions} D</a>
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 mb-8">
    <div class="admin-card">
      <p class="text-xs uppercase tracking-wide mb-3">Projects</p>
      <div class="space-y-1">
        {projects.map(proj => {
          const lCount = landings.filter(e => e.data.project === proj).length;
          const dCount = discussions.filter(e => e.data.project === proj).length;
          return (
            <div class="flex items-center justify-between text-sm">
              <span class="font-mono value">{proj}</span>
              <span style="color: var(--color-muted);">{lCount}L / {dCount}D</span>
            </div>
          );
        })}
      </div>
    </div>

    <div class="admin-card">
      <div class="flex items-center justify-between mb-3">
        <p class="text-xs uppercase tracking-wide">Recent Landings</p>
        <a href="/admin/landings" class="text-xs transition-colors" style="color: var(--color-accent);">All →</a>
      </div>
      <ul class="space-y-2">
        {recentLandings.map(e => (
          <li>
            <a href={`/admin/landings/${e.id}`} class="block admin-link rounded px-2 py-1 -mx-2 transition-colors">
              <p class="text-sm value truncate">{e.data.commit_hash?.slice(0, 8) ?? '—'} <span style="color: var(--color-muted);">{e.data.project}</span></p>
              <p class="text-xs" style="color: var(--color-muted);">{e.data.date.toISOString().slice(0, 10)}{SHOW_IMPACT_SCORE && <> · impact {e.data.impact_score ?? '?'}</>}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="admin-card">
      <div class="flex items-center justify-between mb-3">
        <p class="text-xs uppercase tracking-wide">Recent Discussions</p>
        <a href="/admin/discussions" class="text-xs transition-colors" style="color: var(--color-accent);">All →</a>
      </div>
      <ul class="space-y-2">
        {recentDiscussions.map(e => (
          <li>
            <a href={`/admin/discussions/${e.id}`} class="block admin-link rounded px-2 py-1 -mx-2 transition-colors">
              <p class="text-sm value truncate">{e.data.title}</p>
              <p class="text-xs" style="color: var(--color-muted);">{e.data.date.toISOString().slice(0, 10)} · {e.data.consensus ?? '—'}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

</AdminLayout>
