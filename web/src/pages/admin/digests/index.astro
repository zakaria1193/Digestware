---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const digests = (await getCollection('digests'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<AdminLayout title="Digests" section="digests">
  <style>
    .digest-card {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      padding: 1rem;
      transition: border-color 0.2s;
      cursor: pointer;
    }
    .digest-card:hover {
      border-color: var(--color-accent);
    }
    .bento-badge {
      font-size: 0.75rem;
      background: rgba(160, 23, 34, 0.1);
      color: var(--color-accent);
      border: 1px solid rgba(160, 23, 34, 0.3);
      padding: 0.375rem 0.375rem;
      border-radius: 0.25rem;
    }
  </style>

  {digests.length === 0 ? (
    <div class="border border-dashed rounded-lg p-12 text-center" style="border-color: var(--color-rule); background: rgba(26, 26, 26, 0.02);">
      <p class="font-medium mb-1" style="color: var(--color-muted);">No digests yet</p>
      <p class="text-sm" style="color: var(--color-muted);">Run the agent to generate the first bento digest.</p>
      <pre class="mt-4 text-xs inline-block text-left rounded px-4 py-3" style="color: var(--color-muted); background: var(--color-card); border: 1px solid var(--color-rule);">cd agents && python -m agents.main</pre>
    </div>
  ) : (
    <div>
      <div class="mb-4">
        <p class="text-sm" style="color: var(--color-muted);">{digests.length} digests generated</p>
      </div>
      <div class="grid gap-4">
        {digests.map(e => {
          const d = e.data;
          return (
            <a
              href={`/admin/digests/${e.id}`}
              class="block digest-card"
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    {d.is_bento_worthy && (
                      <span class="bento-badge">Bento</span>
                    )}
                    <span class="font-mono text-xs" style="color: var(--color-muted);">{d.subsystem}</span>
                  </div>
                  <p class="font-semibold" style="color: var(--color-ink);">{d.title}</p>
                  <p class="text-sm mt-1 line-clamp-2" style="color: var(--color-muted);">{d.summary}</p>
                </div>
                <div class="shrink-0 text-right">
                  <p class="text-2xl font-bold tabular-nums" style={`color: ${d.impact_score >= 8 ? 'var(--color-accent)' : 'var(--color-muted)'}`}>
                    {d.impact_score}
                  </p>
                  <p class="text-xs" style="color: var(--color-muted);">impact</p>
                  <p class="text-xs mt-2" style="color: var(--color-muted);">{d.date.toISOString().slice(0, 10)}</p>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}
</AdminLayout>
