---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const digests = (await getCollection('digests'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<AdminLayout title="Digests" section="digests">
  {digests.length === 0 ? (
    <div class="bg-zinc-900/50 border border-dashed border-zinc-700 rounded-lg p-12 text-center">
      <p class="text-zinc-400 font-medium mb-1">No digests yet</p>
      <p class="text-zinc-600 text-sm">Run the agent to generate the first bento digest.</p>
      <pre class="mt-4 text-xs text-zinc-500 bg-zinc-900 border border-zinc-800 rounded px-4 py-3 inline-block text-left">cd agents && python -m agents.main</pre>
    </div>
  ) : (
    <div>
      <div class="mb-4">
        <p class="text-sm text-zinc-400">{digests.length} digests generated</p>
      </div>
      <div class="grid gap-4">
        {digests.map(e => {
          const d = e.data;
          return (
            <a
              href={`/admin/digests/${e.id}`}
              class="block bg-zinc-900 border border-zinc-800 rounded-lg p-4 hover:border-zinc-600 transition-colors"
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    {d.is_bento_worthy && (
                      <span class="text-xs bg-amber-900/50 text-amber-400 border border-amber-800 px-1.5 py-0.5 rounded">Bento</span>
                    )}
                    <span class="font-mono text-xs text-zinc-500">{d.subsystem}</span>
                  </div>
                  <p class="font-semibold text-zinc-100">{d.title}</p>
                  <p class="text-sm text-zinc-400 mt-1 line-clamp-2">{d.summary}</p>
                </div>
                <div class="shrink-0 text-right">
                  <p class={`text-2xl font-bold tabular-nums ${d.impact_score >= 8 ? 'text-amber-400' : 'text-zinc-400'}`}>
                    {d.impact_score}
                  </p>
                  <p class="text-xs text-zinc-600">impact</p>
                  <p class="text-xs text-zinc-500 mt-2">{d.date.toISOString().slice(0, 10)}</p>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )}
</AdminLayout>
