---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const isUrl = (v: unknown): v is string =>
  typeof v === 'string' && /^https?:\/\//.test(v);

const attributes: Array<[string, unknown]> = [
  ['lesson_id', d.lesson_id],
  ['project', d.project],
  ['subsystem', d.subsystem],
  ['commit_hash', d.commit_hash],
  ['source_type', d.source_type],
  ['headline', d.headline],
  ['hook', d.hook],
  ['tldr', d.tldr],
  ['concept', d.concept],
  ['prerequisites', d.prerequisites],
  ['code_tour', d.code_tour],
  ['takeaways', d.takeaways],
  ['further_reading', d.further_reading],
  ['primer_expert', d.primer_expert],
  ['primer_glossary', d.primer_glossary],
  ['tags', d.tags],
  ['landing_slug', d.landing_slug],
  ['patch_id', d.patch_id],
  ['url', d.url],
  ['date', d.date],
  ['is_stub', d.is_stub],
  ['stub_reason', d.stub_reason],
];
---

<AdminLayout title={`Lesson: ${d.lesson_id}`} section="lessons">
  <style>
    .admin-card {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      padding: 1rem;
    }
    .admin-card p { color: var(--color-ink); }
    .admin-card .label {
      font-size: 0.75rem;
      color: var(--color-muted);
      margin-bottom: 0.125rem;
    }
    .content-prose {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      padding: 1.5rem;
    }
    .content-prose :global(h1), .content-prose :global(h2), .content-prose :global(h3),
    .content-prose :global(h4), .content-prose :global(h5), .content-prose :global(h6) {
      color: var(--color-ink);
    }
    .content-prose :global(p), .content-prose :global(li) { color: var(--color-ink); }
    .content-prose :global(a) { color: var(--color-accent); }
    .content-prose :global(code) {
      color: var(--color-ink);
      background: rgba(26, 26, 26, 0.05);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
    }
    .warn {
      background: rgba(231, 76, 60, 0.08);
      border: 1px solid #e74c3c;
      border-radius: 0.5rem;
      padding: 0.75rem 1rem;
      font-size: 0.8rem;
      color: var(--color-ink);
    }
  </style>

  <div class="mb-4">
    <a href="/admin/lessons" class="text-xs transition-colors" style="color: var(--color-muted);">← All lessons</a>
  </div>

  {!d.is_stub && (d.code_tour ?? []).length === 0 && (
    <div class="warn mb-4">
      <strong>No code tour.</strong> This lesson shipped without citing a single
      file, which means the agent either never called the source-repo tools or
      every path it cited was dropped as non-existent. Check the
      <code>lesson_agent</code> rows in <code>agents/output/usage.log</code> for
      the tool-call count on this run.
    </div>
  )}

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1 space-y-4">
      <div class="admin-card space-y-3 text-sm">
        <div>
          <p class="label">Project / Subsystem</p>
          <p class="font-mono text-sm">{d.project} / {d.subsystem}</p>
        </div>
        <div>
          <p class="label">Date</p>
          <p class="font-mono text-sm">{d.date.toISOString().slice(0, 10)}</p>
        </div>
        <div>
          <p class="label">Commit</p>
          <p class="font-mono text-xs break-all">{d.commit_hash}</p>
        </div>
        <div>
          <p class="label">Code tour</p>
          <p class="text-xl font-bold"
             style={`color: ${(d.code_tour ?? []).length === 0 ? '#e74c3c' : 'var(--color-ink)'}`}>
            {(d.code_tour ?? []).length}
            <span class="text-xs" style="color: var(--color-muted);"> files cited</span>
          </p>
        </div>
        {d.is_stub && (
          <div>
            <p class="label">Stub reason</p>
            <p class="font-mono text-xs" style="color: #e67e22;">{d.stub_reason || '—'}</p>
          </div>
        )}
        <div>
          <a href={d.url} target="_blank" rel="noopener noreferrer"
             class="text-xs transition-colors break-all"
             style="color: var(--color-accent);">
            View commit →
          </a>
        </div>
        {d.landing_slug && (
          <div>
            <a href={`/admin/landings/${d.landing_slug}`} class="text-xs" style="color: var(--color-accent);">
              Source landing →
            </a>
          </div>
        )}
      </div>

      <div class="admin-card text-sm">
        <p class="text-xs uppercase tracking-wide mb-2" style="color: var(--color-muted);">All attributes</p>
        <dl class="space-y-2">
          {attributes.map(([key, value]) => (
            <div>
              <dt class="text-[11px] font-mono" style="color: var(--color-muted);">{key}</dt>
              <dd class="text-xs break-words" style="color: var(--color-ink);">
                {value === null || value === undefined || value === '' ? (
                  <span style="color: var(--color-muted);">—</span>
                ) : value instanceof Date ? (
                  <span class="font-mono">{value.toISOString()}</span>
                ) : typeof value === 'boolean' ? (
                  <span style={value ? 'color: #2ecc71;' : 'color: var(--color-muted);'}>{String(value)}</span>
                ) : Array.isArray(value) ? (
                  value.length === 0 ? (
                    <span style="color: var(--color-muted);">[]</span>
                  ) : (
                    <ul class="space-y-1 mt-0.5">
                      {value.map(item => (
                        <li class="flex gap-1.5">
                          <span style="color: var(--color-muted);" class="shrink-0">•</span>
                          {typeof item === 'object' && item !== null ? (
                            <span class="font-mono text-[11px] break-all">{JSON.stringify(item)}</span>
                          ) : (
                            <span class="break-words">{String(item)}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  )
                ) : isUrl(value) ? (
                  <a href={value} target="_blank" rel="noopener noreferrer"
                     class="transition-colors break-all"
                     style="color: var(--color-accent);">{value}</a>
                ) : (
                  <span class="break-words">{String(value)}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="lg:col-span-2">
      <div class="content-prose prose prose-sm max-w-none">
        <Content />
      </div>
    </div>
  </div>
</AdminLayout>
