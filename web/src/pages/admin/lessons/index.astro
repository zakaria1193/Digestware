---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

// Admin deliberately bypasses the public visibility rules: stubs (a failed
// lesson run) are exactly what ops needs to see here.
const lessons = (await getCollection('lessons'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const stubs = lessons.filter(e => e.data.is_stub).length;
// A lesson with no code tour was written without opening the source tree —
// the failure mode this article type exists to avoid, so it gets its own
// filter rather than hiding inside the general counts.
const noTour = lessons.filter(e => !e.data.is_stub && (e.data.code_tour ?? []).length === 0).length;
---

<AdminLayout title="Lessons" section="lessons">
  <style>
    .lessons-table {
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .lessons-table table {
      width: 100%;
      font-size: 0.875rem;
    }
    .lessons-table thead tr {
      border-bottom: 1px solid var(--color-rule);
      color: var(--color-muted);
    }
    .lessons-table tbody tr {
      border-bottom: 1px solid var(--color-rule);
      transition: background-color 0.2s;
    }
    .lessons-table tbody tr:hover {
      background: rgba(26, 26, 26, 0.05);
    }
    .project-tag {
      font-family: 'SF Mono', 'Menlo', 'Consolas', monospace;
      font-size: 0.75rem;
      background: var(--color-card);
      border: 1px solid var(--color-rule);
      color: var(--color-ink);
      padding: 0.375rem 0.375rem;
      border-radius: 0.25rem;
    }
  </style>

  <div class="mb-4 flex items-center justify-between">
    <p class="text-sm" style="color: var(--color-muted);">
      <span id="row-count">{lessons.length}</span> of {lessons.length} lessons
      <span id="filter-label" style="color: var(--color-accent);"></span>
    </p>
    <div class="text-xs flex gap-2" style="color: var(--color-muted);">
      <a href="/admin/lessons" class="filter-link" data-filter="">All</a>
      <span>·</span>
      <a href="/admin/lessons?filter=no-tour" class="filter-link" data-filter="no-tour">
        No code tour ({noTour})
      </a>
      <span>·</span>
      <a href="/admin/lessons?filter=stubs" class="filter-link" data-filter="stubs">
        Stubs ({stubs})
      </a>
    </div>
  </div>

  <div class="lessons-table">
    <table>
      <thead>
        <tr>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Date</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Project</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Subsystem</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Headline</th>
          <th class="px-4 py-3 text-left font-medium text-xs uppercase tracking-wide">Commit</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Sections</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Code tour</th>
          <th class="px-4 py-3 text-center font-medium text-xs uppercase tracking-wide">Stub</th>
        </tr>
      </thead>
      <tbody>
        {lessons.map(e => (
          <tr
            data-stub={e.data.is_stub ? '1' : '0'}
            data-tour={(e.data.code_tour ?? []).length}
          >
            <td class="px-4 py-2.5 font-mono text-xs whitespace-nowrap" style="color: var(--color-muted);">
              {e.data.date.toISOString().slice(0, 10)}
            </td>
            <td class="px-4 py-2.5">
              <span class="project-tag">{e.data.project}</span>
            </td>
            <td class="px-4 py-2.5 text-xs" style="color: var(--color-muted);">{e.data.subsystem}</td>
            <td class="px-4 py-2.5 max-w-sm">
              <a
                href={`/admin/lessons/${e.id}`}
                class="text-sm line-clamp-1 transition-colors"
                style="color: var(--color-ink);"
                title={e.data.headline}
              >
                {e.data.headline}
              </a>
              {e.data.stub_reason && (
                <span class="text-xs font-mono ml-1" style="color: #e67e22;">
                  [{e.data.stub_reason}]
                </span>
              )}
            </td>
            <td class="px-4 py-2.5">
              <a
                href={e.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs transition-colors"
                style="color: var(--color-accent);"
              >
                {e.data.commit_hash.slice(0, 8)}
              </a>
            </td>
            <td class="px-4 py-2.5 text-center text-xs tabular-nums" style="color: var(--color-muted);">
              {/* Sections live in the Markdown body as `## ` headings, so they
                  aren't countable from frontmatter — the tour count is the
                  useful signal here. */}
              —
            </td>
            <td class="px-4 py-2.5 text-center">
              <span
                class="text-xs font-bold tabular-nums"
                style={`color: ${(e.data.code_tour ?? []).length === 0 ? '#e74c3c' : 'var(--color-muted)'}`}
              >
                {(e.data.code_tour ?? []).length}
              </span>
            </td>
            <td class="px-4 py-2.5 text-center">
              {e.data.is_stub ? (
                <span class="text-xs font-semibold" style="color: var(--color-muted);">stub</span>
              ) : (
                <span class="text-xs" style="color: var(--color-muted);">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {lessons.length === 0 && (
    <p class="text-sm mt-4" style="color: var(--color-muted);">
      No lessons yet. The pipeline writes one lesson per ISO week (projects
      alternating), chosen from that week's landed commits — see
      <code>agents/lesson_picker.py</code>.
    </p>
  )}

  <script>
    const params = new URLSearchParams(window.location.search);
    const filter = params.get('filter') ?? '';
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.lessons-table tbody tr'));
    const countEl = document.getElementById('row-count');
    const labelEl = document.getElementById('filter-label');
    const labels: Record<string, string> = {
      'no-tour': '· filtered: published without a code tour (agent never opened the source)',
      stubs: '· filtered: stubs (failed or dry-run lesson generation)',
    };
    function rowPasses(r: HTMLTableRowElement, f: string): boolean {
      if (f === 'no-tour') return r.dataset.stub === '0' && parseInt(r.dataset.tour ?? '0') === 0;
      if (f === 'stubs') return r.dataset.stub === '1';
      return true;
    }
    let visible = 0;
    for (const r of rows) {
      const show = rowPasses(r, filter);
      r.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    if (countEl) countEl.textContent = String(visible);
    if (labelEl) labelEl.textContent = labels[filter] ?? '';
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.filter-link')) {
      if ((a.dataset.filter ?? '') === filter) {
        a.style.color = 'var(--color-accent)';
        a.style.fontWeight = '700';
      }
    }
  </script>
</AdminLayout>
