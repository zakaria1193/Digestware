---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'discussions'>;
  clusterCount?: number;
}

const { entry, clusterCount = 1 } = Astro.props;
const d = entry.data;

const isHigh = (d.impact_score ?? d.sentiment_score ?? 0) >= 9;

const outcomeColors: Record<string, string> = {
  committed: '#16a34a',
  ready: '#2563eb',
  under_review: '#d97706',
  needs_revision: '#dc2626',
  nackd: '#dc2626',
  proposed: '#6b7280',
  stalled: '#9ca3af',
  withdrawn: '#9ca3af',
};
const outcomeColor = outcomeColors[d.outcome ?? 'proposed'] ?? '#6b7280';
const outcomeLabel = (d.outcome ?? 'proposed').replace(/_/g, ' ');

const dateStr = d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<article
  data-impact={isHigh ? 'high' : 'normal'}
  style={`border: 1px solid var(--color-border); border-radius: 2px; padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem; background: #fff; transition: box-shadow 0.15s; grid-column: ${isHigh ? 'span 2' : 'span 1'};`}
  onmouseover="this.style.boxShadow='0 1px 6px rgba(0,0,0,0.08)'"
  onmouseout="this.style.boxShadow='none'"
>
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
    <span style={`font-family: var(--font-sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-gold);`}>
      {d.subsystem}
    </span>
    <span style={`display: flex; align-items: center; gap: 0.3rem; font-family: var(--font-sans); font-size: 0.65rem; color: ${outcomeColor};`}>
      <span style={`width: 6px; height: 6px; border-radius: 50%; background: ${outcomeColor}; display: inline-block;`}></span>
      {outcomeLabel}
    </span>
  </div>

  <a href={`/discussions/${entry.id}`} style="text-decoration: none; color: var(--color-body);">
    <h3 style={`font-family: var(--font-serif); font-weight: 700; line-height: 1.3; margin: 0; font-size: ${isHigh ? '1.15rem' : '1rem'};`}>
      {d.headline}
    </h3>
  </a>

  <p style="font-family: var(--font-sans); font-size: 0.82rem; color: var(--color-secondary); line-height: 1.45; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
    {d.tldr}
  </p>

  <div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto; gap: 0.5rem; flex-wrap: wrap;">
    <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
      {clusterCount > 1 && (
        <span style="font-family: var(--font-sans); font-size: 0.65rem; background: #f3f4f6; color: var(--color-secondary); padding: 0.15rem 0.4rem; border-radius: 2px; border: 1px solid var(--color-border);">
          {clusterCount} related
        </span>
      )}
      {(d.tags ?? []).slice(0, 3).map(tag => (
        <span style="font-family: var(--font-sans); font-size: 0.65rem; color: var(--color-gold); padding: 0.15rem 0.4rem; border-radius: 2px; border: 1px solid #e6c94a40; background: #fefce8;">
          {tag}
        </span>
      ))}
    </div>
    <span style="font-family: var(--font-sans); font-size: 0.7rem; color: var(--color-secondary); white-space: nowrap;">{dateStr}</span>
  </div>
</article>
