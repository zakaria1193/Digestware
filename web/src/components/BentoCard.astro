---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'discussions'>;
  projectSlug: string;
  clusterCount?: number;
}

const { entry, projectSlug, clusterCount = 1 } = Astro.props;
const d = entry.data;

const score = d.impact_score ?? d.sentiment_score ?? 0;
const isHigh = score >= 7;
const isLow = score > 0 && score <= 3;

const outcomeLabels: Record<string, string> = {
  committed: 'Committed',
  ready: 'Ready to Land',
  under_review: 'Under Review',
  needs_revision: 'Needs Revision',
  nackd: 'NACK\u2019d',
  proposed: 'Proposed',
  stalled: 'Stalled',
  withdrawn: 'Withdrawn',
};
const outcomeAccent: Record<string, string> = {
  committed: '#008a3c',
  ready: '#0a2b4e',
  under_review: '#8a5a00',
  needs_revision: '#d0021b',
  nackd: '#d0021b',
  proposed: '#333333',
  stalled: '#666666',
  withdrawn: '#666666',
};

const outcomeKey = d.outcome ?? 'proposed';
const outcomeLabel = outcomeLabels[outcomeKey] ?? outcomeKey.replace(/_/g, ' ');
const outcomeColor = outcomeAccent[outcomeKey] ?? '#4a4a4a';

function scoreColor(n: number | null | undefined): string {
  if (n == null) return '#888';
  if (n <= 2)  return '#5a5a5a';
  if (n <= 4)  return '#2e6a8e';
  if (n <= 6)  return '#1a4d8a';
  if (n <= 8)  return '#7a1a2e';
  return '#b80018';
}

const dateStr = d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<article class:list={["story", isHigh && "story-featured", isLow && "story-dim"]} data-score={score} data-tags={(d.tags ?? []).join('|')}>
  <header class="story-head">
    <span class="story-kicker">{d.subsystem}</span>
    <div class="story-head-right">
      {d.impact_score != null && (
        <span class="story-score" style={`color: ${scoreColor(d.impact_score)}`}>{d.impact_score}&thinsp;/&thinsp;10</span>
      )}
      {d.sentiment_score != null && (
        <span class="story-score" style={`color: ${scoreColor(d.sentiment_score)}`}>{d.sentiment_score}&thinsp;/&thinsp;10</span>
      )}
      <span class="story-outcome" style={`color: ${outcomeColor};`}>
        <span class="dot" style={`background: ${outcomeColor};`}></span>
        {outcomeLabel}
      </span>
    </div>
  </header>

  <a href={`/${projectSlug}/discussions/${entry.id}`} class="story-link">
    <h3 class="story-headline">{d.headline}</h3>
  </a>

  <p class="story-deck">{d.tldr}</p>

  <footer class="story-foot">
    <div class="story-tags">
      {clusterCount > 1 && (
        <span class="cluster-tag">+{clusterCount - 1} related</span>
      )}
      {(d.tags ?? []).slice(0, 3).map(tag => (
        <span class="story-tag">{tag}</span>
      ))}
    </div>
    <div class="story-meta">
      {d.proposer && <><span class="byline">{d.proposer}</span><span class="bullet">&middot;</span></>}
      <time>{dateStr}</time>
    </div>
  </footer>
</article>

<style>
  .story {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .story:last-child { border-bottom: none; }

  .story-featured {
    padding: 1.1rem 0 1.25rem;
    border-bottom: 1px solid var(--color-rule-strong);
    grid-column: span 2;
  }

  .story-dim {
    opacity: 0.45;
  }
  .story-dim .story-headline {
    font-size: 0.85rem;
    font-weight: 500;
  }
  .story-dim .story-deck {
    font-size: 0.72rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .story-dim .story-kicker {
    font-size: 0.56rem;
  }

  .story-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .story-head-right {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .story-kicker {
    font-family: var(--font-sans);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .story-outcome {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  .story-link { text-decoration: none; color: inherit; }
  .story-link:hover .story-headline { color: var(--color-accent); }

  .story-headline {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--color-ink);
    overflow-wrap: break-word;
  }

  .story-featured .story-headline {
    font-size: 1.5rem;
    font-weight: 900;
  }

  .story-deck {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
  }

  .story-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.15rem;
  }

  .story-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .story-tag,
  .cluster-tag {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-bottom: 1px dotted var(--color-muted);
    padding-bottom: 1px;
  }

  .cluster-tag { color: var(--color-accent); border-color: var(--color-accent); font-weight: 600; }

  .story-meta {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.78rem;
    color: var(--color-muted);
    display: inline-flex;
    gap: 0.3rem;
    align-items: baseline;
  }

  .byline { font-weight: 600; color: var(--color-ink); }
  .bullet { color: var(--color-rule); font-style: normal; }
  .story-score {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
