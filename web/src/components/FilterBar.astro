---
// Unified filter ribbon — shared between the project home page and the
// commit (landing) detail page so both views behave identically: same
// expand-on-click labels panel, same chip-count math, same date pills,
// same auto-adjust / too-high recovery, same URL serialisation.
//
// The script is target-agnostic. It always drives the chips inside the
// bar; for "what to show or hide" it picks up whatever filterable
// targets exist on the page:
//   - `.wire`               (commit rows in any sidebar/stream)
//   - `.story`              (Bento cards on the home page)
//   - `[data-subsystem-block]` (subsystem section wrappers on home)
//   - `[data-current="true"] .wire` (the currently-open commit in the
//      landing sidebar — stays visible but gets a `wire-pinned` flag)
//
// Pages opt their commit-link containers into "carry filter state on
// click" by adding `data-carry-filter` to them. The matching restore
// step reads the same query string back on load.

import { SHOW_IMPACT_SCORE } from '../config/features';

type RankedTag = { name: string; count: number; scores: number[]; dates: number[] };

interface Props {
  rankedTags: RankedTag[];
  groupedTags: Array<{ category: string; tags: RankedTag[] }>;
  totalItems: number;
}

const { rankedTags, groupedTags, totalItems } = Astro.props;

const CATEGORY_LABELS: Record<string, string> = {
  architectures: 'Architectures',
  components: 'Components',
  topics: 'Topics',
  news: 'News & Policy',
  other: 'Other',
};

// Same default as the home page used to use, applied uniformly.
const initialSliderValue = SHOW_IMPACT_SCORE ? '30' : '10';
---

<section class="filter-bar" aria-label="Digest filters">
  <div class="filter-bar-head">
    <span class="wsj-section-label">Filters</span>
    <span class="wsj-section-rule"></span>
  </div>

  <div class="filter-bar-body" data-impact-hidden={SHOW_IMPACT_SCORE ? undefined : 'true'}>
    <div class="filter-cell filter-cell-impact" style={SHOW_IMPACT_SCORE ? undefined : 'display:none'} aria-hidden={SHOW_IMPACT_SCORE ? undefined : 'true'}>
      <span class="filter-cell-label">Impact</span>
      <div class="filter-cell-control">
        <input type="range" id="impact-filter" min="10" max="100" step="1" value={initialSliderValue} aria-label="Minimum impact level" />
        <div class="filter-ticks">
          <span data-stop="1">Lowest</span>
          <span data-stop="2">Low</span>
          <span data-stop="3">Mid</span>
          <span data-stop="4">High</span>
          <span data-stop="5">Highest</span>
        </div>
      </div>
    </div>

    <div class="filter-cell filter-cell-date">
      <span class="filter-cell-label">Date</span>
      <div class="filter-cell-control">
        <div class="date-pills">
          <button type="button" class="date-pill" data-days="" data-active="true">All time</button>
          <button type="button" class="date-pill" data-days="1">Last day</button>
          <button type="button" class="date-pill" data-days="3">Last 3 days</button>
          <button type="button" class="date-pill" data-days="7">Last week</button>
          <button type="button" class="date-pill" data-days="30">Last month</button>
        </div>
      </div>
    </div>

    <div class="filter-cell filter-cell-labels" data-expanded="false">
      <div class="filter-cell-label-row">
        <button
          type="button"
          class="filter-cell-label-eyebrow"
          aria-expanded="false"
          aria-controls="filter-groups"
        >
          <span class="filter-cell-label">Labels</span>
          <span class="filter-cell-chevron" aria-hidden="true">&#9662;</span>
          <span class="filter-cell-meta">
            <span id="filter-visible">{totalItems}</span> of {totalItems}
          </span>
        </button>
        {rankedTags.length > 0 && (
          <div class="filter-toggles">
            <button type="button" class="filter-toggle" data-action="mark-all">Mark&nbsp;All</button>
            <span class="filter-toggle-sep">/</span>
            <button type="button" class="filter-toggle" data-action="unmark-all">Unmark&nbsp;All</button>
          </div>
        )}
      </div>
      {rankedTags.length === 0 && (
        <span class="filter-empty">No labels in the current window.</span>
      )}

      {rankedTags.length > 0 && (
        <div class="filter-groups" id="filter-groups">
          <div class="filter-groups-inner">
            {groupedTags.map(g => (
              <section class="filter-group" data-group={g.category}>
                <span class="filter-group-label">{CATEGORY_LABELS[g.category] ?? g.category}</span>
                <div class="filter-group-chips">
                  {g.tags.map(t => (
                    <button
                      type="button"
                      class="chip"
                      data-tag={t.name}
                      data-selected="true"
                      aria-pressed="true"
                      data-scores={t.scores.join(',')}
                      data-dates={t.dates.join(',')}
                    >
                      <span class="chip-name">{t.name}</span>
                      <span class="chip-count">{t.count}</span>
                    </button>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  const filterBar = document.querySelector<HTMLElement>('.filter-bar');
  if (filterBar) {
    const slider = filterBar.querySelector<HTMLInputElement>('#impact-filter')!;
    const labelsCell = filterBar.querySelector<HTMLElement>('.filter-cell-labels')!;
    const visibleCounter = filterBar.querySelector<HTMLElement>('#filter-visible');
    const impactCell = filterBar.querySelector<HTMLElement>('.filter-cell-impact')!;
    const eyebrow = labelsCell.querySelector<HTMLButtonElement>('.filter-cell-label-eyebrow');
    const ticks = Array.from(filterBar.querySelectorAll<HTMLElement>('.filter-ticks span'));
    const datePills = Array.from(filterBar.querySelectorAll<HTMLButtonElement>('.date-pill'));
    const allChips = Array.from(labelsCell.querySelectorAll<HTMLButtonElement>('.chip'));
    const groups = Array.from(labelsCell.querySelectorAll<HTMLElement>('.filter-group'));

    // Filterable targets outside the bar. Whichever set exists on the
    // current page is what gets driven — the rest stay empty arrays.
    const wires = Array.from(document.querySelectorAll<HTMLElement>('.wire'));
    const stories = Array.from(document.querySelectorAll<HTMLElement>('.story'));
    const subsystemBlocks = Array.from(
      document.querySelectorAll<HTMLElement>('[data-subsystem-block]'),
    );
    // The landing page marks one row as the commit currently being read;
    // it must stay in the sidebar even when filters would hide it.
    const currentWire = document.querySelector<HTMLElement>('[data-current="true"] .wire');

    let selectedDays: number | null = null;
    const NOW = Date.now();
    const DAY_MS = 86400000;

    // "Last day" (selectedDays === 1) means yesterday only — the digester
    // runs early in the morning, so today's window is empty. Other ranges
    // remain a simple rolling window ending now.
    function dateWindow(): [number, number] {
      if (selectedDays === null) return [-Infinity, Infinity];
      if (selectedDays === 1) return [NOW - 2 * DAY_MS, NOW - DAY_MS];
      return [NOW - selectedDays * DAY_MS, Infinity];
    }

    function thresholdFromSlider(v: number): number { return v / 10; }

    const scoresOf = new Map<HTMLButtonElement, number[]>();
    const datesOf = new Map<HTMLButtonElement, number[]>();
    for (const chip of allChips) {
      scoresOf.set(chip, (chip.dataset.scores ?? '').split(',').filter(Boolean).map(Number));
      datesOf.set(chip, (chip.dataset.dates ?? '').split(',').filter(Boolean).map(Number));
    }

    // Bento cards (.story) animate their collapse over 0.36s; defer the
    // grid-removing `display:none` until the animation finishes so the
    // grid doesn't snap.
    const HIDE_AFTER_MS = 400;
    const hideTimers = new WeakMap<HTMLElement, number>();

    function setFiltered(el: HTMLElement, filtered: boolean): void {
      const wasFiltered = el.classList.contains('is-filtered');
      el.classList.toggle('is-filtered', filtered);
      el.setAttribute('aria-hidden', filtered ? 'true' : 'false');

      if (!el.classList.contains('story')) return;
      if (filtered === wasFiltered) return;

      const prev = hideTimers.get(el);
      if (prev !== undefined) { clearTimeout(prev); hideTimers.delete(el); }

      if (filtered) {
        if (document.documentElement.classList.contains('filter-init')) {
          el.style.display = 'none';
        } else {
          const t = setTimeout(() => {
            if (el.classList.contains('is-filtered')) el.style.display = 'none';
            hideTimers.delete(el);
          }, HIDE_AFTER_MS) as unknown as number;
          hideTimers.set(el, t);
        }
      } else {
        el.style.display = '';
      }
    }

    function updateChipsForLevel(min: number, floor: number, ceil: number): HTMLButtonElement[] {
      const visible: HTMLButtonElement[] = [];
      for (const chip of allChips) {
        const scores = scoresOf.get(chip) ?? [];
        const dates = datesOf.get(chip) ?? [];
        const count = scores.reduce((n, s, i) => {
          const d = dates[i] ?? 0;
          return n + ((s < 0 || s >= min) && d >= floor && d <= ceil ? 1 : 0);
        }, 0);
        setFiltered(chip, count === 0);
        const badge = chip.querySelector<HTMLElement>('.chip-count');
        if (badge) badge.textContent = String(count);
        if (count > 0) visible.push(chip);
      }
      for (const group of groups) {
        const anyVisible = !!group.querySelector('.chip:not(.is-filtered)');
        setFiltered(group, !anyVisible);
      }
      return visible;
    }

    function selectedSet(visibleChips: HTMLButtonElement[]): Set<string> {
      const s = new Set<string>();
      for (const c of visibleChips) {
        if (c.dataset.selected === 'true') s.add(c.dataset.tag ?? '');
      }
      return s;
    }

    // All currently-visible chips selected → treat as filter-off so
    // untagged items (and items whose tags themselves are below the
    // impact floor) still show.
    function passesLabels(tagStr: string | undefined, selected: Set<string>, visibleCount: number): boolean {
      if (visibleCount === 0 || selected.size === visibleCount) return true;
      if (selected.size === 0) return false;
      const tags = (tagStr ?? '').split('|').filter(Boolean);
      for (const t of tags) if (selected.has(t)) return true;
      return false;
    }

    function apply(value: number): number {
      const min = thresholdFromSlider(value);
      const [floor, ceil] = dateWindow();
      const visibleChips = updateChipsForLevel(min, floor, ceil);
      const selected = selectedSet(visibleChips);
      let visible = 0;

      for (const el of [...wires, ...stories]) {
        const score = parseFloat(el.dataset.score ?? '-1');
        const ts = parseFloat(el.dataset.date ?? '0');
        const show = (score < 0 || score >= min) &&
          ts >= floor && ts <= ceil &&
          passesLabels(el.dataset.tags, selected, visibleChips.length);

        if (el === currentWire) {
          // The commit currently being read stays in the sidebar but
          // gets dimmed via `wire-pinned` when it wouldn't otherwise pass.
          setFiltered(el, false);
          el.classList.toggle('wire-pinned', !show);
          visible++;
        } else {
          setFiltered(el, !show);
          if (show) visible++;
        }
      }
      for (const block of subsystemBlocks) {
        const anyVisible = !!block.querySelector('.story:not(.is-filtered)');
        setFiltered(block, !anyVisible);
      }
      if (visibleCounter) visibleCounter.textContent = String(visible);
      labelsCell.classList.toggle(
        'tags-active',
        allChips.some(c => !c.classList.contains('is-filtered') && c.dataset.selected !== 'true'),
      );
      syncUrl();
      return visible;
    }

    // Track manual slider changes so auto-adjust doesn't override user intent.
    let userAdjusted = false;

    function autoAdjust(): void {
      if (userAdjusted) return;
      let current = parseInt(slider.value);
      let visible = parseInt(visibleCounter?.textContent ?? '0');
      while (visible < 5 && current > 10) {
        current--;
        slider.value = String(current);
        visible = apply(current);
      }
      updateTicks(current);
    }

    // After a manual move that hides everything, give the user 1s of
    // quiet before easing the slider back down to the highest threshold
    // that still shows ≥1 item.
    let tooHighTimer: ReturnType<typeof setTimeout> | null = null;
    let tooHighRAF: number | null = null;

    function cancelTooHighAdjust(): void {
      if (tooHighTimer !== null) { clearTimeout(tooHighTimer); tooHighTimer = null; }
      if (tooHighRAF !== null) { cancelAnimationFrame(tooHighRAF); tooHighRAF = null; }
    }

    function smoothAdjustToShowSomething(): void {
      const startValue = parseInt(slider.value);
      let target = 10;
      for (let v = startValue - 1; v >= 10; v--) {
        if (apply(v) > 0) { target = v; break; }
      }
      apply(startValue);
      if (target >= startValue) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        slider.value = String(target);
        updateTicks(target);
        apply(target);
        return;
      }

      const duration = 400;
      const startTime = performance.now();
      const step = (now: number) => {
        const elapsed = now - startTime;
        const t = Math.min(1, elapsed / duration);
        const eased = 1 - Math.pow(1 - t, 2);
        const current = Math.round(startValue - (startValue - target) * eased);
        slider.value = String(current);
        updateTicks(current);
        apply(current);
        if (t < 1) tooHighRAF = requestAnimationFrame(step);
        else tooHighRAF = null;
      };
      tooHighRAF = requestAnimationFrame(step);
    }

    function setVisibleChips(selected: boolean): void {
      for (const c of allChips) {
        if (c.classList.contains('is-filtered')) continue;
        c.dataset.selected = selected ? 'true' : 'false';
        c.setAttribute('aria-pressed', selected ? 'true' : 'false');
      }
    }

    labelsCell.addEventListener('click', (ev) => {
      const target = (ev.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!target) return;

      // If everything is currently selected, the click isolates the
      // clicked chip — the "show me only this tag" shortcut.
      const visibleChips = allChips.filter(c => !c.classList.contains('is-filtered'));
      const allSelected =
        visibleChips.length > 0 && visibleChips.every(c => c.dataset.selected === 'true');

      if (allSelected) {
        for (const c of visibleChips) {
          const isTarget = c === target;
          c.dataset.selected = isTarget ? 'true' : 'false';
          c.setAttribute('aria-pressed', isTarget ? 'true' : 'false');
        }
      } else {
        const on = target.dataset.selected !== 'true';
        target.dataset.selected = on ? 'true' : 'false';
        target.setAttribute('aria-pressed', on ? 'true' : 'false');

        // Unselecting the last selected chip would drop the user into a
        // "nothing visible" trap. Round-trip back to all-on instead.
        const anySelected = visibleChips.some(c => c.dataset.selected === 'true');
        if (!anySelected) {
          for (const c of visibleChips) {
            c.dataset.selected = 'true';
            c.setAttribute('aria-pressed', 'true');
          }
        }
      }
      apply(parseInt(slider.value));
      autoAdjust();
    });

    filterBar.querySelectorAll<HTMLButtonElement>('.filter-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        setVisibleChips(btn.dataset.action === 'mark-all');
        apply(parseInt(slider.value));
        autoAdjust();
      });
    });

    for (const pill of datePills) {
      pill.addEventListener('click', () => {
        const v = pill.dataset.days ?? '';
        selectedDays = v === '' ? null : parseInt(v);
        for (const p of datePills) p.dataset.active = p === pill ? 'true' : 'false';
        userAdjusted = false;
        apply(parseInt(slider.value));
        autoAdjust();
      });
    }

    // Slider is 10–100; map to 5 equal zones (each 18 wide) → stop label 1–5.
    function stopFromValue(v: number): number {
      return Math.min(5, Math.floor((v - 10) / 18) + 1);
    }
    function updateTicks(sliderValue: number): void {
      const stop = stopFromValue(sliderValue);
      for (const t of ticks) t.dataset.active = t.dataset.stop === String(stop) ? 'true' : 'false';
    }

    slider.addEventListener('input', () => {
      userAdjusted = true;
      cancelTooHighAdjust();
      const level = parseInt(slider.value);
      updateTicks(level);
      const visible = apply(level);
      if (visible === 0) {
        tooHighTimer = setTimeout(() => {
          tooHighTimer = null;
          smoothAdjustToShowSomething();
        }, 1000);
      }
    });
    // Touch drags don't trigger :hover; mark the cell as in-use while
    // the pointer is pressed so the intermediate ticks stay expanded.
    slider.addEventListener('pointerdown', () => { impactCell.dataset.using = 'true'; });
    const clearUsing = () => { impactCell.dataset.using = 'false'; };
    slider.addEventListener('pointerup', clearUsing);
    slider.addEventListener('pointercancel', clearUsing);

    // Labels panel: manual expand/collapse only — never on hover.
    function setLabelsExpanded(expanded: boolean): void {
      labelsCell.dataset.expanded = expanded ? 'true' : 'false';
      eyebrow?.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    }
    eyebrow?.addEventListener('click', () => {
      setLabelsExpanded(labelsCell.dataset.expanded !== 'true');
    });

    // ── URL persistence ────────────────────────────────────────────
    function buildQueryString(): string {
      const params = new URLSearchParams();
      const iv = parseInt(slider.value);
      if (iv !== 10) params.set('i', String(iv));
      const visibleChips = allChips.filter(c => !c.classList.contains('is-filtered'));
      const allSelected =
        visibleChips.length > 0 && visibleChips.every(c => c.dataset.selected === 'true');
      if (!allSelected) {
        const selected = visibleChips
          .filter(c => c.dataset.selected === 'true')
          .map(c => c.dataset.tag ?? '');
        if (selected.length) params.set('t', selected.join('|'));
      }
      if (selectedDays !== null) {
        const dMap: Record<number, string> = { 1: 'lastday', 3: '3d', 7: '7d', 30: '30d' };
        if (dMap[selectedDays]) params.set('d', dMap[selectedDays]);
      }
      return params.toString();
    }

    let urlSyncReady = false;
    function syncUrl(): void {
      if (!urlSyncReady) return;
      const qs = buildQueryString();
      const base = window.location.pathname;
      history.replaceState(null, '', qs ? `${base}?${qs}` : base);
    }

    function restoreFromUrl(): void {
      const params = new URLSearchParams(window.location.search);
      const iv = params.get('i');
      if (iv) slider.value = iv;
      const t = params.get('t');
      if (t) {
        const saved = new Set(t.split('|').filter(Boolean));
        for (const chip of allChips) {
          const on = saved.has(chip.dataset.tag ?? '');
          chip.dataset.selected = on ? 'true' : 'false';
          chip.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        userAdjusted = true; // user-chosen tag set; don't auto-adjust slider
      }
      const d = params.get('d');
      if (d) {
        const reverseMap: Record<string, number> = { lastday: 1, today: 1, '3d': 3, '7d': 7, '30d': 30 };
        if (reverseMap[d] !== undefined) {
          selectedDays = reverseMap[d];
          for (const p of datePills) {
            p.dataset.active = p.dataset.days === String(selectedDays) ? 'true' : 'false';
          }
        }
      }
      if (iv) userAdjusted = true; // explicit impact in URL is intentional
    }

    // Carry filter state on click for any commit-link container that
    // opts in via `data-carry-filter`. Also stash the page scroll
    // position so the landing page can restore it on arrival.
    document.querySelectorAll<HTMLElement>('[data-carry-filter]').forEach(container => {
      container.addEventListener('click', ev => {
        const link = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
        if (!link || !container.contains(link)) return;
        try {
          sessionStorage.setItem('commit-scroll-y', String(window.scrollY));
        } catch (_) { /* sessionStorage may be unavailable */ }
        const qs = buildQueryString();
        if (!qs) return;
        ev.preventDefault();
        window.location.href = link.href.split('?')[0] + '?' + qs;
      });
    });

    // Suppress the first paint's collapse animation: items below the
    // default threshold would otherwise flash in fully expanded and
    // then animate down.
    document.documentElement.classList.add('filter-init');
    restoreFromUrl();
    apply(parseInt(slider.value));
    updateTicks(parseInt(slider.value));
    const anyWireVisible = wires.some(w => !w.classList.contains('is-filtered'));
    if (!anyWireVisible && wires.length > 0 && !userAdjusted) {
      slider.value = '10';
      apply(10);
      updateTicks(parseInt(slider.value));
    }
    autoAdjust();
    urlSyncReady = true;
    syncUrl();
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document.documentElement.classList.remove('filter-init');
      });
    });
  }
</script>

<style>
  /* ---------- Unified filter ribbon ---------- */
  .filter-bar {
    margin: 0 0 1.4rem;
    padding: 0.1rem 0 0.9rem;
    border-top: 3px double var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .filter-bar-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0 0.6rem;
  }

  .filter-bar-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem 2rem;
    align-items: start;
  }

  .filter-cell-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .filter-cell-impact {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 0.9rem;
    align-items: center;
  }
  .filter-cell-impact .filter-cell-control {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  #impact-filter {
    width: 100%;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .filter-ticks {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .filter-ticks span {
    transition: color 0.12s ease, font-weight 0.12s ease, opacity 0.18s ease;
  }
  /* Intermediate stops stay hidden until the user hovers or interacts
     with the slider, keeping the resting state minimal. */
  .filter-ticks span[data-stop="2"],
  .filter-ticks span[data-stop="3"],
  .filter-ticks span[data-stop="4"] {
    opacity: 0;
  }
  .filter-cell-impact:hover .filter-ticks span,
  .filter-cell-impact:focus-within .filter-ticks span,
  .filter-cell-impact[data-using="true"] .filter-ticks span {
    opacity: 1;
  }
  .filter-ticks span[data-active="true"] {
    color: var(--color-accent);
    font-weight: 900;
  }

  .filter-cell-labels {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
    padding: 0.45rem 0.6rem 0.55rem;
    border: 1px dashed var(--color-rule);
    transition:
      border-color 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      border-style 0s;
  }
  @media (hover: hover) and (pointer: fine) {
    .filter-cell-labels[data-expanded="true"] {
      border-color: var(--color-accent);
      border-style: solid;
    }
  }
  .filter-cell-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .filter-cell-label-eyebrow {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-width: 0;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .filter-cell-chevron {
    display: inline-block;
    font-size: 0.65em;
    line-height: 1;
    color: var(--color-muted);
    transform: rotate(0deg);
    transition:
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .filter-cell-meta {
    font-family: var(--font-serif);
    font-style: italic;
