---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'landings'>;
}

const { entry } = Astro.props;
const d = entry.data;

const dateStr = d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
const isHigh = (d.impact_score ?? 0) >= 8;
---

<a
  href={`/landings/${entry.id}`}
  style="display: block; text-decoration: none; color: inherit; padding: 0.6rem 0; border-bottom: 1px solid var(--color-border); transition: background 0.1s;"
  onmouseover="this.style.background='#fafafa'; this.style.paddingLeft='0.25rem'"
  onmouseout="this.style.background='transparent'; this.style.paddingLeft='0'"
>
  <div style="display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;">
    <span style="font-family: var(--font-sans); font-size: 0.65rem; color: var(--color-secondary); white-space: nowrap; flex-shrink: 0; background: #f3f4f6; padding: 0.1rem 0.35rem; border-radius: 2px;">
      {dateStr}
    </span>
    <span style="font-family: var(--font-sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-gold); white-space: nowrap; flex-shrink: 0;">
      {d.subsystem}
    </span>
    {isHigh && (
      <span style="font-family: var(--font-sans); font-size: 0.6rem; color: #d97706; font-weight: 600;">★</span>
    )}
  </div>
  <p style={`font-family: var(--font-serif); font-size: 0.88rem; font-weight: ${isHigh ? '600' : '400'}; line-height: 1.3; margin: 0.25rem 0 0.15rem; color: var(--color-body);`}>
    {d.headline}
  </p>
  <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--color-secondary); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
    {d.tldr}
  </p>
</a>
