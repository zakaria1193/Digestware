---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'landings'>;
  projectSlug: string;
}

const { entry, projectSlug } = Astro.props;
const d = entry.data;

const dateStr = d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }).toUpperCase();
const isHigh = (d.impact_score ?? 0) >= 8;
const isLow = (d.impact_score ?? 0) <= 2;

function scoreColor(n: number | null | undefined): string {
  if (n == null) return '#888';
  if (n <= 2)  return '#5a5a5a';
  if (n <= 4)  return '#2e6a8e';
  if (n <= 6)  return '#1a4d8a';
  if (n <= 8)  return '#7a1a2e';
  return '#b80018';
}
---

<a href={`/${projectSlug}/landings/${entry.id}`} class:list={["wire", isHigh && "wire-starred", isLow && "wire-dim"]} data-score={d.impact_score ?? 0} data-tags={(d.tags ?? []).join('|')}>
  <div class="wire-top">
    <span class="wire-date">{dateStr}</span>
    <span class="wire-sep">&mdash;</span>
    <span class="wire-sub">{d.subsystem}</span>
    {d.impact_score != null && (
      <span class="wire-score" style={`color: ${scoreColor(d.impact_score)}`}>{d.impact_score}&thinsp;/&thinsp;10</span>
    )}
    {isHigh && <span class="wire-star" aria-label="High impact">&#9733;</span>}
  </div>
  <h4 class="wire-headline">{d.headline}</h4>
  <p class="wire-deck">{d.tldr}</p>
</a>

<style>
  .wire {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-rule);
    overflow: hidden;
    max-height: 30rem;
    transition:
      opacity 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      max-height 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      padding 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      margin 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      border-bottom-width 0.32s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wire:last-child { border-bottom: none; }

  .wire.is-filtered {
    opacity: 0;
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin: 0;
    border-bottom-width: 0;
    pointer-events: none;
    transform: translateY(-3px);
  }

  :global(html.filter-init) .wire {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .wire { transition: none; }
  }

  .wire-top {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .wire-date {
    color: var(--color-ink);
    font-weight: 700;
  }

  .wire-sep { color: var(--color-rule); }

  .wire-score {
    font-weight: 700;
    margin-left: auto;
    margin-right: 0.3rem;
    letter-spacing: 0.05em;
  }

  .wire-sub {
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .wire-star {
    color: var(--color-accent);
    font-size: 0.75rem;
    margin-left: auto;
  }

  .wire-headline {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 0.94rem;
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin: 0 0 0.2rem;
    color: var(--color-ink);
  }

  .wire-starred .wire-headline { font-weight: 900; }

  .wire-dim {
    opacity: 0.45;
  }
  .wire-dim .wire-headline {
    font-size: 0.78rem;
    font-weight: 500;
  }
  .wire-dim .wire-deck {
    font-size: 0.7rem;
    -webkit-line-clamp: 1;
  }
  .wire-dim .wire-top {
    font-size: 0.54rem;
  }

  .wire:hover .wire-headline { color: var(--color-accent); }

  .wire-deck {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
