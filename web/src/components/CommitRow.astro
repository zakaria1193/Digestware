---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'landings'>;
}

const { entry } = Astro.props;
const d = entry.data;

const dateStr = d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }).toUpperCase();
const isHigh = (d.impact_score ?? 0) >= 8;
---

<a href={`/landings/${entry.id}`} class:list={["wire", isHigh && "wire-starred"]}>
  <div class="wire-top">
    <span class="wire-date">{dateStr}</span>
    <span class="wire-sep">&mdash;</span>
    <span class="wire-sub">{d.subsystem}</span>
    {isHigh && <span class="wire-star" aria-label="High impact">&#9733;</span>}
  </div>
  <h4 class="wire-headline">{d.headline}</h4>
  <p class="wire-deck">{d.tldr}</p>
</a>

<style>
  .wire {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .wire:last-child { border-bottom: none; }

  .wire-top {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .wire-date {
    color: var(--color-ink);
    font-weight: 700;
  }

  .wire-sep { color: var(--color-rule); }

  .wire-sub {
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .wire-star {
    color: var(--color-accent);
    font-size: 0.75rem;
    margin-left: auto;
  }

  .wire-headline {
    font-family: var(--font-serif-display);
    font-weight: 700;
    font-size: 0.94rem;
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin: 0 0 0.2rem;
    color: var(--color-ink);
  }

  .wire-starred .wire-headline { font-weight: 900; }

  .wire:hover .wire-headline { color: var(--color-accent); }

  .wire-deck {
    font-family: var(--font-serif);
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
