---
import '../styles/global.css';
import { PROJECTS, projectUrl, absoluteUrl, type ProjectDef } from '../config/projects';

interface Props {
  project: ProjectDef;
  title?: string;
  description?: string;
  // Path (within this project's own hostname) the canonical/OG/JSON-LD URLs
  // point at. Defaults to the route actually being rendered, which is right
  // for every page except ones that alias another URL.
  path?: string;
  // Project home page: adds a `WebSite` JSON-LD block.
  isHome?: boolean;
  // Landing/discussion pages pass "NewsArticle", lesson pages "TechArticle".
  // Omitted (the MCP page, the home page) means no article JSON-LD and
  // `og:type` stays "website" instead of "article".
  articleSchema?: 'NewsArticle' | 'TechArticle';
  headline?: string;
  publishedDate?: Date;
  sourceUrl?: string | null;
}
const { project, title, description, path, isHome = false, articleSchema, headline, publishedDate, sourceUrl } = Astro.props;
const pageTitle = title ? `${title} — ${project.name}` : project.name;
const pageDesc = description ?? project.description;

const canonicalPath = path ?? Astro.url.pathname;
const canonicalUrl = absoluteUrl(project, canonicalPath);
const ogImage = absoluteUrl(project, `/og/${project.slug}.png`);
const projectHomeUrl = absoluteUrl(project, `/${project.slug}/`);
const isArticle = Boolean(articleSchema);

// Built from data rather than string-templated, so a headline/description
// containing `<`, `&`, quotes, or newlines can never produce invalid JSON.
// The extra escape of `<` (valid in JSON, but not inside a <script> body)
// stops a headline like "a <script> tag" from closing the element early.
const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: project.name,
      url: canonicalUrl,
      description: pageDesc,
      inLanguage: 'en',
      publisher: { '@type': 'Organization', name: project.name, url: projectHomeUrl },
    }
  : articleSchema
    ? {
        '@context': 'https://schema.org',
        '@type': articleSchema,
        headline: headline ?? pageTitle,
        description: pageDesc,
        datePublished: (publishedDate ?? new Date()).toISOString(),
        url: canonicalUrl,
        mainEntityOfPage: canonicalUrl,
        image: ogImage,
        inLanguage: 'en',
        author: { '@type': 'Organization', name: project.name },
        publisher: { '@type': 'Organization', name: project.name, url: projectHomeUrl },
        ...(sourceUrl ? { isBasedOn: sourceUrl } : {}),
      }
    : null;
const jsonLdScript = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;

const now = new Date();
const longDate = now.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={project.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    {isArticle && <meta property="article:published_time" content={(publishedDate ?? new Date()).toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLdScript && <script type="application/ld+json" set:html={jsonLdScript} />}
    <link rel="alternate" type="application/rss+xml" title={`${project.name} Feed`} href={`/${project.slug}/rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Domine:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Public+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="paper">
      <header class="masthead">
        <div class="masthead-rule-top"></div>
        <a href={`/${project.slug}/`} class="wordmark-link">
          <div class="wordmark">
            <span class="pulse">{project.name}</span>
          </div>
        </a>
        <div class="masthead-meta">
          <span>{longDate}</span>
        </div>
        <div class="masthead-rule-bottom"></div>
      </header>

      <!-- Tab line: one tab per project. Current project is highlighted;
           each tab links to its `/<slug>/` subpath on the shared origin. -->
      <nav class="projtabs" aria-label="Projects">
        {PROJECTS.map(p => (
          <a
            href={projectUrl(p)}
            class:list={['projtab', p.slug === project.slug && 'projtab-active']}
            aria-current={p.slug === project.slug ? 'page' : undefined}
          >
            {p.short}
          </a>
        ))}
      </nav>

<main class="paper-main">
        <slot />
      </main>

      <footer class="paper-footer">
        <div class="footer-rule"></div>
        <div class="footer-inner">
          <div class="footer-left">
            <div class="footer-brand">{project.name.toUpperCase()}</div>
            <div class="footer-sub">{project.footerBlurb}</div>
          </div>
          <!-- The Wire sits beside RSS because they are the same kind of
               thing: ways to consume the paper without reading it. -->
          <div class="footer-right">
            <a href={`/${project.slug}/rss.xml`}>RSS</a>
            <a href={`/${project.slug}/mcp`}>MCP</a>
            <a href="/admin">Newsroom</a>
          </div>
        </div>
        <div class="footer-copy">&copy; {now.getFullYear()} {project.name}. All commits remain the property of their authors.</div>
      </footer>
    </div>

    <style>
      .paper {
        max-width: 1600px;
        margin: 0 auto;
        background: var(--color-paper);
        padding: 0 1.5rem;
      }

      .masthead {
        text-align: center;
        padding: 0.6rem 0 0.4rem;
      }
      .masthead-rule-top {
        border-top: 1px solid var(--color-rule-strong);
        border-bottom: 3px double var(--color-rule-strong);
        height: 6px;
        margin-bottom: 0.4rem;
      }
      .masthead-rule-bottom {
        border-top: 3px double var(--color-rule-strong);
        border-bottom: 1px solid var(--color-rule-strong);
        height: 6px;
        margin-top: 0.4rem;
      }
      .masthead-meta {
        font-family: var(--font-sans);
        font-size: 0.66rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-top: 0.2rem;
      }
      .masthead-meta .divider { margin: 0 0.5rem; color: var(--color-rule); }

      .wordmark-link { text-decoration: none; display: inline-block; }
      .wordmark {
        font-family: var(--font-serif-display);
        font-weight: 900;
        color: var(--color-ink);
        line-height: 0.95;
        letter-spacing: -0.02em;
      }
      .wordmark .pulse {
        display: block;
        font-size: clamp(1.75rem, 4.5vw, 3rem);
      }

      /* -------- Project tabs -------- */
      .projtabs {
        display: flex;
        gap: 0;
        justify-content: center;
        border-bottom: 1px solid var(--color-rule-strong);
        padding: 0.35rem 0 0;
        flex-wrap: wrap;
      }
      .projtab {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--color-muted);
        text-decoration: none;
        padding: 0.55rem 1.1rem 0.45rem;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition: color 0.12s;
      }
      .projtab:hover { color: var(--color-ink); }
      .projtab-active {
        color: var(--color-ink);
        border-bottom-color: var(--color-accent);
      }

      @media (max-width: 640px) {
        .projtab { padding: 0.5rem 0.7rem 0.4rem; font-size: 0.68rem; letter-spacing: 0.12em; }
      }

      .paper-main { padding: 1.5rem 0 3rem; }

      .paper-footer { padding: 2rem 0 1.5rem; }
      .footer-rule {
        border-top: 1px solid var(--color-rule-strong);
        border-bottom: 3px double var(--color-rule-strong);
        height: 6px;
        margin-bottom: 1rem;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .footer-brand {
        font-family: var(--font-serif-display);
        font-weight: 900;
        font-size: 1.4rem;
        letter-spacing: -0.01em;
      }
      .footer-sub {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-top: 0.2rem;
      }
      .footer-right {
        display: flex;
        gap: 1.5rem;
        font-family: var(--font-sans);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .footer-right a {
        text-decoration: none;
        color: var(--color-ink);
        font-weight: 600;
      }
      .footer-right a:hover { color: var(--color-accent); }
      .footer-copy {
        margin-top: 1.25rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--color-rule);
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 0.78rem;
        color: var(--color-muted);
      }
    </style>
  </body>
</html>
