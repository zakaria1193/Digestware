---
import '../styles/global.css';
import { PROJECTS, projectUrl, type ProjectDef } from '../config/projects';

interface Props {
  project: ProjectDef;
  title?: string;
  description?: string;
}
const { project, title, description } = Astro.props;
const pageTitle = title ? `${title} — ${project.name}` : project.name;
const pageDesc = description ?? project.description;

const now = new Date();
const weekday = now.toLocaleDateString('en-US', { weekday: 'long' }).toUpperCase();
const longDate = now.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).toUpperCase();
const volume = `VOL. ${now.getFullYear() - 2025} · NO. ${Math.floor((now.getTime() - new Date(now.getFullYear(), 0, 0).getTime()) / 86400000)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="alternate" type="application/rss+xml" title={`${project.name} Feed`} href={`/${project.slug}/rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Domine:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Public+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="paper">
      <div class="topstrip">
        <div class="topstrip-inner">
          <span class="topstrip-left">{weekday}, {longDate}</span>
          <span class="topstrip-center">{project.name.toUpperCase()} · OPEN-SOURCE SYSTEMS DAILY</span>
          <span class="topstrip-right">{volume}</span>
        </div>
      </div>

      <header class="masthead">
        <div class="masthead-rule-top"></div>
        <div class="masthead-meta">
          <span>Late Edition</span>
          <span class="divider">·</span>
          <span>{longDate}</span>
          <span class="divider">·</span>
          <span>{volume}</span>
        </div>
        <a href={`/${project.slug}/`} class="wordmark-link">
          <div class="wordmark">
            <span class="the">The</span>
            <span class="pulse">{project.name}</span>
          </div>
        </a>
        <div class="tagline">{project.tagline}</div>
        <div class="masthead-rule-bottom"></div>
      </header>

      <!-- Tab line: one tab per project. Current project is highlighted;
           others redirect to their own hostname (prod) or subpath (dev). -->
      <nav class="projtabs" aria-label="Projects">
        {PROJECTS.map(p => (
          <a
            href={projectUrl(p)}
            class:list={['projtab', p.slug === project.slug && 'projtab-active']}
            aria-current={p.slug === project.slug ? 'page' : undefined}
          >
            {p.short}
          </a>
        ))}
      </nav>

<main class="paper-main">
        <slot />
      </main>

      <footer class="paper-footer">
        <div class="footer-rule"></div>
        <div class="footer-inner">
          <div class="footer-left">
            <div class="footer-brand">{project.name.toUpperCase()}</div>
            <div class="footer-sub">{project.footerBlurb}</div>
          </div>
          <div class="footer-right">
            <a href={`/${project.slug}/rss.xml`}>RSS</a>
            <a href="/admin">Newsroom</a>
          </div>
        </div>
        <div class="footer-copy">&copy; {now.getFullYear()} {project.name}. All commits remain the property of their authors.</div>
      </footer>
    </div>

    <style>
      .paper {
        max-width: 1280px;
        margin: 0 auto;
        background: var(--color-paper);
        padding: 0 1.25rem;
      }

      .topstrip {
        border-bottom: 1px solid var(--color-rule);
        padding: 0.35rem 0;
        font-family: var(--font-sans);
        font-size: 0.62rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-muted);
      }
      .topstrip-inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
      }
      .topstrip-right { text-align: right; }
      .topstrip-center { color: var(--color-ink); font-weight: 600; }

      @media (max-width: 640px) {
        .topstrip-inner { grid-template-columns: 1fr; text-align: center; gap: 0.15rem; }
        .topstrip-right { text-align: center; }
      }

      .masthead {
        text-align: center;
        padding: 1.1rem 0 0.75rem;
      }
      .masthead-rule-top {
        border-top: 1px solid var(--color-rule-strong);
        border-bottom: 3px double var(--color-rule-strong);
        height: 6px;
        margin-bottom: 0.65rem;
      }
      .masthead-rule-bottom {
        border-top: 3px double var(--color-rule-strong);
        border-bottom: 1px solid var(--color-rule-strong);
        height: 6px;
        margin-top: 0.65rem;
      }
      .masthead-meta {
        font-family: var(--font-sans);
        font-size: 0.66rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-bottom: 0.4rem;
      }
      .masthead-meta .divider { margin: 0 0.5rem; color: var(--color-rule); }

      .wordmark-link { text-decoration: none; display: inline-block; }
      .wordmark {
        font-family: var(--font-serif-display);
        font-weight: 900;
        color: var(--color-ink);
        line-height: 0.92;
        letter-spacing: -0.02em;
      }
      .wordmark .the {
        display: block;
        font-style: italic;
        font-weight: 400;
        font-size: clamp(1.25rem, 2.5vw, 1.8rem);
        letter-spacing: 0.02em;
        margin-bottom: 0.1rem;
      }
      .wordmark .pulse {
        display: block;
        font-size: clamp(2.25rem, 7vw, 4.75rem);
      }
      .tagline {
        margin-top: 0.35rem;
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 0.85rem;
        color: var(--color-muted);
        letter-spacing: 0.02em;
      }

      /* -------- Project tabs -------- */
      .projtabs {
        display: flex;
        gap: 0;
        justify-content: center;
        border-bottom: 1px solid var(--color-rule-strong);
        padding: 0.35rem 0 0;
        flex-wrap: wrap;
      }
      .projtab {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--color-muted);
        text-decoration: none;
        padding: 0.55rem 1.1rem 0.45rem;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition: color 0.12s;
      }
      .projtab:hover { color: var(--color-ink); }
      .projtab-active {
        color: var(--color-ink);
        border-bottom-color: var(--color-accent);
      }

      @media (max-width: 640px) {
        .projtab { padding: 0.5rem 0.7rem 0.4rem; font-size: 0.68rem; letter-spacing: 0.12em; }
      }

      .paper-main { padding: 1.5rem 0 3rem; }

      .paper-footer { padding: 2rem 0 1.5rem; }
      .footer-rule {
        border-top: 1px solid var(--color-rule-strong);
        border-bottom: 3px double var(--color-rule-strong);
        height: 6px;
        margin-bottom: 1rem;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .footer-brand {
        font-family: var(--font-serif-display);
        font-weight: 900;
        font-size: 1.4rem;
        letter-spacing: -0.01em;
      }
      .footer-sub {
        font-family: var(--font-sans);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-muted);
        margin-top: 0.2rem;
      }
      .footer-right {
        display: flex;
        gap: 1.5rem;
        font-family: var(--font-sans);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .footer-right a {
        text-decoration: none;
        color: var(--color-ink);
        font-weight: 600;
      }
      .footer-right a:hover { color: var(--color-accent); }
      .footer-copy {
        margin-top: 1.25rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--color-rule);
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 0.78rem;
        color: var(--color-muted);
      }
    </style>
  </body>
</html>
