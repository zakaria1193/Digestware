---
import '../styles/global.css';

interface Props {
  title: string;
  section?: string;
}
const { title, section = '' } = Astro.props;

const nav = [
  { href: '/admin', label: 'Dashboard', key: 'dashboard' },
  { href: '/admin/landings', label: 'Landings', key: 'landings' },
  { href: '/admin/discussions', label: 'Discussions', key: 'discussions' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — OS Pulse Admin</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body style="background: var(--color-paper); color: var(--color-ink);" class="min-h-screen flex">
    <aside class="hidden md:flex w-56 shrink-0 flex-col" style="border-right: 1px solid var(--color-rule);">
      <div class="px-5 py-4" style="border-bottom: 1px solid var(--color-rule);">
        <span class="text-xs font-mono uppercase tracking-widest" style="color: var(--color-muted);">OS Pulse</span>
        <p class="text-sm font-semibold mt-0.5" style="color: var(--color-accent);">Admin</p>
      </div>
      <nav class="flex-1 py-4 space-y-0.5 px-2">
        {nav.map(({ href, label, key }) => (
          <a
            href={href}
            class="flex items-center px-3 py-2 rounded text-sm transition-colors"
            style={section === key
              ? `background: var(--color-card); color: var(--color-ink);`
              : `color: var(--color-muted);`
            }
          >
            {label}
          </a>
        ))}
      </nav>
      <div class="px-5 py-3" style="border-top: 1px solid var(--color-rule);">
        <a href="/" class="text-xs transition-colors" style="color: var(--color-muted);">← Public site</a>
      </div>
    </aside>

    <main class="flex-1 overflow-auto">
      <header class="px-8 py-4" style="border-bottom: 1px solid var(--color-rule);">
        <h1 class="text-lg font-semibold">{title}</h1>
      </header>
      <div class="px-8 py-6">
        <slot />
      </div>
    </main>

    <style>
      a:hover {
        color: var(--color-ink);
      }
      nav a:hover {
        background: rgba(0, 0, 0, 0.05);
      }
    </style>
  </body>
</html>
