---
import '../styles/global.css';

interface Props {
  title: string;
  section?: string;
}
const { title, section = '' } = Astro.props;

const nav = [
  { href: '/admin', label: 'Dashboard', key: 'dashboard' },
  { href: '/admin/landings', label: 'Landings', key: 'landings' },
  { href: '/admin/discussions', label: 'Discussions', key: 'discussions' },
  { href: '/admin/digests', label: 'Digests', key: 'digests' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — OS Pulse Admin</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex">
    <aside class="w-56 shrink-0 border-r border-zinc-800 flex flex-col">
      <div class="px-5 py-4 border-b border-zinc-800">
        <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">OS Pulse</span>
        <p class="text-sm font-semibold text-amber-400 mt-0.5">Admin</p>
      </div>
      <nav class="flex-1 py-4 space-y-0.5 px-2">
        {nav.map(({ href, label, key }) => (
          <a
            href={href}
            class={`flex items-center px-3 py-2 rounded text-sm transition-colors ${
              section === key
                ? 'bg-zinc-800 text-zinc-100'
                : 'text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/50'
            }`}
          >
            {label}
          </a>
        ))}
      </nav>
      <div class="px-5 py-3 border-t border-zinc-800">
        <a href="/" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">← Public site</a>
      </div>
    </aside>

    <main class="flex-1 overflow-auto">
      <header class="border-b border-zinc-800 px-8 py-4">
        <h1 class="text-lg font-semibold">{title}</h1>
      </header>
      <div class="px-8 py-6">
        <slot />
      </div>
    </main>
  </body>
</html>
